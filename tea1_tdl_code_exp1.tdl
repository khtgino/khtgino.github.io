    if( vs_os_tmp1<-1.0V ) { power_os[int_i]="O"; }
  
    sr(off);
    }
    else
    {
    sr(on);
    tmp_test_num=int_i;
    tno(tmp_test_num); cat(cat_os1); dcmnt("POWER PIN O/S ("+testdata+")");
    judge(vm, 0.2V,  1.0V, V);
    vs_os_tmp1=measure_dpsvm.Get_PinVal(1);
    power_os[int_i]=".";
    if( vs_os_tmp1< 0.2V ) { power_os[int_i]="S"; }
    if( vs_os_tmp1> 1.0V ) { power_os[int_i]="O"; }
  
    sr(off);
    }    
  }
  //================================================================================================
    tmp_test_num=int_i;
    //-----------------------
    rly=dir; vi=vfim; v=0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
    rly=dir; vi=vfim; v=0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);
    rly=dir; vi=vfim; v=0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_PAVDD   );
