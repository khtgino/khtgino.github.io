void pat_mdgt_ft(int &a , int &b )
{  

  vectorreg.stopSPA(NORMAL);
  
  if(fstop==off)TEST.pg(FAILINH);
  if(fstop==on)TEST.pg(NORMAL);    
  TEST.Set();    

  vectorreg.STA(startadrn);
  vectorreg.SPA(stopadrn);
  vectorreg.LIDX3(indx_3);
  //vectorreg.LIDX4(indx_4);
  //vectorreg.LIDX5(indx_5);
  //vectorreg.LIDX6(indx_6);
  vectorreg.Load();

  //dfm.type(DFM_FAILSTORE);
  //dfm.fcnt(256);
  //dfm.Load();

  measure_ft.vector(vectorfile);
  measure_ft.reg(vectorreg);
  
  //measure_ft.dfm(dfm);
  measure_ft.Set();
  mdgt_samp.Start();
  measure_ft.Start();
  mdgt_samp.Wait();
  b=measure_ft.Get_Result(1);    

  performace=0;  

  dpsindx=0;    
}

/**************************  HSIF  *******************************/
void hsifpin(HSIFPIN &hsifpin)
{
  if(kindsel[0]==1)
  {
    hsif_all_t.pinlist(hsifpin);
    hsif_all_t.Load();
    kindsel[0]=0;  
  }
  else 
  {
    if(fmt==FIXH||fmt==FIXL) 
    {
    hsif_all_t.pinlist(hsifpin);
    hsif_all_t.kind(IN);
    hsif_all_t.wavekind(0,fmt);
    hsif_all_t.option(NONE);
    hsif_all_t.Load();
    }
    if(fmt==OPEN)
    {
    hsif_all_t.pinlist(hsifpin);
    hsif_all_t.kind(OPEN);
    hsif_all_t.Load();
    }
    hsif_all_l.pinlist(hsifpin);
    //hsif_all_l.vt(vt); //HSIF invalid
    hsif_all_l.vih(vih);
    hsif_all_l.vil(vil);
    //hsif_all_l.ilh(ilh); //HSIF invalid
    //hsif_all_l.ill(ill); //HSIF invalid
    //hsif_all_l.voh(voh); //HSIF invalid
    //hsif_all_l.vol(vol); //HSIF invalid
    hsif_all_l.Load();
  }
  measure_im.pinlist(hsifpin);
  measure_vm.pinlist(hsifpin);
  //measure_freq.pinlist(hsifpin);
  //measure_period.pin(hsifpin);
  //chkind=iopinkind; //HSIF use MDC, same as Dpin
  chkind=hsifpinkind; //HSIF use MDC, same as Dpin
}
void hsifpin(HSIFPIN &hsifpin1,HSIFPIN &hsifpin2)
{
  if(kindsel[0]==1)
  {
    hsif_all_t.pinlist(hsifpin1,hsifpin2);
    hsif_all_t.Load();  
    kindsel[0]=0;  
  }
  else 
  {
    if(fmt==FIXH||fmt==FIXL) 
    {
    hsif_all_t.pinlist(hsifpin1,hsifpin2);
    hsif_all_t.kind(IN);
    hsif_all_t.wavekind(0,fmt);
    hsif_all_t.option(NONE);
    hsif_all_t.Load();
    }
    if(fmt==OPEN)
    {
    hsif_all_t.pinlist(hsifpin1,hsifpin2);
    hsif_all_t.kind(OPEN);
    hsif_all_t.Load();
    }
    hsif_all_l.pinlist(hsifpin1,hsifpin2);
    //hsif_all_l.vt(vt); //HSIF invalid
