  tno(tmp_test_num++); cat( 7); dcmnt("p2p_ch1446_dpsel_4p_bsel_1_shl_1 ");     judge( gs_p2p_result_02[0] , 0,0 );    

  tno(tmp_test_num++); cat(10); dcmnt("toggle_plus_ch1446_dpsel_4p_bsel_1_shl_1"); judge( gs_toggle_result_01[0] , 0,0 );    
  
