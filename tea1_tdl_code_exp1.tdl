void judge(int &a, SYSENUM &b, Amperes &c, int &d)
{
  TEST.Set();
  im_limit.upper(c);
  im_limit.lower(b);
  im_limit.Load(); 
  if (d==V) a=vm;
  switch(a)
  {
  case vm:
      vm_limit.upper(100V);
      vm_limit.lower(-100V);
      vm_limit.Load();
    
    switch(chkind)    
    {
      case vspinkind:
        measure_dpsvm.isvm(dpsisvm);
        measure_dpsvm.limit(vm_limit);
        measure_dpsvm.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_dpsvm.Exec();
        break;
      case rvspinkind:
        isvm.Resc(HVDC);
        isvm.SRng(irng);
        isvm.MRng(vrng);
        isvm.SVal(i);
        isvm.CPVal(v);
        isvm.CMVal(v*-1);
        isvm.Load();
      
        measure_vm.isvm(isvm);
        measure_vm.limit(vm_limit);
        measure_vm.sequence(seq_vm);
        measure_vm.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_vm.Exec();
          break;
      case lcdpinkind:
        //$if __TESTER_TYPE__ == 119 //for ND4
          if(vrng==M8V || vrng==M12V){vrng=M12V;}
        //$else
        //  if(vrng==M8V || vrng==M12V){vrng=M8V;}
        //$endif
        isvm.Resc(LPPDC);
        isvm.SRng(irng);
        isvm.MRng(vrng);
        isvm.SVal(i);
        isvm.CPVal(v);
        isvm.CMVal(v*-1);
        isvm.Load();
      
        measure_vm.isvm(isvm);
        measure_vm.limit(vm_limit);
        measure_vm.sequence(seq_vm);
        measure_vm.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_vm.Exec();
          break;
      case iopinkind:  

        isvm.Resc(MDC);
        isvm.SRng(irng);
        isvm.MRng(vrng);
        isvm.SVal(i);
        isvm.CPVal(v);
        isvm.CMVal(v*-1);
        isvm.Load();
        
        measure_vm.isvm(isvm);
        measure_vm.limit(vm_limit);
        measure_vm.sequence(seq_vm);
        measure_vm.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_vm.Exec();
        break;

      case hsifpinkind:  

        isvm.Resc(MDC);
        isvm.SRng(irng);
        isvm.MRng(vrng);
        isvm.SVal(i);
        isvm.CPVal(v);
        isvm.CMVal(v*-1);
        isvm.Load();
        
        measure_vm.isvm(isvm);
        measure_vm.limit(vm_limit);
        measure_vm.sequence(seq_vm);
        measure_vm.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_vm.Exec();
        break;
        
      default: break;  
    }
    
      break;
  case im:
    switch(chkind)    
    {
      case vspinkind:
        if(dpsindx==para)
        {
          meas_dpsavrim.vsim(dpsvsim);
          meas_dpsavrim.limit(im_limit);
          meas_dpsavrim.pg(pg);
          meas_dpsavrim.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
          meas_dpsavrim.Exec();
        }
        else
        {
          measure_dpsim.vsim(dpsvsim);
          measure_dpsim.limit(im_limit);
          measure_dpsim.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
          measure_dpsim.Exec();
        }
        dpsindx=0;
        break;
    
        case rvspinkind:
        vsim.Resc(HVDC);
        vsim.MRng(irng);
        vsim.SRng(vrng);
        vsim.SVal(v);
        vsim.CPVal(i);
        vsim.CMVal(i*-1);
          vsim.Load();
          
          measure_im.vsim(vsim);
        measure_im.limit(im_limit);
        measure_im.sequence(seq_im);
        measure_im.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_im.Exec();
          break;
      case lcdpinkind:
        //$if __TESTER_TYPE__ == 119 //for ND4
          if(vrng==M8V || vrng==M12V){vrng=R12V;}
        //$else
        //  if(vrng==M8V || vrng==M12V){vrng=M8V;}
        //$endif
        vsim.Resc(LPPDC);
        vsim.MRng(irng);
        vsim.SRng(vrng);
        vsim.SVal(v);
        vsim.CPVal(i);
        vsim.CMVal(i*-1);
          vsim.Load();
          
          measure_im.vsim(vsim);
        measure_im.limit(im_limit);
        measure_im.sequence(seq_im);
        measure_im.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_im.Exec();
          break;
      case iopinkind:  
        //$if __TESTER_TYPE__ == 119 //for ND4
          if(irng==M8UA){i=10.5uA;} 
          else if(irng==M80UA){i=105uA;}
          else if(irng==M800UA){i=1.05mA;}
          else{i=42mA;}
        //$else          
        //  if(irng==M8UA || irng==M80UA || irng==M800UA){i=0.999mA;}
        //  else if(irng==M8MA){i=6mA;}
        //$endif
        vsim.Resc(MDC);
        vsim.MRng(irng);
        vsim.SRng(vrng);
        vsim.SVal(v);
        vsim.CPVal(i);
        vsim.CMVal(i*-1);
          vsim.Load();
          
          measure_im.vsim(vsim);
        measure_im.limit(im_limit);
        measure_im.sequence(seq_im);
        measure_im.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_im.Exec();
        break;

      case hsifpinkind:  
        //$if __TESTER_TYPE__ == 119 //for ND4
          if(irng==M8UA){i=20.0uA;} 
          else if(irng==M80UA){i=200uA;}
          else if(irng==M800UA){i=2.00mA;}
          else{i=42mA;}
        //$else          
        //  if(irng==M8UA || irng==M80UA || irng==M800UA){i=0.999mA;}
        //  else if(irng==M8MA){i=6mA;}
        //$endif
        vsim.Resc(MDC);
        vsim.MRng(irng);
        vsim.SRng(vrng);
        vsim.SVal(v);
        vsim.CPVal(i);
        vsim.CMVal(i*-1);
          vsim.Load();
          
          measure_im.vsim(vsim);
        measure_im.limit(im_limit);
        measure_im.sequence(seq_im);
        measure_im.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_im.Exec();
        break;        
      default: break;  
    }
     
      break;
  default:  break;
      }
}
void judge(int &a, Volts &b, Volts &c, int &d)
{
  TEST.Set();
  vm_limit.upper(c);
  vm_limit.lower(b);
  vm_limit.Load();
  if(d==I) a=im;
  switch(a)
  {
    case vm:
    switch(chkind)    
    {
      case vspinkind:
        measure_dpsvm.isvm(dpsisvm);
        measure_dpsvm.limit(vm_limit);
        measure_dpsvm.Set();
        sequence.PreExec();
        measure_dpsvm.Exec();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        sequence.PostExec();
        break;
      
     case rvspinkind:
        isvm.Resc(HVDC);
        isvm.SRng(irng);
        isvm.MRng(vrng);
        isvm.SVal(i);
        isvm.CPVal(v);
        isvm.CMVal(v*-1);
