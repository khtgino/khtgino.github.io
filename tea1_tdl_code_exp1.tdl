int test_func_01()
{
  int tmp_test_num=0;

  testno=69000;

  cw1_num[ 0]=0;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 2000MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(2); edge(rate2*0,rate2*0.5); pin(DPIN_PAD_LOCK   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD_MV_1);
  rly=dir; fmt=fixh; vih=     6.0V; vil=    0.0V;  pin(DPIN_PAD_TEST_SD_MV_2);

  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=off; mode=ppdz; rng=R10V; scan_mode=STEP_INC;scan_step=1; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-0uA; iol=0uA; vt1=0V;vt2=0V;
  lcdoption=NONE; lcdvoh= 1.2V;lcdvol= 0.6V;
  
  lcdstrb1 =rate1-4nS;
  lcdstrb2 =rate2-4nS;
  lcdstrb3 =rate3-4nS;
  lcddigit1=rate1-4nS;
  lcddigit2=rate2-4nS;
  lcddigit3=rate3-4nS;

  lcdsamp.samp(1,lcddigit1);
  lcdsamp.samp(2,lcddigit2);
  lcdsamp.samp(3,lcddigit3);
  lcdsamp.samp(4,lcddigit4);
  lcdsamp.Load();
  
  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
        
  lcdpin(ALL_LCDPIN);
  
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=STEP_INC;scan_step=1; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-0uA; iol=0uA; vt1=0V;vt2=0V;
  lcdoption=NONE; lcdvoh= 1.2V;lcdvol= 0.6V;
  
  lcdstrb1 =rate1-4nS;
  lcdstrb2 =rate2-4nS;
  lcdstrb3 =rate3-4nS;
  lcddigit1=rate1-4nS;
  lcddigit2=rate2-4nS;
  lcddigit3=rate3-4nS;

  lcdsamp.samp(1,lcddigit1);
  lcdsamp.samp(2,lcddigit2);
  lcdsamp.samp(3,lcddigit3);
  lcdsamp.samp(4,lcddigit4);
  lcdsamp.Load();
  
  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
        
  lcdpin(ALL_LCD_SOURCE1);
 
  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

  mode =ppcp;
//===========================================================================================
  ARRAY<double> tmp_ary_00(2000);
  ARRAY<double> tmp_ary_01(6000);
  ARRAY<double> tmp_ary_02(6000);
  ARRAY<double> tmp_ary_03(6000);
  
  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  sr(on);

  wait(6.0mS);
  
  
  patf("a189b1_cp02_sdmcp_always_ra_nor_nd4_exmode.lpa");
  pat(run);
  
  
  
  mode=ppdz;
  
  patf("mdgt_pat_01_exp.lpa");

  for( int_i=0; int_i<1000;  int_i+=1 )
  {
  pat(run);
  calcstart(ALL_LCD , tmp_ary_00);
  tmp_ary_01[int_i]=tmp_ary_00[0];
  tmp_ary_02[int_i]=tmp_ary_00[20];
  tmp_ary_03[int_i]=tmp_ary_00[21];
  
  }
  
  Plot_WS(tmp_ary_01,"tmp_ary_01");
  Plot_WS(tmp_ary_02,"tmp_ary_02");
  Plot_WS(tmp_ary_03,"tmp_ary_03");
  
  
//===========================================================================================

  sr(off);
  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("GS_HRD 1 & 2-Pair Pattern Run                ");

  return 0;
}

