  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-2-S2 MAX");  judge( sxmux_p2_max_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-2-S2 MIN");  judge( sxmux_p2_min_s2 , 2000 , 5500 );
