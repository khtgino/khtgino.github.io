  lcdpin(ODD_LCD);


  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//=========================== Get Data ============================================================
  sr(on);

  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  patf("fn01a1_slew_rate_03_pol_0_data_01_pwrc_a_000_25_0925.lpa"); //HL --> LH 

