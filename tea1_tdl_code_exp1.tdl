void DPIN_OPEN(DPIN &tmp_pin_name)
{       
  dpin_define_1.pinlist(tmp_pin_name);
  dpin_define_1.kind(OPEN);
  dpin_define_1.option(NONE);
  dpin_define_1.Load();
}
void DPIN_OPEN(PINLIST &tmp_pin_name)
{       
  dpin_define_1.pinlist(tmp_pin_name);
  dpin_define_1.kind(OPEN);
  dpin_define_1.option(NONE);
  dpin_define_1.Load();
}
