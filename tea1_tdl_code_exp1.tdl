ARRAY<int>  intArray_index(levelno*lcdpinno);//20090423 For 804 Channel
    
    int_k=0;
    if(lcdpinno%4==0) int_M=lcdpinno/2;
    if(lcdpinno%4==2) int_M=lcdpinno/2+1;
    for(int_j=0;int_j<levelno;int_j++)
    {for(int_i=0;int_i<lcdpinno;int_i++) 
    {
      switch(int_i%4)
      {
        case 0 : intArray_index[lcdpinno*int_j+int_k]=int_i+lcdpinno*int_j; int_k++; break;
        case 1 : intArray_index[lcdpinno*int_j+int_k]=int_i+lcdpinno*int_j; int_k++; break;
        case 2 : intArray_index[lcdpinno*int_j+int_M]=int_i+lcdpinno*int_j; int_M++; break;
        case 3 : intArray_index[lcdpinno*int_j+int_M]=int_i+lcdpinno*int_j; int_M++; break;
    
        default:break;
      }
      
      if(lcdpinno%4==0) {if(int_M==lcdpinno) int_M=lcdpinno/2;
            if(int_k>=lcdpinno/2) int_k=0;}
      if(lcdpinno%4==2) {if(int_M==lcdpinno) int_M=lcdpinno/2+1;
            if(int_k>lcdpinno/2) int_k=0;}
      
    }}  

