  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 2400MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.5V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(2); edge(rate2*0,rate2*0.5); pin(DPIN_PAD_LOCK   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD_MV_1);
  rly=off; fmt=open; vih=     6.0V; vil=    0.0V;  pin(DPIN_PAD_TEST_SD_MV_2);

  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=512; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;
  //lcdoption=NONE;
  lcdoption=LCDVT1;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================  
  ARRAY<int> gs_tmp_check(4);

//================================================================================================  

  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();
  wait(6.0mS);

  tno(tmp_test_num++); cat(17); TSTime("Source DVOC Pattern Run Left");

  //--------------------------------------------------------------------
  patf("fn01a1_dvoc_ch1446_dpsel_4p_bsel_1_shl_1_gop_chop_0_cop_chop_0_25_1008.lpa");

  pat(run);
  calcstart(gs0101_pinc_d01_01);
  //--------------------------------------------------------------------
  patf("fn01a1_dvoc_ch1446_dpsel_4p_bsel_1_shl_1_gop_chop_0_cop_chop_1_25_1008.lpa");
  
  pat(run);
  calcstart(gs0101_pinc_d01_02);
  //--------------------------------------------------------------------
  patf("fn01a1_dvoc_ch1446_dpsel_4p_bsel_1_shl_1_gop_chop_1_cop_chop_0_25_1008.lpa");
  
  pat(run);
  calcstart(gs0101_pinc_d02_01);
  //--------------------------------------------------------------------
  patf("fn01a1_dvoc_ch1446_dpsel_4p_bsel_1_shl_1_gop_chop_1_cop_chop_1_25_1008.lpa");
  
  pat(run);
  calcstart(gs0101_pinc_d02_02);

//===========================================================================================
  //dev_vh_0101_d01_01
  //dev_vl_0101_d01_01
  //dev_vh_0101_d01_02
  //dev_vl_0101_d01_02
  //dev_vh_0101_d02_01
  //dev_vl_0101_d02_01
  //dev_vh_0101_d02_02
  //dev_vl_0101_d02_02
  
  ary_davg(dev_vh_0101_d01_01,lcdpinno,avg_pos_0101_d01_01);
  ary_davg(dev_vl_0101_d01_01,lcdpinno,avg_neg_0101_d01_01);
  ary_davg(dev_vh_0101_d01_02,lcdpinno,avg_pos_0101_d01_02);
  ary_davg(dev_vl_0101_d01_02,lcdpinno,avg_neg_0101_d01_02);
  ary_davg(dev_vh_0101_d02_01,lcdpinno,avg_pos_0101_d02_01);
  ary_davg(dev_vl_0101_d02_01,lcdpinno,avg_neg_0101_d02_01);
  ary_davg(dev_vh_0101_d02_02,lcdpinno,avg_pos_0101_d02_02);
  ary_davg(dev_vl_0101_d02_02,lcdpinno,avg_neg_0101_d02_02);

  gs0101_dvoc_pos1_val_d01_02=avg_pos_0101_d01_01-gs0101_dvoc_pos_ideal;
  gs0101_dvoc_neg1_val_d01_02=avg_neg_0101_d01_01-gs0101_dvoc_neg_ideal;
  gs0101_dvoc_pos2_val_d01_02=avg_pos_0101_d01_02-gs0101_dvoc_pos_ideal;
  gs0101_dvoc_neg2_val_d01_02=avg_neg_0101_d01_02-gs0101_dvoc_neg_ideal;
  gs0101_dvoc_pos1_val_d02_02=avg_pos_0101_d02_01-gs0101_dvoc_pos_ideal;
  gs0101_dvoc_neg1_val_d02_02=avg_neg_0101_d02_01-gs0101_dvoc_neg_ideal;
  gs0101_dvoc_pos2_val_d02_02=avg_pos_0101_d02_02-gs0101_dvoc_pos_ideal;
  gs0101_dvoc_neg2_val_d02_02=avg_neg_0101_d02_02-gs0101_dvoc_neg_ideal;

  chop1_dvoc_pos_result_01[0]=ary_mcmp(gs0101_dvoc_pos1_val_d01_02,DVOChlimit,DVOCllimit);
  chop1_dvoc_neg_result_01[0]=ary_mcmp(gs0101_dvoc_neg1_val_d01_02,DVOChlimit,DVOCllimit);
  chop2_dvoc_pos_result_01[0]=ary_mcmp(gs0101_dvoc_pos2_val_d01_02,DVOChlimit,DVOCllimit);
  chop2_dvoc_neg_result_01[0]=ary_mcmp(gs0101_dvoc_neg2_val_d01_02,DVOChlimit,DVOCllimit);
  chop1_dvoc_pos_result_02[0]=ary_mcmp(gs0101_dvoc_pos1_val_d02_02,DVOChlimit,DVOCllimit);
  chop1_dvoc_neg_result_02[0]=ary_mcmp(gs0101_dvoc_neg1_val_d02_02,DVOChlimit,DVOCllimit);
  chop2_dvoc_pos_result_02[0]=ary_mcmp(gs0101_dvoc_pos2_val_d02_02,DVOChlimit,DVOCllimit);
  chop2_dvoc_neg_result_02[0]=ary_mcmp(gs0101_dvoc_neg2_val_d02_02,DVOChlimit,DVOCllimit);

  ARRAY<double>  dvoc_pos_avg_01(levelno) , dvoc_neg_avg_01(levelno);

  for( int_k=0; int_k<256 ; int_k+=1 )
   {
     dvoc_pos_avg_01[int_k]=(gs0101_dvoc_pos1_val_d01_02[int_k]+gs0101_dvoc_pos2_val_d01_02[int_k]+gs0101_dvoc_pos1_val_d02_02[int_k]+gs0101_dvoc_pos2_val_d02_02[int_k])/4;
     dvoc_neg_avg_01[int_k]=(gs0101_dvoc_neg1_val_d01_02[int_k]+gs0101_dvoc_neg2_val_d01_02[int_k]+gs0101_dvoc_neg1_val_d02_02[int_k]+gs0101_dvoc_neg2_val_d02_02[int_k])/4;
   }
  chop1_dvoc_pos_result_01[1]=ary_mcmp(dvoc_pos_avg_01,DVOChlimit_SP0,DVOCllimit_SP0);
  chop1_dvoc_neg_result_02[1]=ary_mcmp(dvoc_neg_avg_01,DVOChlimit_SP0,DVOCllimit_SP0);

//===========================================================================================
  if( Debug_Mode_EN==0 )
   { 
     GS_Get_Func(datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-gop-0-chop-0-dvoc1_vh_avg.asc",avg_pos_0101_d01_01);
     GS_Get_Func(datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-gop-0-chop-0-dvoc1_vl_avg.asc",avg_neg_0101_d01_01);
     GS_Get_Func(datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-gop-0-chop-1-dvoc2_vh_avg.asc",avg_pos_0101_d01_02);
     GS_Get_Func(datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-gop-0-chop-1-dvoc2_vl_avg.asc",avg_neg_0101_d01_02);
     GS_Get_Func(datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-gop-1-chop-0-dvoc1_vh_avg.asc",avg_pos_0101_d02_01);
     GS_Get_Func(datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-gop-1-chop-0-dvoc1_vl_avg.asc",avg_neg_0101_d02_01);
     GS_Get_Func(datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-gop-1-chop-1-dvoc2_vh_avg.asc",avg_pos_0101_d02_02);
     GS_Get_Func(datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-gop-1-chop-1-dvoc2_vl_avg.asc",avg_neg_0101_d02_02);

    }

//===========================================================================================

  tno(tmp_test_num++); cat(40); dcmnt("DVOC gop-0-chop-0-dvoc1_vh(Right)"); judge( chop1_dvoc_pos_result_01[0] , 0,0 );
  tno(tmp_test_num++); cat(40); dcmnt("DVOC gop-0-chop-0-dvoc1_vl(Right)"); judge( chop1_dvoc_neg_result_01[0] , 0,0 );
  tno(tmp_test_num++); cat(40); dcmnt("DVOC gop-0-chop-1-dvoc2_vh(Right)"); judge( chop2_dvoc_pos_result_01[0] , 0,0 );
  tno(tmp_test_num++); cat(40); dcmnt("DVOC gop-0-chop-1-dvoc2_vl(Right)"); judge( chop2_dvoc_neg_result_01[0] , 0,0 );
  tno(tmp_test_num++); cat(40); dcmnt("DVOC gop-1-chop-0-dvoc1_vh(Right)"); judge( chop1_dvoc_pos_result_02[0] , 0,0 );
  tno(tmp_test_num++); cat(40); dcmnt("DVOC gop-1-chop-0-dvoc1_vl(Right)"); judge( chop1_dvoc_neg_result_02[0] , 0,0 );
  tno(tmp_test_num++); cat(40); dcmnt("DVOC gop-1-chop-1-dvoc2_vh(Right)"); judge( chop2_dvoc_pos_result_02[0] , 0,0 );
  tno(tmp_test_num++); cat(40); dcmnt("DVOC gop-1-chop-1-dvoc2_vl(Right)"); judge( chop2_dvoc_neg_result_02[0] , 0,0 );

  tno(tmp_test_num++); cat(38); dcmnt("DVOC-AVG vh"); judge( chop1_dvoc_pos_result_01[1] , 0,0 );
  tno(tmp_test_num++); cat(38); dcmnt("DVOC-AVG vl"); judge( chop1_dvoc_neg_result_01[1] , 0,0 );

//===========================================================================================

  //sr(off);
  POWER_OFF_FUNC1();
  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("GS DVOC Test ");

  return 0;
}
int source_jitter()
{
  HSIF_JITTER R_JITTER;
  
  int tmp_test_num=0;

  testno=18100;

  cw1_num[ 0]=1;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================================================================================
  for( int_i=1 ; int_i<=2.1 ; int_i+=1 )
  {
    if( int_i==1 ){ shmoo_vcc=1.60V; }
    if( int_i==2 ){ shmoo_vcc=2.00V; }

//================================== variable setting ======================================
  freq  = 2400MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(shmoo_vcc);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (shmoo_vcc)*1.0;
  vil_in[1]  = (shmoo_vcc)*0.0;
  vih_in[2]  = (shmoo_vcc)*1.0;
  vil_in[2]  = (shmoo_vcc)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (shmoo_vcc)*0.7;
  vol_in[1]  = (shmoo_vcc)*0.3;
  voh_in[2]  = (shmoo_vcc)*0.7;
  vol_in[2]  = (shmoo_vcc)*0.3;

  //ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

  rly=dir; vi=vfim; v= shmoo_vcc; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
  rly=dir; vi=vfim; v= shmoo_vcc; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(2); edge(rate2*0,rate2*0.5); pin(DPIN_PAD_LOCK   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD_MV_1);
  rly=off; fmt=open; vih=     6.0V; vil=    0.0V;  pin(DPIN_PAD_TEST_SD_MV_2);

  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL);

  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  //rly=dir; fmt=fixh; vih=2.2V; vil=vil_in[2]; pin(DPIN_PAD_CNT_L     );

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=512; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;
  //lcdoption=NONE;
  lcdoption=LCDVT1;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================  
  ARRAY<int> gs_tmp_check(4);
//================================================================================================  
  R_JITTER.mode(OFF);
  if( int_i==1 ){ R_JITTER.mode(ON); R_JITTER.freq( 1MHz); R_JITTER.magnitude(0.25); R_JITTER.Load(); }
  if( int_i==2 ){ R_JITTER.mode(ON); R_JITTER.freq( 1MHz); R_JITTER.magnitude(0.25); R_JITTER.Load(); }
  if( int_i==3 ){ R_JITTER.mode(ON); R_JITTER.freq( 1MHz); R_JITTER.magnitude(0.25); R_JITTER.Load(); }

//================================================================================================  
  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD);
  wait(1.0mS);
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD);
  
  tno(tmp_test_num++); cat(17);

  //--------------------------------------------------------------------
  patf("fn01a1_0101_ch1446_dpsel_2p_8b_shl_0_int_stb_1_reg_dpsel_en_0_25_0925.lpa");

  pat(run);
  calcstart(gs0101_tmp_d01_01);

  //--------------------------------------------------------------------
  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL);

  patf("fn01a1_0101_ch1446_dpsel_4p_8b_shl_1_int_stb_0_reg_dpsel_en_0_25_0925.lpa");
  
  pat(run);
  calcstart(gs0101_tmp_d01_02);
  //compare_gs_0101_gst();  
//===========================================================================================
  compare_temp_gst(dev_vh_tmp_d01_01,dev_vl_tmp_d01_01,dev_gs0101vh_hlimit_165V,dev_gs0101vh_llimit_165V,dev_gs0101vl_hlimit_165V,dev_gs0101vl_llimit_165V,combine_tmp_result_01[0]);
  compare_temp_gst(dev_vh_tmp_d01_02,dev_vl_tmp_d01_02,dev_gs0101vh_hlimit_165V,dev_gs0101vh_llimit_165V,dev_gs0101vl_hlimit_165V,dev_gs0101vl_llimit_165V,combine_tmp_result_02[0]);
//===========================================================================================
  if( int_i==1 ){tno(tmp_test_num++); cat(30); dcmnt("0101_2p8b_Jitter 1MHz (2.0V)"); judge( combine_tmp_result_01[0] , 0,0 ); }
  if( int_i==1 ){tno(tmp_test_num++); cat(31); dcmnt("0101_4p8b_Jitter 1MHz (2.0V)"); judge( combine_tmp_result_02[0] , 0,0 ); }
  if( int_i==2 ){tno(tmp_test_num++); cat(32); dcmnt("0101_2p8b_Jitter 1MHz (1.6V)"); judge( combine_tmp_result_01[0] , 0,0 ); }
  if( int_i==2 ){tno(tmp_test_num++); cat(33); dcmnt("0101_4p8b_Jitter 1MHz (1.6V)"); judge( combine_tmp_result_02[0] , 0,0 ); }

  }
//===========================================================================================
  R_JITTER.mode(OFF);
  pat(stop);
  
  //sr(off);
  POWER_OFF_FUNC1();
  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("GS_0101 Jitter(1.0MHz) Test ");

  return 0;
}

int source_jitter_shmoo()
{
  HSIF_JITTER R_JITTER;
  
  int tmp_test_num=0;

  testno=18100;

  cw1_num[ 0]=1;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
