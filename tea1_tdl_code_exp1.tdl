void lcdpin_set(Volts tmp_v , LCDPINLIST &lcdpinlist)
{
  chkind=lcdpinkind;
  measure_im.pinlist(lcdpinlist);
  measure_vm.pinlist(lcdpinlist);
  signallcd.lcdpin(lcdpinlist);

  signallcd.vt(tmp_v);
  signallcd.ilh(ioh);
  signallcd.ill(iol);
  if (lcdrly==off)
  {
    signallcd.kind(OPEN);
    signallcd.voh(lcdvoh);
    signallcd.vol(lcdvol);
