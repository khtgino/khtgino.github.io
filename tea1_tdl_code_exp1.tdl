//=================================================================================================
//========================== RM97190, A128B9T1~8 Subfunction ======================================
//=================================================================================================
void call(int &sub)
{
  switch(sub)
  {  
    case gama_get:
         gamma1 = avdd-0.2V;
           gamma7 = avdd*0.5+0.1V;

           gamma8= avdd*0.5-0.1V;
           gamma14= 0.2V;

     
      break;
      
    case Rvi_set:
      rly=on; vi=vfim; vrng=R20V; 
        /*
        v=gamma1;  rvipin(RVS_GMAO_1);
        v=gamma2;  rvipin(RVS_VR2);
        v=gamma3;  rvipin(RVS_VR3);
        v=gamma4;  rvipin(RVS_VR4);
        v=gamma5;  rvipin(RVS_VR5);
        v=gamma6;  rvipin(RVS_VR6);
        v=gamma7;  rvipin(RVS_GMAO_7);
        v=gamma8;  rvipin(RVS_GMAO_8);
        v=gamma9;  rvipin(RVS_VR9);
        v=gamma10;  rvipin(RVS_GMAO_10);
        v=gamma11;  rvipin(RVS_GMAO_11);
        v=gamma12;  rvipin(RVS_GMAO_12);
        v=gamma13;  rvipin(RVS_GMAO_13);
        v=gamma14;  rvipin(RVS_GMAO_14);
        v=gamma15;  rvipin(RVS_GMAO_15);
        v=gamma16;  rvipin(RVS_GMAO_16);
        v=gamma17;  rvipin(RVS_GMAO_17);
        v=gamma18;  rvipin(RVS_GMAO_18);
        v=gamma19;  rvipin(RVS_GMAO_19);
        v=gamma20;  rvipin(RVS_VR20);
        v=gamma21;  rvipin(RVS_VR21);
        v=gamma22;  rvipin(RVS_VR22);
        */
      rvs_vs.rvspin(RVS_PAD_VGMAL1);     rvs_vs.SRng(vrng);  rvs_vs.SVal(gamma1 );      rvs_vs.Load();
      rvs_vs.rvspin(RVS_PAD_VGMAR1);     rvs_vs.SRng(vrng);  rvs_vs.SVal(gamma1 );      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_VR2);                         rvs_vs.SVal(gamma2 );      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_VR3);                         rvs_vs.SVal(gamma3 );      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_VR4);                         rvs_vs.SVal(gamma4 );      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_VR5);                         rvs_vs.SVal(gamma5 );      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_VR6);                         rvs_vs.SVal(gamma6 );      rvs_vs.Load();
      rvs_vs.rvspin(RVS_PAD_VGMAL7);                         rvs_vs.SVal(gamma7 );      rvs_vs.Load();
      rvs_vs.rvspin(RVS_PAD_VGMAR7);                         rvs_vs.SVal(gamma7 );      rvs_vs.Load();
      rvs_vs.rvspin(RVS_PAD_VGMAL8);                         rvs_vs.SVal(gamma8 );      rvs_vs.Load();
      rvs_vs.rvspin(RVS_PAD_VGMAR8);                         rvs_vs.SVal(gamma8 );      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_VR9);                         rvs_vs.SVal(gamma9 );      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_GMAO_10);                        rvs_vs.SVal(gamma10);      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_GMAO_11);                        rvs_vs.SVal(gamma11);      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_GMAO_12);                        rvs_vs.SVal(gamma12);      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_GMAO_13);                        rvs_vs.SVal(gamma13);      rvs_vs.Load();
      rvs_vs.rvspin(RVS_PAD_VGMAL14);                        rvs_vs.SVal(gamma14);      rvs_vs.Load();
      rvs_vs.rvspin(RVS_PAD_VGMAR14);                        rvs_vs.SVal(gamma14);      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_GMAO_15);                        rvs_vs.SVal(gamma15);      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_GMAO_16);                        rvs_vs.SVal(gamma16);      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_GMAO_17);                        rvs_vs.SVal(gamma17);      rvs_vs.Load();
      //rvs_vs.rvspin(RVS_GMAO_18);                        rvs_vs.SVal(gamma18);      rvs_vs.Load();
      
      rvsunit_relay.rvspin(RVS_GMA_R_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();
      rvsunit_relay.rvspin(RVS_GMA_L_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();      
      
      break;
      
    default:  
      break;
      }

}

void Sequence_Set()
{
  sequence.powerT0(3.0mS);
  sequence.punit( 1,0.5mS, VS_DVDD            );
  sequence.punit( 2,0.5mS, VS_DVDD_CDR        );
  sequence.punit( 3,1.0mS, VS_PAVDD           );
  sequence.punit( 4,1.0mS, VS_VGH1            );
  sequence.punit( 5,1.0mS, VS_VGH2            );
  sequence.punit( 6,1.5mS, VS_NAVDD           );
  sequence.punit( 7,1.5mS, VS_LVGL            );
  sequence.punit( 8,1.5mS, VS_VGL             );
  sequence.punit( 9,1.5mS, VS_PAD_VCOM_ALL    );
  sequence.punit(13,1.5mS, VS_PAD_TEST_VREFN  );

  sequence.signalT0(3mS);
  sequence.sunit(1,1.0mS,ALL_IOPIN,ALL);
  sequence.sunit(2,2.0mS,LCDALL);
  sequence.sunit(3,2.0mS,ALL_LCDPIN,LPPDC);
  sequence.sunit(4,2.0mS,ALL_RVS,RVS);
  sequence.sunit(5,2.0mS,UDC);
  sequence.sunit(6,2.0mS,MDC);
  sequence.sunit(7,2.0mS,HVDC);
  sequence.sunit(8,2.0mS,ALL_HSIF_PIN);
  sequence.Load();

  seq_vm.seq(1.0mS,1.0mS,1.0mS);
  seq_im.seq(3.0mS,3.0mS,3.0mS);
};

void GS_Get_Dut1()
{
    
    prober.mGet_Axis(axis_x, axis_y);
    str_axis_x1 = (string)axis_x[0];
    str_axis_x2 = (string)axis_x[1];
    str_axis_y1 = (string)axis_y[0];
    str_axis_y2 = (string)axis_y[1];

    path_dev_vh_avg = datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-dev_vh_avg.asc";
    path_dev_vl_avg = datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-dev_vl_avg.asc";
    path_dev_vh_max = datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-dev_vh_max.asc";
