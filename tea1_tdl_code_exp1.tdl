    wait(1mS);

    tno(tmp_test_num++); cat(cat_os2); dcmnt("LCD PIN O/S (-)");

    rly=off; term=off; vi=ifvm; i=-150uA; irng=R800UA; v=1.6V; vrng=M12V; rng=R12V; lcdpin(ALL_LCD_OS); judge(vm, -1.0V, -0.2V, V);

    lcd_os_V=4.6V;
