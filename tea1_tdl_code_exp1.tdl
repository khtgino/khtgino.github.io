    lcdstrb.Load();
    signallcd.Load();
    measure_im.pinlist(lcdpinlist);
    measure_vm.pinlist(lcdpinlist);
  }
  else
  {
    switch (mode)
    {
      case dirpmu:
        sigdclcd.lcdpin(lcdpinlist);
        sigdclcd.dc(HVDC);
