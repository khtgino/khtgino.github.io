  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

  int spi_shm_01,spi_shm_02;

  prober.mGet_Axis(axis_x, axis_y);
  str_axis_x1 = (string)axis_x[0];
  str_axis_x2 = (string)axis_x[1];
  str_axis_y1 = (string)axis_y[0];
  str_axis_y2 = (string)axis_y[1];

  
  cout<<"======= SPI CRC PAT SHMOO ========\n";
  cout.width(3); cout<<"===< X:"<<str_axis_x1<<" , Y:"<<str_axis_y1<<" >===\n";
  for( int_i=5; int_i<=40;  int_i+=1 )
  {
  cout.width(3); cout<<"Freq["<<int_i<<"MHz]=";
//================================== variable setting ======================================
  freq  = int_i*1MHz*4;

  rate1 = (1/freq)*1;
  rate2 = (1/freq)*1;
  rate3 = 1/10MHz;
  rate4 = (1/freq)*1;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =100mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.6;
  vol_in[1]  = (1.8V)*0.6;
  voh_in[2]  = 1.2V;
  vol_in[2]  = 1.2V;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(OFF,rate1,rate2,rate3,rate4);

  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(TOURCH_GP01);
  rly=on; fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

//=========================== FIXH/L Setting ======================================================
  rly=on;  fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

  rly=off; fmt=OPEN; vih=1.75V; vil=vil_in[2]; pin(DPIN_PAD_LOCK);
  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_EN);

  rly=on;  fmt=RZO; option=FREERUN; iokindsel=IN;  t(3); edge(rate3*0,rate3*0.5); pin(DPIN_PAD_TP_CLK);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppcp; rng=R10V; scan_mode=STEP_INC;scan_step=levelno*2; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-0uA; iol=0uA; vt1=0V;vt2=0V;
  lcdoption=NONE;

  lcdstrb1 =rate1/2;
  lcdstrb2 =rate2/2;
  lcdstrb3 =rate3/2;
  lcddigit1=rate1/2;
  lcddigit2=rate2/2;
  lcddigit3=rate3/2;

  lcdpin(ALL_LCD);
  
  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================  
  //sr(on);
  POWER_ON_FUNC1();
 
  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;

  wait(10mS);

  tno(tmp_test_num++); cat(74); dcmnt("TOUCH SPI SHMOO TEST");
  
  int_k=0;
  patf("fn01a1_tp_cp06_spi_single_250908_nor_nd4.lpa");

  FCLK.PreExec();

  meas(result,int_j);
  int_k=int_k+int_j;

  tno(tmp_test_num++); cat(74); dcmnt("TOUCH SPI DUAL CRC TEST");
  
  patf("fn01a1_tp_cp07_spi_dual_250908_nor_nd4.lpa");
  meas(result,int_j);
  int_k=int_k+int_j;


  FCLK.PostExec();
  
  if( int_j==0 ){ cout<<"Pass\n"; }
  if( int_j!=0 ){ cout<<"Fail\n"; }
  
  }
  
//===========================================================================================
//===========================================================================================
    dfm.type(DFM_FAILSTORE);
    dfm.begin(0);
    dfm.end(0x3ffffdf);
    dfm.fcnt(4095);
    dfm.Load();
    
  pat(stop);
  //sr(off);
  POWER_OFF_FUNC1();


  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("Touch SPI Test                ");

  return 0;
}

