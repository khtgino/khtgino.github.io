  if( shm_n03==2 ){ cout<<"//PVDD:6.0V&NVDD:-6.0V&Vcm:" <<shm_n04*0.1V<<"&Vdiff_p2p:"<<shm_n05*1.0mV<<"&Chip:"<<test_chip_name; }
  if( shm_n03==3 ){ cout<<"//PVDD:6.0V&NVDD:-6.0V&Vcm:" <<shm_n04*0.1V<<"&Vdiff_p2p:"<<shm_n05*1.0mV<<"&Chip:"<<test_chip_name; }
  if( shm_n03==4 ){ cout<<"//PVDD:6.0V&NVDD:-6.0V&Vcm:" <<shm_n04*0.1V<<"&Vdiff_p2p:"<<shm_n05*1.0mV<<"&Chip:"<<test_chip_name; }

  cout<<"\n";
