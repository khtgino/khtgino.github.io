  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

  ARRAY<int> tmp_shm_ary01(9);
  ARRAY<int> tmp_shm_ary02(9);

  cout<<"//====== Chip:"<<test_chip_name<<" , X:"<<axis_x[0]<<" , Y:"<<axis_y[0]<<"====================\n";
  cout<<"//                 < 2p8b > | < 4p8b >\n";
  cout<<"//                  1122334 |  1122334\n";
  cout<<"//                 50505050 | 50505050\n";
  cout<<"//                 MMMMMMMM | MMMMMMMM\n";
  cout<<"//                 HHHHHHHH | HHHHHHHH\n";
  cout<<"//                 zzzzzzzz | zzzzzzzz\n";
  cout<<"//                          |         \n";

//================================================================================================
  for( int_j=10 ; int_j<=20.1 ; int_j+=1 )
  {

   cout.width(9); cout<<"Freq["<<int_j*100.0MHz<<"]=> ";

  for( int_i=1 ; int_i<=8.1 ; int_i+=1 )
  {
   //cout.width(7); cout<<"Pat-0101 Jitter["<<int_i*5.0MHz<<"]=> ";

//================================== variable setting ======================================
  freq  = int_j*100MHz; //1600MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(2); edge(rate2*0,rate2*0.5); pin(DPIN_PAD_LOCK   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD_MV_1);
  rly=off; fmt=open; vih=     6.0V; vil=    0.0V;  pin(DPIN_PAD_TEST_SD_MV_2);

  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  //rly=dir; fmt=fixh; vih=2.2V; vil=vil_in[2]; pin(DPIN_PAD_CNT_L     );

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=512; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;
  //lcdoption=NONE;
  lcdoption=LCDVT1;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================  
  ARRAY<int> gs_tmp_check(4);
//================================================================================================  
  R_JITTER.mode(OFF);
  R_JITTER.mode(ON); R_JITTER.freq( 5MHz*int_i); R_JITTER.magnitude(0.25); R_JITTER.Load();
  //if( int_i==1 ){ R_JITTER.mode(ON); R_JITTER.freq( 40MHz); R_JITTER.magnitude(0.25); R_JITTER.Load(); }
  //if( int_i==2 ){ R_JITTER.mode(ON); R_JITTER.freq( 30MHz); R_JITTER.magnitude(0.25); R_JITTER.Load(); }
  //if( int_i==3 ){ R_JITTER.mode(ON); R_JITTER.freq( 10MHz); R_JITTER.magnitude(0.25); R_JITTER.Load(); }

//================================================================================================  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD);

  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();
  wait(6.0mS);
  
  tno(tmp_test_num++); cat(17);

  //--------------------------------------------------------------------
  patf("fn01a1_0101_ch1446_dpsel_2p_8b_shl_0_int_stb_1_reg_dpsel_en_0_25_0925.lpa");
  
  pat(run);
  calcstart(gs0101_tmp_d01_01);
  //compare_gs_0101_gst();  
  //--------------------------------------------------------------------
  patf("fn01a1_0101_ch1446_dpsel_4p_8b_shl_1_int_stb_0_reg_dpsel_en_0_25_0925.lpa");
  
  pat(run);
  calcstart(gs0101_tmp_d01_02);
  //compare_gs_0101_gst();  
//===========================================================================================
  compare_temp_gst(dev_vh_tmp_d01_01,dev_vl_tmp_d01_01,dev_gs0101vh_hlimit_165V_sp1,dev_gs0101vh_llimit_165V_sp1,dev_gs0101vl_hlimit_165V_sp1,dev_gs0101vl_llimit_165V_sp1,combine_tmp_result_01[0]);
  compare_temp_gst(dev_vl_tmp_d01_02,dev_vh_tmp_d01_02,dev_gs0101vh_hlimit_165V_sp1,dev_gs0101vh_llimit_165V_sp1,dev_gs0101vl_hlimit_165V_sp1,dev_gs0101vl_llimit_165V_sp1,combine_tmp_result_02[0]);
//===========================================================================================
  //if( int_i==1 ){tno(tmp_test_num++); cat(18); dcmnt("0101_2p8b_Jitter 40MHz (Left)"); judge( combine_tmp_result_01[0] , 0,0 ); }
  //if( int_i==1 ){tno(tmp_test_num++); cat(18); dcmnt("0101_4p8b_Jitter 40MHz (Left)"); judge( combine_tmp_result_02[0] , 0,0 ); }
  //if( int_i==2 ){tno(tmp_test_num++); cat(18); dcmnt("0101_2p8b_Jitter 30MHz (Left)"); judge( combine_tmp_result_01[0] , 0,0 ); }
  //if( int_i==2 ){tno(tmp_test_num++); cat(18); dcmnt("0101_4p8b_Jitter 30MHz (Left)"); judge( combine_tmp_result_02[0] , 0,0 ); }
  //if( int_i==3 ){tno(tmp_test_num++); cat(18); dcmnt("0101_2p8b_Jitter 10MHz (Left)"); judge( combine_tmp_result_01[0] , 0,0 ); }
  //if( int_i==3 ){tno(tmp_test_num++); cat(18); dcmnt("0101_4p8b_Jitter 10MHz (Left)"); judge( combine_tmp_result_02[0] , 0,0 ); }

  tmp_shm_ary01[int_i]=combine_tmp_result_01[0];
  tmp_shm_ary02[int_i]=combine_tmp_result_02[0];
  }

  for( int_i=1 ; int_i<=8.1 ; int_i+=1 ){ if( tmp_shm_ary01[int_i]==0 ){ cout<<"P"; }else{ cout<<"."; } }
  cout<<" | ";
  for( int_i=1 ; int_i<=8.1 ; int_i+=1 ){ if( tmp_shm_ary02[int_i]==0 ){ cout<<"P"; }else{ cout<<"."; } }
  cout<<"\n";


  }

//===========================================================================================

//===========================================================================================
  R_JITTER.mode(OFF);

  //sr(off);
  POWER_OFF_FUNC1();
  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================
  cout<<"\n";

  TSTime("GS_0101 Jitter Test              ");

  return 0;
}

