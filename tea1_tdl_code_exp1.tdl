ARRAY<double>  fall_time_min_idx(2);


  
void slew_time_calc(int &sub_tno, int &sub_cat, ARRAY<double> &voh_time, ARRAY<double> &vol_time, string &command)
{
  
  ARRAY<double>  calc_time_voh_vol(lcdpinno);   
  ARRAY<double>  calc_time_rise(lcdpinno);  //
  ARRAY<double>  calc_time_fall(lcdpinno);  //
  ARRAY<double>  calc_rise_start(lcdpinno);  //  
  ARRAY<double>  calc_fall_start(lcdpinno);  //  

//  ARRAY<double> rise_max(lcdpinno),rise_st_max(lcdpinno);
//  ARRAY<double> fall_max(lcdpinno),fall_st_max(lcdpinno);
//  ARRAY<double> rise_min(lcdpinno),rise_st_min(lcdpinno);
//  ARRAY<double> fall_min(lcdpinno),fall_st_min(lcdpinno);

  double rise_max,rise_st_max;
  double fall_max,fall_st_max;
  double rise_min,rise_st_min;
  double fall_min,fall_st_min;

  double fall_diff,fall_st_diff;
  double rise_diff,rise_st_diff;

  int     rise_idx,fall_idx;
  rise_idx=0;
  fall_idx=0;
    
  //------ calculate rise/fall time ------//
  calc_time_voh_vol=voh_time-vol_time; 
  
  //------ separate rise/fall data ------//
  for(int_i=0; int_i<lcdpinno; int_i++)
  {
   if(calc_time_voh_vol[int_i] > 0){
     calc_time_rise[rise_idx]=calc_time_voh_vol[int_i];       
    calc_rise_start[rise_idx]=vol_time[int_i];            
     rise_idx++;
   }else{
     calc_time_fall[fall_idx]=calc_time_voh_vol[int_i]*(-1);       
    calc_fall_start[fall_idx]=voh_time[int_i];       
     fall_idx++;     
   }
  }
 
//  ary_dmax(calc_rise_start,rise_idx-1,rise_max);   
//  ary_dmax(calc_fall_start,fall_idx-1,fall_max);   
//  ary_dmin(calc_rise_start,rise_idx-1,rise_min);   
//  ary_dmin(calc_fall_start,fall_idx-1,fall_min);   
//                                                      
//  ary_dmax(calc_rise_start,rise_idx-1,rise_st_max)    ;   
//  ary_dmax(calc_fall_start,fall_idx-1,fall_st_max)    ;   
//  ary_dmin(calc_rise_start,rise_idx-1,rise_st_min)    ;   
//  ary_dmin(calc_fall_start,fall_idx-1,fall_st_min)    ;                                           


ARRAY<double> calc_time_rise_data(rise_idx);
ARRAY<double> calc_time_rise_st_data(rise_idx);
ARRAY<double> calc_time_fall_data(fall_idx);
ARRAY<double> calc_time_fall_st_data(fall_idx);
                                          
for(int_i=0; int_i<rise_idx; int_i++){  
  calc_time_rise_data[int_i]  =calc_time_rise[int_i];
  calc_time_rise_st_data[int_i]  =calc_rise_start[int_i];
}

for(int_i=0; int_i<fall_idx; int_i++){  
  calc_time_fall_data[int_i]  =calc_time_fall[int_i];
  calc_time_fall_st_data[int_i]  =calc_fall_start[int_i];
}


  
  rise_max=ary_max(calc_time_rise_data);       
  fall_max=ary_max(calc_time_fall_data);      
  rise_min=ary_min(calc_time_rise_data);       
  fall_min=ary_min(calc_time_fall_data);      
                                            
  rise_st_max=ary_max(calc_time_rise_st_data);       
  fall_st_max=ary_max(calc_time_fall_st_data);      
  rise_st_min=ary_min(calc_time_rise_st_data);   
  fall_st_min=ary_min(calc_time_fall_st_data);


  rise_diff=rise_max-rise_min;
  fall_diff=fall_max-fall_min;
  
  rise_st_diff=rise_st_max-rise_st_min;
  fall_st_diff=fall_st_max-fall_st_min;
  
  
  tno(sub_tno+1); cat(sub_cat); dcmnt(command+"_Slew Rate Falling (uS)");      judge(fall_max    *1000000 , 0.1 , 1.8 );
  tno(sub_tno+2); cat(sub_cat); dcmnt(command+"_Slew Rate Rising  (uS)");      judge(rise_max    *1000000 , 0.1 , 1.8 );
  tno(sub_tno+3); cat(sub_cat); dcmnt(command+"_Slew Rate Falling DEV(uS)");   judge(fall_diff     *1000000 , 0.0 , 0.8);
  tno(sub_tno+4); cat(sub_cat); dcmnt(command+"_Slew Rate Rising  DEV(uS)");   judge(rise_diff     *1000000 , 0.0 , 0.8);
  //tno(sub_tno+5); cat(sub_cat); dcmnt(command+"_Falling start point(uS)");     judge(fall_st_max *1000000 , 0.1 , 6.5 );
  //tno(sub_tno+6); cat(sub_cat); dcmnt(command+"_Rising start point(uS)");      judge(rise_st_max *1000000 , 0.1 , 6.5 );
  tno(sub_tno+7); cat(sub_cat); dcmnt(command+"_Falling start point DEV(nS)"); judge(fall_st_diff  *1000000000 , 0.0 , 75);
  tno(sub_tno+8); cat(sub_cat); dcmnt(command+"_Rising start point DEV(nS)"); judge(rise_st_diff  *1000000000 , 0.0 , 75);  

}    



void slew_time2_calc(int &sub_tno, int &sub_cat, ARRAY<double> &voh_time1, ARRAY<double> &vol_time1, ARRAY<double> &voh_time2, ARRAY<double> &vol_time2, string &command)
{
  
  ARRAY<double>  calc_time1_voh_vol(lcdpinno);   
  ARRAY<double>  calc_time2_voh_vol(lcdpinno);   
  ARRAY<double>  calc_time_rise(lcdpinno);  
  ARRAY<double>  calc_time_fall(lcdpinno);  
  ARRAY<double>  calc_rise_start(lcdpinno);    
  ARRAY<double>  calc_fall_start(lcdpinno);  

  double rise_max,rise_st_max;
  double fall_max,fall_st_max;
  double rise_min,rise_st_min;
  double fall_min,fall_st_min;

  double fall_diff,fall_st_diff;
  double rise_diff,rise_st_diff;

  int     rise_idx,fall_idx;
  rise_idx=0;
  fall_idx=0;
    
  //------ calculate rise/fall time ------//
  calc_time1_voh_vol=voh_time1-vol_time1; 
  calc_time2_voh_vol=voh_time2-vol_time2;   
  //------ separate rise/fall data ------//
  for(int_i=0; int_i<lcdpinno; int_i++)
  {
   if(calc_time1_voh_vol[int_i] > 0){
     calc_time_rise[int_i]=calc_time1_voh_vol[int_i];       
    calc_rise_start[int_i]=vol_time1[int_i];            

   }else{
     calc_time_fall[int_i]=calc_time1_voh_vol[int_i]*(-1);       
    calc_fall_start[int_i]=voh_time1[int_i];       
  
   }

   if(calc_time2_voh_vol[int_i] > 0){
     calc_time_rise[int_i]=calc_time2_voh_vol[int_i];       
    calc_rise_start[int_i]=vol_time2[int_i];            

   }else{
     calc_time_fall[int_i]=calc_time2_voh_vol[int_i]*(-1);       
    calc_fall_start[int_i]=voh_time2[int_i];       
  
   }

  }

  rise_max=ary_max(calc_time_rise);       
  fall_max=ary_max(calc_time_fall);      
  rise_min=ary_min(calc_time_rise);       
  fall_min=ary_min(calc_time_fall);      
                                            
  rise_st_max=ary_max(calc_rise_start);       
  rise_st_min=ary_min(calc_rise_start);   
  fall_st_max=ary_max(calc_fall_start);      
  fall_st_min=ary_min(calc_fall_start);


  rise_diff=rise_max-rise_min;
  fall_diff=fall_max-fall_min;
  
  rise_st_diff=rise_st_max-rise_st_min;
  fall_st_diff=fall_st_max-fall_st_min;
  int rise_max_pin=ary_imax(calc_time_rise)+1;
  int fall_max_pin=ary_imax(calc_time_fall)+1; 
 
  tno(sub_tno+11); cat(sub_cat); dcmnt(command+"_Slew Rate Falling (uS)");      judge(fall_max    *1000000 , 0.1 , 4 );
  tno(sub_tno+12); cat(sub_cat); dcmnt(command+"_Slew Rate Rising  (uS)");      judge(rise_max    *1000000 , 0.1 , 4 );
  tno(sub_tno+13); cat(sub_cat); dcmnt(command+"_Slew Rate Falling DEV(uS)");   judge(fall_diff     *1000000 , 0.0 , 0.85);
  tno(sub_tno+14); cat(sub_cat); dcmnt(command+"_Slew Rate Rising  DEV(uS)");   judge(rise_diff     *1000000 , 0.0 , 0.85);
  //tno(sub_tno+5); cat(sub_cat); dcmnt(command+"_Falling start point(uS)");     judge(fall_st_max *1000000 , 0.1 , 6.5 );
  //tno(sub_tno+6); cat(sub_cat); dcmnt(command+"_Rising start point(uS)");      judge(rise_st_max *1000000 , 0.1 , 6.5 );
  tno(sub_tno+17); cat(sub_cat); dcmnt(command+"_Falling start point DEV(nS)"); judge(fall_st_diff  *1000000000 , 0.0 , 75);
  tno(sub_tno+18); cat(sub_cat); dcmnt(command+"_Rising start point DEV(nS)"); judge(rise_st_diff  *1000000000 , 0.0 , 75); 

  tno(sub_tno+19); cat(sub_cat); dcmnt(command+"_Falling time (max) pin"); judge(fall_max_pin   , 0.0 , lcdpinno);
  tno(sub_tno+20); cat(sub_cat); dcmnt(command+"_Rising start (max) pin"); judge(rise_max_pin   , 0.0 , lcdpinno);  

}  

void SLEW_Get_data()
{
       
    prober.mGet_Axis(axis_x, axis_y);
    str_axis_x1 = (string)axis_x[0];
    str_axis_x2 = (string)axis_x[1];
    str_axis_y1 = (string)axis_y[0];
    str_axis_y2 = (string)axis_y[1];
    //if(axis_x[0]<0){ axis_x[0]=9; }
    //string str_test_chip=(string)ChipType[axis_x[0]];
  
    string path_rise;
    string path_fall;
    string path_rise_vol;
    string path_fall_vol;
    string path_rise_voh;
    string path_fall_voh;
    
    path_rise = datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"_rise_data.asc";
    path_fall = datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"_fall_data.asc";

    path_rise_vol = datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"_rise_vol_data.asc";
    path_fall_vol = datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"_fall_vol_data.asc";

    path_rise_voh = datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"_rise_voh_data.asc";
    path_fall_voh = datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"_fall_voh_data.asc";

ofstream x1(path_rise, ios::app);
    x1 << "X" << str_axis_x1 << "Y" << str_axis_y1 << " ";
    for(int_j=0;int_j<lcdpinno;int_j++){ x1 << rise_time[int_j] << " ";}
    x1 << rise_time_max_idx[0] << " "  << rise_time_min_idx[0] << "\n";

ofstream x2(path_fall, ios::app);
    x2 << "X" << str_axis_x1 << "Y" << str_axis_y1 << " ";
    for(int_j=0;int_j<lcdpinno;int_j++){ x2 << fall_time[int_j] << " ";}
    x2 << fall_time_max_idx[0] << " "  << fall_time_min_idx[0] << "\n";
    

ofstream x3(path_rise_vol, ios::app);
    x3 << "X" << str_axis_x1 << "Y" << str_axis_y1 << " ";
    for(int_j=0;int_j<lcdpinno;int_j++){ x3 << rise_vol_time[int_j] << " ";}
    x3 << rise_vol_time_max_idx[0] << " "  << rise_vol_time_min_idx[0] << "\n";

ofstream x4(path_rise_voh, ios::app);
    x4 << "X" << str_axis_x1 << "Y" << str_axis_y1 << " ";
    for(int_j=0;int_j<lcdpinno;int_j++){ x4 << rise_voh_time[int_j] << " ";}
    x4 << rise_voh_time_max_idx[0] << " "  << rise_voh_time_min_idx[0] << "\n";

ofstream x5(path_fall_voh, ios::app);
    x5 << "X" << str_axis_x1 << "Y" << str_axis_y1 << " ";
    for(int_j=0;int_j<lcdpinno;int_j++){ x5 << fall_voh_time[int_j] << " ";}
    x5 << fall_voh_time_max_idx[0] << " "  << fall_voh_time_min_idx[0] << "\n";

ofstream x6(path_fall_vol, ios::app);
    x6 << "X" << str_axis_x1 << "Y" << str_axis_y1 << " ";
    for(int_j=0;int_j<lcdpinno;int_j++){ x6 << fall_vol_time[int_j] << " ";}
    x6 << fall_vol_time_max_idx[0] << " "  << fall_vol_time_min_idx[0] << "\n";

}


