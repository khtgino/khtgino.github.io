    str_axis_x2 = (string)axis_x[1];
    str_axis_y1 = (string)axis_y[0];
    str_axis_y2 = (string)axis_y[1];


    ofstream x01(temp_file_path, ios::app); 
      x01 << "X " << str_axis_x1 << " Y " << str_axis_y1 << " ";
      for(int_j=0;int_j<tmp_ary_length;int_j++){ x01 << tmp_ary_data[int_j] << " ";}
      x01 << "\n";



};
void GS_Get_Func(string &tmp_dut_num , string &temp_file_path , ARRAY<double> &tmp_ary_data)
{
    int tmp_ary_length;
    
    tmp_ary_length=tmp_ary_data.len();

    prober.mGet_Axis(axis_x, axis_y);
    str_axis_x1 = (string)axis_x[0];
    str_axis_x2 = (string)axis_x[1];
    str_axis_y1 = (string)axis_y[0];
    str_axis_y2 = (string)axis_y[1];


    ofstream x01(temp_file_path, ios::app); 
      if( tmp_dut_num=="1" ){ x01 << "X " << str_axis_x1 << " Y " << str_axis_y1 << " "; }
      if( tmp_dut_num=="2" ){ x01 << "X " << str_axis_x2 << " Y " << str_axis_y2 << " "; }
      for(int_j=0;int_j<tmp_ary_length;int_j++){ x01 << tmp_ary_data[int_j] << " ";}
      x01 << "\n";



};

//=========================== No Use ==============================================================
void display_fail(int no,ARRAY <double> &result,ARRAY <double> &hidea,ARRAY <double> &lidea)
{
  print "Test ID :",no;
  for (int_i=0;int_i<lcdpinno;int_i++) if(result[int_i]<lidea[int_i]||result[int_i]>hidea[int_i])
  print "\nLCD ",int_i+1,":",result[int_i];
}

void TSTime(string tsitem)
{
  int str_len_num;
  int str_ii;

  str_len_num=tsitem.len();

  if (0!=(int_FunctionKey & 0x8000))
  {
    sec_TestTime = timer.get();
    print tsitem;
    for( str_ii=0 ; str_ii<= (60-str_len_num) ; str_ii+=1 )
     { print " "; }

   cout.width(8);
   cout<<" = "<<(sec_TestTime/1.0mS)<<"mS\n";
    //print tsitem," = ",sec_TestTime,"\n";
    timer.start();
    sec_TotalTime = sec_TotalTime + sec_TestTime;
  }
}

