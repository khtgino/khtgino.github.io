      for(int_j=0;int_j<levelno;int_j++){ x04 << max_neg_0101_d01_01[int_j] << " ";}
      x04 << flag[0] << "\n";

    ofstream x05(path_dev_vh_min, ios::app); 
      x05 << "X " << str_axis_x1 << " Y " << str_axis_y1 << " ";
      for(int_j=0;int_j<levelno;int_j++){ x05 << min_pos_0101_d01_01[int_j] << " ";}
      x05 << flag[0] << "\n";

    ofstream x06(path_dev_vl_min, ios::app); 
      x06 << "X " << str_axis_x1 << " Y " << str_axis_y1 << " ";
      for(int_j=0;int_j<levelno;int_j++){ x06 << min_neg_0101_d01_01[int_j] << " ";}
      x06 << flag[0] << "\n";


    ofstream x07(path_rms_avg, ios::app); 
      x07 << "X " << str_axis_x1 << " Y " << str_axis_y1 << " ";
      for(int_j=0;int_j<levelno;int_j++){ x07 << avg_rms_0101_d01_01[int_j] << " ";}
      x07 << flag[0] << "\n";

    ofstream x08(path_rms_max, ios::app); 
