  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 1600MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.5V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(2); edge(rate2*0,rate2*0.5); pin(DPIN_PAD_LOCK   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD_MV_1);
  rly=off; fmt=open; vih=     6.0V; vil=    0.0V;  pin(DPIN_PAD_TEST_SD_MV_2);

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppcp; rng=R10V; scan_mode=PIN_INC;scan_step=512; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 2.8V; lcdvol= -2.8V;
  lcdoption=NONE;
  lcdoption=LCDVT1;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================  
  ARRAY<string> func_pat_ary_01(32);
  ARRAY<string> func_pat_ary_02(32);

  func_pat_ary_01[0 ]="fn01_io_02_ch1446_dpsel_4p_bsel_0_shl_1_ds_1_1";
  func_pat_ary_01[1 ]="fn01_io_03_ch1446_dpsel_2p_bsel_1_shl_1_ds_1_1";
  func_pat_ary_01[2 ]="fn01_io_04_ch1446_dpsel_2p_bsel_0_shl_1_ds_1_1";
  func_pat_ary_01[3 ]="fn01_io_05_ch1446_dpsel_4p_bsel_1_shl_0_ds_0_1";
  func_pat_ary_01[4 ]="fn01_io_06_ch1446_dpsel_4p_bsel_0_shl_0_ds_0_1";
  func_pat_ary_01[5 ]="fn01_io_07_ch1446_dpsel_2p_bsel_1_shl_0_ds_0_1";
  func_pat_ary_01[6 ]="fn01_io_08_ch1446_dpsel_2p_bsel_0_shl_0_ds_0_1";
  func_pat_ary_01[7 ]="fn01_io_09_ch1446_dpsel_4p_bsel_1_shl_1_ds_0_1";
  func_pat_ary_01[8 ]="fn01_io_10_ch1446_dpsel_4p_bsel_0_shl_1_ds_0_1";
  func_pat_ary_01[9 ]="fn01_io_11_ch1446_dpsel_2p_bsel_1_shl_1_ds_0_1";
  func_pat_ary_01[10]="fn01_io_12_ch1446_dpsel_2p_bsel_0_shl_1_ds_0_1";
