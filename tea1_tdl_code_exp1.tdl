  gs0ff0_abs_result_01[0]=ary_mcmp(abs2_pos_0ff0_d01_01,DVABShlimit,DVABSllimit)+ary_mcmp(abs2_neg_0ff0_d01_01,DVABShlimit,DVABSllimit)+gs0ff0_abs_result_01[0];
  gs0ff0_rms_result_01[0]=ary_mcmp(rms_vh_0ff0_d01_01,DVRMShlimit,DVRMSllimit)+ary_mcmp(rms_vl_0ff0_d01_01,DVRMShlimit,DVRMSllimit);
  }
  //------ Dut-2 ------//
  if( (int_CurrentDut & 0x02) == 0x02 )
  {
  tmp_vh_result=ary_mcmp(dev_vh_0ff0_d02_01,dev_gs0101vh_hlimit_165V,dev_gs0101vh_llimit_165V);
  tmp_vl_result=ary_mcmp(dev_vl_0ff0_d02_01,dev_gs0101vl_hlimit_165V,dev_gs0101vl_llimit_165V);
  
