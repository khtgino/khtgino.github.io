HEADER.wafer(str_wafer_id);
HEADER.sublot(str_slot_name);
HEADER.name(__FILE__);
HEADER.Operator(releasedate);
HEADER.device(projectcode);
HEADER.interface("MiNow");
HEADER.comment(sysname);

datalogfile=datapath+str_wafer_id+"-MiNow-MiLiMP.log";
check_logfile=datapath;
int int_ijk=1;
int kkkkk;
fghjkjk=0;
QWEDSA=__TIME__;

h1=QWEDSA[0];
h0=QWEDSA[1];
m1=QWEDSA[3];
m0=QWEDSA[4];
s1=QWEDSA[6];
s0=QWEDSA[7];
if(h1==' ') h1='0';
if(m1==' ') m1='0';
if(s1==' ') s1='0';
log_time=(string)h1+(string)h0+(string)m1+(string)m0+(string)s1+(string)s0;
QWEDSA=__DATE__;

d1=QWEDSA[4];
d0=QWEDSA[5];
y3=QWEDSA[7];
y2=QWEDSA[8];
y1=QWEDSA[9];
y0=QWEDSA[10];
if (QWEDSA[0]=='J'&&QWEDSA[1]=='a'&&QWEDSA[2]=='n') fghjkjk=1;
if (QWEDSA[0]=='F'&&QWEDSA[1]=='e'&&QWEDSA[2]=='b') fghjkjk=2;
if (QWEDSA[0]=='M'&&QWEDSA[1]=='a'&&QWEDSA[2]=='r') fghjkjk=3;
if (QWEDSA[0]=='A'&&QWEDSA[1]=='p'&&QWEDSA[2]=='r') fghjkjk=4;
if (QWEDSA[0]=='M'&&QWEDSA[1]=='a'&&QWEDSA[2]=='y') fghjkjk=5;
if (QWEDSA[0]=='J'&&QWEDSA[1]=='u'&&QWEDSA[2]=='n') fghjkjk=6;
if (QWEDSA[0]=='J'&&QWEDSA[1]=='u'&&QWEDSA[2]=='l') fghjkjk=7;
if (QWEDSA[0]=='A'&&QWEDSA[1]=='u'&&QWEDSA[2]=='g') fghjkjk=8;
if (QWEDSA[0]=='S'&&QWEDSA[1]=='e'&&QWEDSA[2]=='p') fghjkjk=9;
if (QWEDSA[0]=='O'&&QWEDSA[1]=='c'&&QWEDSA[2]=='t') fghjkjk=10;
if (QWEDSA[0]=='N'&&QWEDSA[1]=='o'&&QWEDSA[2]=='v') fghjkjk=11;
if (QWEDSA[0]=='D'&&QWEDSA[1]=='e'&&QWEDSA[2]=='c') fghjkjk=12;
if(d1==' ') d1='0';

log_date=(string)y3+(string)y2+(string)y1+(string)y0+(string)fghjkjk+(string)d1+(string)d0;

ifstream datalogin(datalogfile);
datalogfile=datapath+str_wafer_id+"-"+projectcode+"-"+log_date+"-"+log_time+"-MP"+".log";
wafer_time_word=log_date+"-"+log_time;

do
{
	if(datalogin.is_open()==1)
{
	datalogfile=datapath+str_wafer_id+"-"+projectcode+"-"+log_date+"-"+log_time+"-"+(string)int_ijk+"-MP"+".log";
	//datalogfile=datapath+str_wafer_id+"-"+(string)int_ijk+"-MP.log";
	ifstream datalogin(datalogfile);
	kkkkk=datalogin.is_open();
}
int_ijk++;
}while(kkkkk==1);

	datalog.result(FAIL,PASS);
	datalog.type(DC,FT,AC);
	//datalog.id(5000,10000);
	datalog.format(DTLOG_LONG);
	datalog.pin_display(DTLOG_OBJ);
	datalog.ft_format(DTLOG_V_ALLPIN);
	//datalog.ft_type(DTLOG_CONTINUOUS_FAIL);
	datalog.ft_pinlist(ALL);
	datalog.category_sort(ON);
	datalog.waferXY(ON);
	datalog.output(datalogfile,"a");
	datalog.Enable();
	//datalog.Disable();
	datalog.Load();

	int_ijk--;
	HIDAR.init();
	HIDAR.Clear();
	HIDAR.stnNum(NONE);
	HIDAR.cond_path(".\\histogram\\"); 
	//HIDAR.cond_file("hidar_dc.asc");
	//HIDAR.cond_file(".\\histogram\\hidar_dc.asc");
	HIDAR.cond_file("hidar_auto.asc");
	HIDAR.out_dev(FILE);
  	//HIDAR.out_file(datapath+str_wafer_id+"-"+log_date+"-"+log_time+"_histogram.asc","a");
	HIDAR.out_file(datapath+str_wafer_id+"-"+(string)int_ijk+"_MiNow_histogram.asc","w");
	//HIDAR.out_file(str_wafer_id+".asc","w");
	HIDAR.out_report(HIDAR_HISTOGRAM);
	//HIDAR.cond_separate_dut(OFF);
	HIDAR.Load();
  	////HIDAR.out_file(datapath+str_wafer_id+"-"+log_date+"-"+log_time+"_histogram.asc","a");
	//HIDAR.out_file(datapath+str_wafer_id+"-"+(string)int_ijk+"_MiNow_histogram.asc","a");
	////HIDAR.out_file(str_wafer_id+".asc","w");
}

int read_data(ARRAY<string>& pii)
{
ifstream ifs("./data.txt");
int iii;
for (iii=0; iii<pii.len(); iii++) // Loops the number of pii elements
{
ifs.getline(pii[iii]); // Reads a line
if (ifs.rdstate() != ios::goodbit)
break; // Stops when an error occurs or at the EOF
}
return iii; // Returns the number of lines read
}
int temperature_ideal=100;
int temperature_gap=2;
  count=1;
  //ND4H_ChuckTempTiming=1;

  $if __TESTER_TYPE__ == 119 //for ND4
    GPIBDEV gpibdevice1("TSK_Prober", 0, 1);  //add 0x1 for prober
    gpibdevice1.open();  //open GPIB device
  $endif 
  
int temperature_func()
{
  int tt_CategoryNumber=99;
  
  int tmp_cur_dut=TESTDUT.Get_Dut(CURRENT);
  int_CategoryNumber=tt_CategoryNumber;
  ARRAY<double> ary_temperature_current(tmp_cur_dut);
  ARRAY<double> ary_temperature_setting(tmp_cur_dut);
  
  int tmpe_cunt1;
    
  //data write
  string gpib_write_data = "f\r\n";
  int size_mm = gpib_write_data.len();

  //data read
  string gpib_read_data;    
  //====== Setting prober device ======//

  //====== Get the temperature from Prober ======//
  $if __TESTER_TYPE__ == 119 //for ND4
    gpibdevice1.wrt(gpib_write_data, size_mm);
    size_mm = 11;
    gpibdevice1.rd(gpib_read_data, size_mm);
  $else
    AT_Prober_stn1.GPIBDEV::wrt( gpib_write_data, size_mm );
    AT_Prober_stn1.GPIBDEV::rd ( gpib_read_data, 256 ) ;
  $endif  
  
  string temperature_w1 = gpib_read_data.substr(1,4); // Prober Current Temperature
  string temperature_w2 = gpib_read_data.substr(5,4); // Prober Setting Temperature
  
  double temperature_current;
  double temperature_setting;
  
  if( gpib_read_data.substr(1,1) == "-" )
   { temperature_current=(int(gpib_read_data.substr(2,1))*10.0+int(gpib_read_data.substr(3,1))*1.0+int(gpib_read_data.substr(4,1))*0.1)*-1.0; }
   else
   { temperature_current=int(gpib_read_data.substr(1,1))*100.0+int(gpib_read_data.substr(2,1))*10.0+int(gpib_read_data.substr(3,1))*1.0+int(gpib_read_data.substr(4,1))*0.1; }
  if( gpib_read_data.substr(5,1) == "-" )
   { temperature_setting=(int(gpib_read_data.substr(6,1))*10.0+int(gpib_read_data.substr(7,1))*1.0+int(gpib_read_data.substr(8,1))*0.1)*-1.0; }
   else
   { temperature_setting=int(gpib_read_data.substr(5,1))*100.0+int(gpib_read_data.substr(6,1))*10.0+int(gpib_read_data.substr(7,1))*1.0+int(gpib_read_data.substr(8,1))*0.1; }

  JUDGE_LIMIT  judge_limit_tmp;
  JUDGE    judgedata_tmp;

  if( tmp_cur_dut>1 )
  {
    
  for(tmpe_cunt1=0 ; tmpe_cunt1<tmp_cur_dut ; tmpe_cunt1+=1 )
    { 
      ary_temperature_current[tmpe_cunt1]=temperature_current;
      ary_temperature_setting[tmpe_cunt1]=temperature_setting;    
    }
    
    
  TEST.id(8);
  TEST.desc("Cat("+string(tt_CategoryNumber)+") Prober Current Temperature Check, Spec:"+string(temperature_ideal)+"+/-"+string(temperature_gap));
  TEST.Set();
  judge_limit_tmp.upper(temperature_ideal+temperature_gap);
  judge_limit_tmp.lower(temperature_ideal-temperature_gap);
  
  judgedata_tmp.limit(judge_limit_tmp);
  judgedata_tmp.value(ary_temperature_current);
  judgedata_tmp.type(DC);
  judgedata_tmp.Exec();

  TEST.id(9);
  TEST.desc("Cat("+string(tt_CategoryNumber)+") Prober Setting Temperature Check, Spec:"+string(temperature_ideal)+"+/-"+string(temperature_gap));
  TEST.Set();
  judge_limit_tmp.upper(temperature_ideal+temperature_gap);
  judge_limit_tmp.lower(temperature_ideal-temperature_gap);
  
  judgedata_tmp.limit(judge_limit_tmp);
  judgedata_tmp.value(ary_temperature_setting);
  judgedata_tmp.type(DC);
  judgedata_tmp.Exec();   
  }
  else 
  {
  TEST.id(8);
  TEST.desc("Cat("+string(tt_CategoryNumber)+") Prober Current Temperature Check, Spec:"+string(temperature_ideal)+"+/-"+string(temperature_gap));
  TEST.Set();
  judge_limit_tmp.upper(temperature_ideal+temperature_gap);
  judge_limit_tmp.lower(temperature_ideal-temperature_gap);
  
  judgedata_tmp.limit(judge_limit_tmp);
  judgedata_tmp.value(temperature_current);
  judgedata_tmp.type(DC);
  judgedata_tmp.Exec();

  TEST.id(9);
  TEST.desc("Cat("+string(tt_CategoryNumber)+") Prober Setting Temperature Check, Spec:"+string(temperature_ideal)+"+/-"+string(temperature_gap));
  TEST.Set();
  judge_limit_tmp.upper(temperature_ideal+temperature_gap);
  judge_limit_tmp.lower(temperature_ideal-temperature_gap);
  
  judgedata_tmp.limit(judge_limit_tmp);
  judgedata_tmp.value(temperature_setting);
  judgedata_tmp.type(DC);
  judgedata_tmp.Exec();   
  }

//===========================================================================================
  TSTime("Temperature Check     ");

  return 0;
}

