  rma_pat_ary_01[5]="fn01a1_rma_ch1446_dpsel_4p_bsel_1_shl_1_ds_0_25_1003";
//================================================================================================  

  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  //POWER_ON_FUNC1();
  //wait(6.0mS);       

  for( int_i=0 ; int_i<6 ; int_i+=1 )
  { 

  tno(tmp_test_num+int_i); cat(17); dcmnt(rma_pat_ary_01[int_i]);

  if( (int_i%6)==0 ){ rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL); }
  if( (int_i%6)==1 ){ rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL); } 
  if( (int_i%6)==2 ){ rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL); } 
  if( (int_i%6)==3 ){ rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL); } 
  if( (int_i%6)==4 ){ rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL); } 
  if( (int_i%6)==5 ){ rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL); } 

  patf(func_pat_ary_02[int_i]+".lpa"); pat(run); calcstart(ALL_LCD , io_func_ary_02);

  if( (int_i%6)==0 ){ lcd_meas(rma_32_data_01_v, rma_32_ideal_01_max, rma_32_ideal_01_min); }
  if( (int_i%6)==1 ){ lcd_meas(rma_32_data_02_v, rma_32_ideal_02_max, rma_32_ideal_02_min); }
  if( (int_i%6)==2 ){ lcd_meas(rma_32_data_03_v, rma_32_ideal_03_max, rma_32_ideal_03_min); }
  if( (int_i%6)==3 ){ lcd_meas(rma_32_data_04_v, rma_32_ideal_04_max, rma_32_ideal_04_min); }
  if( (int_i%6)==4 ){ lcd_meas(rma_32_data_05_v, rma_32_ideal_05_max, rma_32_ideal_05_min); }
  if( (int_i%6)==5 ){ lcd_meas(rma_32_data_06_v, rma_32_ideal_06_max, rma_32_ideal_06_min); }

  wait(1.0mS);
  }
  TSTime("Normal IO Function Test(Dig) ");

  
  
//===========================================================================================
//===========================================================================================
  POWER_OFF_FUNC1();

  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("Normal IO Function Test(Dig) ");

  return 0;
}
int func_01_comp()
{
