//================================== variable setting ======================================
  freq  = 1600MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.5V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
