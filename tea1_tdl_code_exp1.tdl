}

void lcd_meas(ARRAY<double> &data1,ARRAY<double> &data2,ARRAY<double> &j_hlimit,ARRAY<double> &j_llimit)
{
  TEST.Set();

  judge_limit.upper(0.5);  judge_limit.lower(-0.5);
  multjudge[0]=ary_mcmp(data1,j_hlimit,j_llimit);
  multjudge[1]=ary_mcmp(data2,j_hlimit,j_llimit);
  judgedata.limit(judge_limit);
  judgedata.value(multjudge);
  judgedata.type(DC);
  judgedata.Exec();

}
void mask_pin(DPIN &a)
{
  compare_pin.pinlist(1,NOCARE,a);
  measure_ft.vector(vectorfile);
  measure_ft.reg(vectorreg);
  measure_ft.Set();
  compare_pin.Load();
  measure_ft.Exec();
  compare_pin.pinlist(1,CARE,a);
  compare_pin.Load();
}
void mask_pin(PINLIST &a)
{
  compare_pin.pinlist(1,NOCARE,a);
  measure_ft.vector(vectorfile);
  measure_ft.reg(vectorreg);
  measure_ft.Set();
  compare_pin.Load();
  measure_ft.Exec();
  compare_pin.pinlist(1,CARE,a);
  compare_pin.Load();
}
void mask_pin1(PINLIST &a,int &b)
{
  compare_pin.pinlist(1,NOCARE,a);
  measure_ft.vector(vectorfile);
  measure_ft.reg(vectorreg);
  measure_ft.Set();
  compare_pin.Load();
  measure_ft.dfm(dfm);
  measure_ft.Start();
  b=measure_ft.Get_Result(1);
  compare_pin.pinlist(1,CARE,a);
  compare_pin.Load();
}

void mask_pin(LCDPINLIST &a)
{
  vectorreg.STA(startadrn);
  vectorreg.SPA(stopadrn);
  vectorreg.Load();   
  compare_pin.pinlist(1,NOCARE,a);
  measure_ft.vector(vectorfile);
  measure_ft.reg(vectorreg);
  measure_ft.Set();
  compare_pin.Load();
  measure_ft.Exec();
  compare_pin.pinlist(1,CARE,a);
  compare_pin.Load();
}

void pjudge(int &a)
{
  if(a==result) 
  {
    if (fstop==off) TEST.pg(FAILINH);
    if (fstop==on) TEST.pg(NORMAL);
    TEST.Set();

    vectorreg.STA(startadrn);
    vectorreg.SPA(stopadrn);
    vectorreg.LIDX3(indx_3);
    vectorreg.LIDX4(indx_4);
    vectorreg.LIDX5(indx_5);
    vectorreg.LIDX6(indx_6);
    vectorreg.Load();

    dfm.type(DFM_FAILSTORE);
    dfm.begin(startadrn);
    dfm.end(stopadrn);
    dfm.fcnt(4095);
    dfm.Load();

    measure_ft.vector(vectorfile);
    measure_ft.reg(vectorreg);

    measure_ft.dfm(dfm);
    measure_ft.Set();
    measure_ft.Exec();
  }
    
}
void pjudge(int &a,int &b)
{
  if(a==result) 
  {
    if (fstop==off) TEST.pg(FAILINH);
    if (fstop==on) TEST.pg(NORMAL);
    TEST.Set();

    vectorreg.STA(startadrn);
    vectorreg.SPA(stopadrn);
    vectorreg.LIDX3(indx_3);
    vectorreg.LIDX4(indx_4);
    vectorreg.LIDX5(indx_5);
    vectorreg.LIDX6(indx_6);
    vectorreg.Load();

    measure_ft.vector(vectorfile);
    measure_ft.reg(vectorreg);
    measure_ft.Set();
    measure_ft.Exec();
    b=measure_ft.Get_Result(1);
  }
    
}
void pjudge(int &a,int &b,int &c)
{
  if(a==result) 
  {
    if (fstop==off) TEST.pg(FAILINH);
    if (fstop==on) TEST.pg(NORMAL);
    TEST.Set();

    vectorreg.STA(startadrn);
    vectorreg.SPA(stopadrn);
    vectorreg.LIDX3(indx_3);
    vectorreg.LIDX4(indx_4);
    vectorreg.LIDX5(indx_5);
    vectorreg.LIDX6(indx_6);
    vectorreg.Load();
    measure_ft.vector(vectorfile);
    measure_ft.reg(vectorreg);
    measure_ft.Set();
    measure_ft.Exec();
    b=measure_ft.Get_Result(1);
    c=measure_ft.Get_Result(2);
  }
    
}
