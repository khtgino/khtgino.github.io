//===========================  SET INDEX GS0101 =====================================================
  for(int_i=0;int_i<levelno;int_i++)
  {
    for(int_j=0;int_j<lcdpinno;int_j+=2)
    {

      //------ 0101 index ------
      pos_idx_gs0101[int_i*lcdpinno+ int_j  ]=          int_i   *lcdpinno+ int_j;
      pos_idx_gs0101[int_i*lcdpinno+ int_j+1]=(levelno+ int_i  )*lcdpinno+ int_j+1;

      neg_idx_gs0101[int_i*lcdpinno+ int_j  ]=(levelno+ int_i  )*lcdpinno+ int_j;
      neg_idx_gs0101[int_i*lcdpinno+ int_j+1]=          int_i   *lcdpinno+ int_j+1;
      //------ 0ff0 index ------  
      if( int_i<levelno/2 )
      {
      pos_idx_gs0ff0[           int_i *lcdpinno+ int_j  ]=(         int_i*2     )*lcdpinno+ int_j;
      pos_idx_gs0ff0[           int_i *lcdpinno+ int_j+1]=(levelno+ int_i*2 +1  )*lcdpinno+ int_j+1;

      pos_idx_gs0ff0[(levelno-1-int_i)*lcdpinno+ int_j  ]=(         int_i*2 +1  )*lcdpinno+ int_j;
      pos_idx_gs0ff0[(levelno-1-int_i)*lcdpinno+ int_j+1]=(levelno+ int_i*2     )*lcdpinno+ int_j+1;

      neg_idx_gs0ff0[           int_i *lcdpinno+ int_j  ]=(levelno+ int_i*2     )*lcdpinno+ int_j;
      neg_idx_gs0ff0[           int_i *lcdpinno+ int_j+1]=(         int_i*2 +1  )*lcdpinno+ int_j+1;

      neg_idx_gs0ff0[(levelno-1-int_i)*lcdpinno+ int_j  ]=(levelno+ int_i*2 +1  )*lcdpinno+ int_j;
      neg_idx_gs0ff0[(levelno-1-int_i)*lcdpinno+ int_j+1]=(         int_i*2     )*lcdpinno+ int_j+1;
      }
      //------ 0f0f index ------
      if( int_j%4<2 && int_i<levelno/2 )
      {
      pos_idx_gs0f0ff0f0[ int_i           *lcdpinno+ int_j+0]=                              int_i*2      *lcdpinno+ int_j;
      pos_idx_gs0f0ff0f0[ int_i           *lcdpinno+ int_j+1]=levelno*lcdpinno+             int_i*2      *lcdpinno+ int_j+1;

      pos_idx_gs0f0ff0f0[(int_i+levelno/2)*lcdpinno+ int_j+0]=                  (levelno-1- int_i*2     )*lcdpinno+ int_j;
      pos_idx_gs0f0ff0f0[(int_i+levelno/2)*lcdpinno+ int_j+1]=levelno*lcdpinno+ (levelno-1- int_i*2     )*lcdpinno+ int_j+1;

      neg_idx_gs0f0ff0f0[ int_i           *lcdpinno+ int_j+0]=levelno*lcdpinno+             int_i*2      *lcdpinno+ int_j;
      neg_idx_gs0f0ff0f0[ int_i           *lcdpinno+ int_j+1]=                              int_i*2      *lcdpinno+ int_j+1;

      neg_idx_gs0f0ff0f0[(int_i+levelno/2)*lcdpinno+ int_j+0]=levelno*lcdpinno+ (levelno-1- int_i*2     )*lcdpinno+ int_j;
      neg_idx_gs0f0ff0f0[(int_i+levelno/2)*lcdpinno+ int_j+1]=                  (levelno-1- int_i*2     )*lcdpinno+ int_j+1;
      }
      if( int_j%4>=2 && int_i<levelno/2 )
      {
      pos_idx_gs0f0ff0f0[ int_i           *lcdpinno+ int_j+0]=                  (           int_i*2 +1  )*lcdpinno+ int_j+0;
      pos_idx_gs0f0ff0f0[ int_i           *lcdpinno+ int_j+1]=levelno*lcdpinno+ (           int_i*2 +1  )*lcdpinno+ int_j+1;

      pos_idx_gs0f0ff0f0[(int_i+levelno/2)*lcdpinno+ int_j+0]=                  (levelno-1- int_i*2 -1  )*lcdpinno+ int_j+0;
      pos_idx_gs0f0ff0f0[(int_i+levelno/2)*lcdpinno+ int_j+1]=levelno*lcdpinno+ (levelno-1- int_i*2 -1  )*lcdpinno+ int_j+1;

      neg_idx_gs0f0ff0f0[ int_i           *lcdpinno+ int_j+0]=levelno*lcdpinno+ (           int_i*2 +1  )*lcdpinno+ int_j+0;
      neg_idx_gs0f0ff0f0[ int_i           *lcdpinno+ int_j+1]=                  (           int_i*2 +1  )*lcdpinno+ int_j+1;

      neg_idx_gs0f0ff0f0[(int_i+levelno/2)*lcdpinno+ int_j+0]=levelno*lcdpinno+ (levelno-1- int_i*2 -1  )*lcdpinno+ int_j+0;
      neg_idx_gs0f0ff0f0[(int_i+levelno/2)*lcdpinno+ int_j+1]=                  (levelno-1- int_i*2 -1  )*lcdpinno+ int_j+1;
      }
      //------ 0h0l index ------
      pos_idx_gs0h0l[int_i*lcdpinno+ int_j  ]=(int_i*2    )*lcdpinno+ int_j;
      pos_idx_gs0h0l[int_i*lcdpinno+ int_j+1]=(int_i*2+1  )*lcdpinno+ int_j+1;

      neg_idx_gs0h0l[int_i*lcdpinno+ int_j  ]=(int_i*2+1  )*lcdpinno+ int_j;
      neg_idx_gs0h0l[int_i*lcdpinno+ int_j+1]=(int_i*2    )*lcdpinno+ int_j+1;

      //------ 0101 chop dvoc index ------
      //------< New DVOC Index >------
      if( int_i%4==0 || int_i%4==3 )
      {
      chop_pos1_idx_gs0101[int_i*lcdpinno+ int_j  ]=          int_i   *lcdpinno+(0*256*966)+ int_j;
      chop_pos1_idx_gs0101[int_i*lcdpinno+ int_j+1]=(levelno+ int_i  )*lcdpinno+(2*256*966)+ int_j+1;
      
      chop_neg1_idx_gs0101[int_i*lcdpinno+ int_j  ]=(levelno+ int_i  )*lcdpinno+(0*256*966)+ int_j;
      chop_neg1_idx_gs0101[int_i*lcdpinno+ int_j+1]=          int_i   *lcdpinno+(2*256*966)+ int_j+1;
      
      chop_pos2_idx_gs0101[int_i*lcdpinno+ int_j  ]=          int_i   *lcdpinno+(2*256*966)+ int_j;
      chop_pos2_idx_gs0101[int_i*lcdpinno+ int_j+1]=(levelno+ int_i  )*lcdpinno+(0*256*966)+ int_j+1;
      
      chop_neg2_idx_gs0101[int_i*lcdpinno+ int_j  ]=(levelno+ int_i  )*lcdpinno+(2*256*966)+ int_j;
      chop_neg2_idx_gs0101[int_i*lcdpinno+ int_j+1]=          int_i   *lcdpinno+(0*256*966)+ int_j+1;
      }
      if( int_i%4==1 || int_i%4==2 )
      {
      chop_pos1_idx_gs0101[int_i*lcdpinno+ int_j  ]=          int_i   *lcdpinno+(2*256*966)+ int_j;
      chop_pos1_idx_gs0101[int_i*lcdpinno+ int_j+1]=(levelno+ int_i  )*lcdpinno+(0*256*966)+ int_j+1;
      
      chop_neg1_idx_gs0101[int_i*lcdpinno+ int_j  ]=(levelno+ int_i  )*lcdpinno+(2*256*966)+ int_j;
      chop_neg1_idx_gs0101[int_i*lcdpinno+ int_j+1]=          int_i   *lcdpinno+(0*256*966)+ int_j+1;
      
      chop_pos2_idx_gs0101[int_i*lcdpinno+ int_j  ]=          int_i   *lcdpinno+(0*256*966)+ int_j;
      chop_pos2_idx_gs0101[int_i*lcdpinno+ int_j+1]=(levelno+ int_i  )*lcdpinno+(2*256*966)+ int_j+1;
      
      chop_neg2_idx_gs0101[int_i*lcdpinno+ int_j  ]=(levelno+ int_i  )*lcdpinno+(0*256*966)+ int_j;
      chop_neg2_idx_gs0101[int_i*lcdpinno+ int_j+1]=          int_i   *lcdpinno+(2*256*966)+ int_j+1;
      }
      //------< Old DVOC Index >------
      //chop_pos1_idx_gs0101[int_i*lcdpinno+ int_j  ]=          int_i   *lcdpinno+(0*256*966)+ int_j;
      //chop_pos1_idx_gs0101[int_i*lcdpinno+ int_j+1]=(levelno+ int_i  )*lcdpinno+(0*256*966)+ int_j+1;
      //
      //chop_neg1_idx_gs0101[int_i*lcdpinno+ int_j  ]=(levelno+ int_i  )*lcdpinno+(0*256*966)+ int_j;
      //chop_neg1_idx_gs0101[int_i*lcdpinno+ int_j+1]=          int_i   *lcdpinno+(0*256*966)+ int_j+1;
      //
      //chop_pos2_idx_gs0101[int_i*lcdpinno+ int_j  ]=          int_i   *lcdpinno+(2*256*966)+ int_j;
      //chop_pos2_idx_gs0101[int_i*lcdpinno+ int_j+1]=(levelno+ int_i  )*lcdpinno+(2*256*966)+ int_j+1;
      //
      //chop_neg2_idx_gs0101[int_i*lcdpinno+ int_j  ]=(levelno+ int_i  )*lcdpinno+(2*256*966)+ int_j;
      //chop_neg2_idx_gs0101[int_i*lcdpinno+ int_j+1]=          int_i   *lcdpinno+(2*256*966)+ int_j+1;

    }
  }

  int_k=0;
  for(int_i=0;int_i<levelno*2;int_i++)
  {
    for(int_j=0;int_j<lcdpinno;int_j+=1)
     {
     	 if( (int_j%24)< 12  && (int_i%2)==0 ){ sp_idx_gs0f0f[int_k]=(int_i        )*lcdpinno+int_j; int_k+=1; }
     	 if( (int_j%24)>=12  && (int_i%2)==0 ){ sp_idx_gs0f0f[int_k]=(int_i+1)*lcdpinno+int_j; int_k+=1; }
     	 if( (int_j%24)< 12  && (int_i%2)==1 ){ sp_idx_gs0f0f[int_k]=(int_i        )*lcdpinno+int_j; int_k+=1; }
     	 if( (int_j%24)>=12  && (int_i%2)==1 ){ sp_idx_gs0f0f[int_k]=(int_i-1)*lcdpinno+int_j; int_k+=1; }
     }
  }
//===========================  SET INDEX GS SP1 =====================================================
