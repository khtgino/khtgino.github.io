        else if(cmd_char== "08"){ cmd_8bit="00001000";}
        else if(cmd_char== "09"){ cmd_8bit="00001001";}
        else if(cmd_char== "10"){ cmd_8bit="00001010";}
        else if(cmd_char== "11"){ cmd_8bit="00001011";}
        else if(cmd_char== "12"){ cmd_8bit="00001100";}
