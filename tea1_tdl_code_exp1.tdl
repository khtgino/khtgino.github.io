  patf("fn01a1_goa_num_12_ch1446_4p8b_shl_1_25_1008.lpa"); pat(run);  calcstart(GOA_O_GROUP_01 , goz_out_v12); //for( int_i=0 ; int_i<26*58 ; int_i+=1 ){ cout.width(8); cout<<goz_out_v12[int_i]<<",";  if( (int_i%26)==25){ cout<<"\n"; } }
