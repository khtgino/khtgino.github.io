void vprev()
{
		
		switch(__VP_REVISION__)
		{
		case 809170:
		case 809000:
		case 809001:
		case 809002:	print "VP_REVISION  :  R8.09\n\n\n";
				
				break;
		case 808000:
		case 808001:
		case 808002:	print "VP_REVISION  :  R8.08\n\n\n";
				
				break;
		case 807000:
		case 807001:
		case 807002:	print "VP_REVISION  :  R8.07\n\n\n";
				
				break;
		case 806000:
		case 806001:
		case 806002:	print "VP_REVISION  :  R8.06\n\n\n";
				
				break;
		case 802000:
		case 802001:
		case 802002:	print "VP_REVISION  :  R8.02\n\n\n";
				
				break;
		case 800000:
		case 800001:
		case 800002:	print "VP_REVISION  :  R8.00\n\n\n";
				
				break;
		default:break;
		}
}
Seconds ND1=10uS;
Seconds ND2=1uS;
Seconds NDx=ND1;

string vprevision;

vprevision=string(__VP_REVISION__);

//print "\n\n\tTC-Type  :  TC",__TC_TYPE__,"\n\tTESTER_TYPE  :  T6372 OR T6372L\n\tVP_REVISION  :  ",__VP_REVISION__,"\n\n\n";
switch(__TESTER_TYPE__)
{
	case 113: 
		if (__TC_TYPE__==106) print "\n\n\tTC-Type  :  TC6A\n\tTESTER_TYPE  :  T6372 OR T6372L\n\t";
				
		else {print "\n\n\tTC-Type  :  TC",__TC_TYPE__,"\n\tTESTER_TYPE  :  T6372 OR T6372L\n\t";}
		
		vprev();
		
		NDx=ND2;
				
		break;
	case 110: 
		if (__TC_TYPE__==106) print "\n\n\tTC-Type  :  TC6A\n\tTESTER_TYPE  :  T6371 \n\t";
				
		else {print "\n\n\tTC-Type  :  TC",__TC_TYPE__,"\n\tTESTER_TYPE  :  T6371 \n\t";}
		
		vprev();
		
		NDx=ND1;
		
		break;
	case 114: 
		if (__TC_TYPE__==106) print "\n\n\tTC-Type  :  TC6A\n\tTESTER_TYPE  :  T6362 OR T6362L\n\t";
				
		else {print "\n\n\tTC-Type  :  TC",__TC_TYPE__,"\n\tTESTER_TYPE  :  T6362 OR T6362L\n\t";}
				
		vprev();
		
		NDx=ND2;
		
		break;
	case 111:  
		if (__TC_TYPE__==106) print "\n\n\tTC-Type  :  TC6A\n\tTESTER_TYPE  :  T6361 \n\t";
				
		else {print "\n\n\tTC-Type  :  TC",__TC_TYPE__,"\n\tTESTER_TYPE  :  T6361 \n\t";}
				
		vprev();
		
		NDx=ND1;
		
		break;
	case 115:
		if (__TC_TYPE__==106) print "\n\n\tTC-Type  :  TC6A\n\tTESTER_TYPE  :  T6332 \n\t";
				
		else {print "\n\n\tTC-Type  :  TC",__TC_TYPE__,"\n\tTESTER_TYPE  :  T6332 \n\t";}
				
		vprev();
		
		NDx=ND2;
	
		break;
	case 112: 
		if (__TC_TYPE__==106) print "\n\n\tTC-Type  :  TC6A\n\tTESTER_TYPE  :  T6331 \n\t";
				
		else {print "\n\n\tTC-Type  :  TC",__TC_TYPE__,"\n\tTESTER_TYPE  :  T6331 \n\t";}
				
		vprev();
		
		NDx=ND1;
	
		break;
	case 410: 
		if (__TC_TYPE__==106) print "\n\n\tTC-Type  :  TC6A\n\tTESTER_TYPE  :  T6371 \n\t";
				
		else {print "\n\n\tTC-Type  :  TC",__TC_TYPE__,"\n\tTESTER_TYPE  :  T6371 \n\t";}
		
	
		vprev();
	
		NDx=ND1;
	
		break;
	
	default:break;
}
