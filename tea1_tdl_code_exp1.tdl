  tno(tmp_test_num++); cat(70); dcmnt("TOUCH ADC SDMCP-GRID_L1 Freq");  judge( 1/(OSC_P2*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  tno(tmp_test_num++); cat(70); dcmnt("TOUCH ADC SDMCP-GRID_L2 Freq");  judge( 1/(OSC_P1*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  tno(tmp_test_num++); cat(70); dcmnt("TOUCH ADC SDMCP-GRID_R  Freq");  judge( 1/(OSC_P2*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  tno(tmp_test_num++); cat(70); dcmnt("TOUCH ADC SDMCP-GRID_R1 Freq");  judge( 1/(OSC_P1*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  tno(tmp_test_num++); cat(70); dcmnt("TOUCH ADC SDMCP-GRID_R2 Freq");  judge( 1/(OSC_P2*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );


//===========================================================================================   

  dfm.type(DFM_FAILSTORE);
  dfm.begin(0);
  dfm.end(0x3ffffdf);
  dfm.fcnt(4095);
  dfm.Load();
  
  pat(stop);
  //sr(off);
