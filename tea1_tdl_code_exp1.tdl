  voh_in[2]  = (shm_dvdd)*0.7;
  vol_in[2]  = (shm_dvdd)*0.3;

  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS); 
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

  rly=dir; vi=vfim; v=shm_dvdd; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
  rly=dir; vi=vfim; v=shm_dvdd; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);
  rly=dir; vi=vfim; v= 6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_PAVDD   );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH1    );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH2    );
  rly=dir; vi=vfim; v=-6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_NAVDD   );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_LVGL    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGL     );


//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_LOCK   );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_TEST_DP_SEL   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD_MV_1);
  rly=off; fmt=open; vih=     6.0V; vil=    0.0V;  pin(DPIN_PAD_TEST_SD_MV_2);

  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  //rly=dir; fmt=fixh; vih=2.2V; vil=vil_in[2]; pin(DPIN_PAD_CNT_L     );

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_EN);
  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_12);
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_11);
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_10);
  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_09);
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_08);
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO; strb=rate1*0.25; strt=rate1*0.75; t(1); edge(rate1*0,rate1*0.5); pin(DPIN_ALL_TEST_DIP_O);

  if( shm_n03==16 )
    {
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_EN);
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_12);
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_11);
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_10);
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_09);
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_08);
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_ALL_TEST_DIP_O   );
  } 
  if( shm_n06==0 ){  }
  if( shm_n06==1 ){ rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_I_02); pin(DPIN_PAD_TEST_DIP_I_03); }
  
//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=512; ravg=1;
  ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;
  //lcdoption=NONE;
  lcdoption=LCDVT1;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);
  if( test_chip_num==101 ){ lcdpin(ALL_LCD);    }
  if( test_chip_num==102 ){ lcdpin(ALL_LCD);    }
  if( test_chip_num==103 ){ lcdpin(ALL_LCD);    }

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

  mode=ppcp;

//================================================================================================  
  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();
  wait(7.0mS);

  tno(tmp_test_num++); cat(17); TSTime("gst_hrd_2Pair_dvoc_pat_run");
                     
  if( shm_n03== 1 ){ patf("fn01a1_0101_ch1446_dpsel_4p_8b_shl_1_int_stb_1_reg_dpsel_en_1_25_0925.lpa"); }
  if( shm_n03== 2 ){ patf("fn01a1_0101_ch1446_dpsel_4p_8b_shl_0_int_stb_1_reg_dpsel_en_1_25_0925.lpa"); }
  if( shm_n03== 3 ){ patf("fn01a1_0101_ch1446_dpsel_2p_8b_shl_1_int_stb_1_reg_dpsel_en_1_25_0925.lpa"); }
  if( shm_n03== 4 ){ patf("fn01a1_0101_ch1446_dpsel_2p_8b_shl_0_int_stb_1_reg_dpsel_en_1_25_0925.lpa"); }

  if( shm_n03==10 ){ patf("fn01_0101_ch1446_dpsel_2p_8b_shl_1_int_stb_0_reg_dpsel_en_1_25_1105.lpa"); }                      
  if( shm_n03==11 ){ patf("fn01_0101_ch1446_dpsel_4p_8b_shl_1_int_stb_0_reg_dpsel_en_1_25_1105_2.lpa"); }
  if( shm_n03==12 ){ patf("fn01a1_0101_ch1446_dpsel_4p_8b_shl_0_int_stb_1_reg_dpsel_en_1_25_0925_te.lpa"); }
  if( shm_n03==13 ){ patf("fn01a1_0101_ch1446_dpsel_2p_8b_shl_1_int_stb_1_reg_dpsel_en_1_25_0925_te.lpa"); }
  if( shm_n03==14 ){ patf("fn01a1_0101_ch1446_dpsel_2p_8b_shl_0_int_stb_1_reg_dpsel_en_1_25_0925_te2.lpa"); }
  if( shm_n03==15 ){ patf("fn01_0101_ch1446_dpsel_4p_8b_shl_1_int_stb_1_reg_dpsel_en_0_25_1031_2_te2.lpa"); }
  if( shm_n03==16 ){ patf("fn01a1_0101_ch1446_dpsel_4p_8b_shl_1_int_stb_1_reg_dpsel_en_1_25_0925_te2.lpa"); }                      
   
  mode=ppdz;

  //pat(run);
  pat_mdgt_ft(run,pat_result);
  calcstart(gs0101_pinc_d01_02);

  if( shm_n03==1 || shm_n03==16 ){ dev_vh_0101_d01_01=dev_vl_0101_d01_02; dev_vl_0101_d01_01=dev_vh_0101_d01_02; }
  if( shm_n03==2 ){ dev_vh_0101_d01_01=dev_vl_0101_d01_02; dev_vl_0101_d01_01=dev_vh_0101_d01_02; }
  if( shm_n03==3 || shm_n03==10 || shm_n03==11 ){ dev_vh_0101_d01_01=dev_vh_0101_d01_02; dev_vl_0101_d01_01=dev_vl_0101_d01_02; }
  if( shm_n03==4 ){ dev_vh_0101_d01_01=dev_vh_0101_d01_02; dev_vl_0101_d01_01=dev_vl_0101_d01_02; }

  pos_tmp_result_01[0]=ary_mcmp(dev_vh_0101_d01_01,dev_gs0101vh_hlimit_165V,dev_gs0101vh_llimit_165V,fail_d01_point1);
  neg_tmp_result_01[0]=ary_mcmp(dev_vl_0101_d01_01,dev_gs0101vl_hlimit_165V,dev_gs0101vl_llimit_165V,fail_d01_point2);
  ee_ck01=pos_tmp_result_01[0]+neg_tmp_result_01[0];

  if( ee_ck01==0 && pat_result==0 && ee_ck02!=0 ){ print "P"; vdd_tmp_02=shm_n01*0.01V;             }
  if( ee_ck01==0 && pat_result==0 && ee_ck02==0 ){ print "P"; vdd_tmp_01=shm_n01*0.01V; ee_ck02=1;  }
  if( ee_ck01!=0 && pat_result==0               ){ print "X";                             } 
  if( ee_ck01==0 && pat_result!=0               ){ print "-";                             } 
  if( ee_ck01!=0 && pat_result!=0               ){ print ".";                             } 

  if( ee_ck01!=0 ){ ee_ck03=ee_ck03+1; }
  if( ee_ck03==1 ){ Plot_WS(dev_vh_0101_d01_01,"POS_"+string(shm_n01*0.01V)+"_"+string(shm_n02*100MHz)); Plot_WS(dev_vl_0101_d01_01,"NEG_"+string(shm_n01*0.01V)+"_"+string(shm_n02*100MHz)); }
  pat(stop);

  }
  if( ee_ck02==0 ){ print " ALL FAIL\n"; }
  if( ee_ck02!=0 ){ cout.width(7); cout<<" Pass vdd :"<<vdd_tmp_01<<"~"; cout.width(7); cout<<vdd_tmp_02<<"\n"; }
  }

  print "           +-----------------------+     \n";
  print "          2.40V                   1.20V\n\n";
  }}}}}
  
//===========================================================================================
//===========================================================================================

  //sr(off);
  POWER_OFF_FUNC1();

  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("GS_HRD 1 & 2-Pair Pattern Run                ");

  return 0;
}

