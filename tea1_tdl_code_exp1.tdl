void POWER_ON_FUNC1()
{
  //sequence.punit( 1,0.5mS, VS_DVDD            ); v= 1.8V; 
  //sequence.punit( 2,0.5mS, VS_DVDD_CDR        ); v= 1.8V; 
  //sequence.punit( 3,1.0mS, VS_PAVDD           ); v= 6.0V; 
  //sequence.punit( 4,1.0mS, VS_VGH1            ); v= 6.0V; 
  //sequence.punit( 5,1.0mS, VS_VGH2            ); v= 6.0V; 
  //sequence.punit( 6,1.5mS, VS_NAVDD           ); v=-6.0V; 
  //sequence.punit( 7,1.5mS, VS_LVGL            ); v=-6.0V; 
  //sequence.punit( 8,1.5mS, VS_VGL             ); v=-6.0V; 
	sr(on);

  rly=dir; vi=vfim; v=-1.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_VCOM_ALL );

  rvs_vs.SRng(R20V); rvs_vs.MRng(M10MA);
  rvs_vs.rvspin(RVS_PAD_TX_H  ); rvs_vs.SVal(   4.0V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_TX_L  ); rvs_vs.SVal(   0.9V); rvs_vs.Load();
  rvsunit_relay.rvspin(RVS_TX_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();
  
  wait(1mS);
  rvs_vs.rvspin( RVS_PAD_VGMAL1); rvs_vs.SVal(   5.8V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAL7); rvs_vs.SVal(   0.2V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAL8); rvs_vs.SVal(  -0.2V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_VGMAL14); rvs_vs.SVal(  -5.8V); rvs_vs.Load();

  rvs_vs.rvspin( RVS_PAD_VGMAR1); rvs_vs.SVal(   5.8V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAR7); rvs_vs.SVal(   0.2V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAR8); rvs_vs.SVal(  -0.2V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_VGMAR14); rvs_vs.SVal(  -5.8V); rvs_vs.Load();

  rvsunit_relay.rvspin(RVS_GMA_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();

  wait(1mS);

  rly=dir; vi=vfim; v= 21.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH1    );
  rly=dir; vi=vfim; v= 22.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH2    );
  rly=dir; vi=vfim; v=-10.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_LVGL    );
  rly=dir; vi=vfim; v= -9.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGL     );
 
  wait(1mS); 	
}

void POWER_OFF_FUNC1()
{

  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH1    );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH2    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_LVGL    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGL     );

  wait(2.0mS);

  rvs_vs.SRng(R20V); rvs_vs.MRng(M10MA);
  
  rvs_vs.rvspin( RVS_PAD_VGMAL1); rvs_vs.SVal(   0.0V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAL7); rvs_vs.SVal(   0.0V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAL8); rvs_vs.SVal(   0.0V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_VGMAL14); rvs_vs.SVal(   0.0V); rvs_vs.Load();

  rvs_vs.rvspin( RVS_PAD_VGMAR1); rvs_vs.SVal(   0.0V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAR7); rvs_vs.SVal(   0.0V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAR8); rvs_vs.SVal(   0.0V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_VGMAR14); rvs_vs.SVal(   0.0V); rvs_vs.Load();

  rvsunit_relay.rvspin(RVS_GMA_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();

  wait(2mS);

  rvs_vs.SRng(R20V); rvs_vs.MRng(M10MA);
  rvs_vs.rvspin(RVS_PAD_TX_H  ); rvs_vs.SVal(   0.0V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_TX_L  ); rvs_vs.SVal(   0.0V); rvs_vs.Load();
  rvsunit_relay.rvspin(RVS_TX_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();

  rly=dir; vi=vfim; v=0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_VCOM_ALL );
 
  wait(2mS);

  rly=dir; vi=vfim; v= 0.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_PAVDD   );
  rly=dir; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH1    );
  rly=dir; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH2    );
  rly=dir; vi=vfim; v=-0.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_NAVDD   );
  rly=dir; vi=vfim; v=-0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_LVGL    );
  rly=dir; vi=vfim; v=-0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGL     );
  wait(1mS);
  rly=dir; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
  rly=dir; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);

  sr(off); 	
  //sequence.punit( 1,0.5mS, VS_DVDD            ); v= 0.0V; 
  //sequence.punit( 2,0.5mS, VS_DVDD_CDR        ); v= 0.0V; 
  //sequence.punit( 3,1.0mS, VS_PAVDD           ); v= 0.0V; 
  //sequence.punit( 4,1.0mS, VS_VGH1            ); v= 0.0V; 
  //sequence.punit( 5,1.0mS, VS_VGH2            ); v= 0.0V; 
  //sequence.punit( 6,1.5mS, VS_NAVDD           ); v=-0.0V; 
  //sequence.punit( 7,1.5mS, VS_LVGL            ); v=-0.0V; 
  //sequence.punit( 8,1.5mS, VS_VGL             ); v=-0.0V; 
}

void POWER_ON_FUNC2()
{
  rly=dir; vi=vfim; v= 1.8V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
  rly=dir; vi=vfim; v= 1.8V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);
  rly=dir; vi=vfim; v= 6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_PAVDD   );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH1    );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH2    );
  rly=dir; vi=vfim; v=-6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_NAVDD   );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_LVGL    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGL     );
  
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAL14   );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAR14   );

