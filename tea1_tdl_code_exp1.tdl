void dpsvm_judge(Volts &b, Volts &c ,Seconds &tmp_wtime )
{
  TEST.Set();
  vm_limit.upper(c);
  vm_limit.lower(b);
  vm_limit.Load();

  measure_dpsvm.isvm(dpsisvm);
  measure_dpsvm.limit(vm_limit);
  measure_dpsvm.Set();
  sequence.PreExec();
  measure_dpsvm.Start();   waittime.time(tmp_wtime); waittime.PreExec();//for ND4 im_seq bug,20160427
  measure_dpsvm.Exec();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
  sequence.PostExec();

}

void lcdpin(LCDPIN &lcdpin)
{
  chkind=lcdpinkind;
  
  signallcd.lcdpin(lcdpin);
  lcdpsel_vtil.vrng(rng);
  lcdpsel_vtil.lcdvt(1,vt1);
  lcdpsel_vtil.lcdvt(2,vt2);
  lcdpsel_vtil.lcdilh(ioh);
  lcdpsel_vtil.lcdill(iol);
  if (lcdrly==off)
  {
    signallcd.kind(OPEN);
    signallcd.voh(lcdvoh);
    signallcd.vol(lcdvol);
    if(lcdoption!=NONE) signallcd.option(LCDIL,lcdoption);
    else signallcd.option(lcdoption);
    lcdpsel_vtil.Load();
    signallcd.Load();
    measure_im.pinlist(lcdpin);
    measure_vm.pinlist(lcdpin);
  }
  else
  {
    switch (mode)
    {
      case dirpmu:
        sigdclcd.lcdpin(lcdpin);
        sigdclcd.dc(HVDC);
        sigdclcd.Load();
        if(vi==ifvm)
        {
          isvm.Resc(HVDC);
          isvm.SRng(irng);
          isvm.MRng(vrng);
          isvm.SVal(i);
          isvm.CPVal(v);
          isvm.CMVal(v*-1);
          isvm.Load();
        
          measure_vm.pinlist(lcdpin);
        }
        else
        {
          vsim.Resc(HVDC);
          vsim.MRng(irng);
          vsim.SRng(vrng);
          vsim.SVal(v);
          vsim.CPVal(i);
          vsim.CMVal(i*-1);
            vsim.Load();
          
            measure_im.pinlist(lcdpin);
        }
        break;
      case ppdz:
    
        aqmdata.pin(lcdpin);
    
        lcdpsel_vtil.input(MDGT);
        signallcd.kind(OUT);
      
        signallcd.voh(lcdvoh);
        signallcd.vol(lcdvol);
        lcdsamp.samp(1,lcddigit1);
        lcdsamp.samp(2,lcddigit2);
        lcdsamp.samp(3,lcddigit3);
        lcdsamp.samp(4,lcddigit4);
        lcdsamp.Load();
        smux.scan(scan_mode);
        smux.step(scan_step);
        smux.scan_idx(LIDX1);
        smux.avrg(ravg);
        smux.avrg_idx(LIDX2);
        if(lcdoption!=NONE) signallcd.option(LCDIL,lcdoption);
        else signallcd.option(lcdoption);
        lcdpsel_vtil.Load();
        signallcd.Load();
        mdgt_samp.lcdpin(lcdpin);
        mdgt_samp.smux(smux);
        mdgt_samp.timeout(tout);
        mdgt_samp.Set();
        
        measindx=1;
        break;
        
      case ppcp:
        
        lcdpsel_vtil.input(FT);
        signallcd.kind(OUT);
              
        signallcd.voh(lcdvoh);
        signallcd.vol(lcdvol);
        lcdpsel_vtil.Load();
        lcdstrb.strb(1,lcdstrb1);
        lcdstrb.strb(2,lcdstrb2);
        lcdstrb.strb(3,lcdstrb3);
        lcdstrb.strb(4,lcdstrb4);
        lcdstrb.option(lcdstrboption);
        lcdstrb.Load();
        if(lcdoption!=NONE) signallcd.option(LCDIL,lcdoption);
        else signallcd.option(lcdoption);
        lcdpsel_vtil.Load();
        signallcd.Load();
        measindx=0;
        break;
      default:  //pmu
    
        signallcd.kind(OPEN);
        signallcd.voh(lcdvoh);
        signallcd.vol(lcdvol);
        if(lcdoption!=NONE) signallcd.option(LCDIL,lcdoption);
        else signallcd.option(lcdoption);
        lcdpsel_vtil.Load();
        signallcd.Load();
        measure_im.pinlist(lcdpin);
        measure_vm.pinlist(lcdpin);
        break;
    }  
  }
}
void lcdpin(LCDPINLIST &lcdpinlist)
{
  chkind=lcdpinkind;
  measure_im.pinlist(lcdpinlist);
  measure_vm.pinlist(lcdpinlist);
  signallcd.lcdpin(lcdpinlist);
  lcdpsel_vtil.vrng(rng);
  lcdpsel_vtil.lcdvt(1,vt1);
  lcdpsel_vtil.lcdvt(2,vt2);
  lcdpsel_vtil.lcdilh(ioh);
  lcdpsel_vtil.lcdill(iol);
  if (lcdrly==off)
  {
    signallcd.kind(OPEN);
    signallcd.voh(lcdvoh);
    signallcd.vol(lcdvol);
    if(lcdoption!=NONE) signallcd.option(LCDIL,lcdoption);
    else signallcd.option(lcdoption);
    lcdpsel_vtil.Load();
    lcdstrb.strb(1,lcdstrb1);
    lcdstrb.strb(2,lcdstrb2);
    lcdstrb.strb(3,lcdstrb3);
    lcdstrb.strb(4,lcdstrb4);
    lcdstrb.option(lcdstrboption);
    lcdstrb.Load();
    signallcd.Load();
    measure_im.pinlist(lcdpinlist);
    measure_vm.pinlist(lcdpinlist);
  }
  else
  {
    switch (mode)
    {
      case dirpmu:
        sigdclcd.lcdpin(lcdpinlist);
        sigdclcd.dc(HVDC);
        sigdclcd.Load();
        if(vi==ifvm)
        {
          isvm.Resc(HVDC);
          isvm.SRng(irng);
          isvm.MRng(vrng);
          isvm.SVal(i);
          isvm.CPVal(v);
          isvm.CMVal(v*-1);
          isvm.Load();
        
          measure_vm.pinlist(lcdpinlist);
        }
        else
        {
          vsim.Resc(HVDC);
          vsim.MRng(irng);
          vsim.SRng(vrng);
          vsim.SVal(v);
          vsim.CPVal(i);
          vsim.CMVal(i*-1);
            vsim.Load();
          
            measure_im.pinlist(lcdpinlist);
        }
        break;
      case ppdz:
    
        aqmdata.pin(lcdpinlist);
    
        lcdpsel_vtil.input(MDGT);
        signallcd.kind(OUT);
      
        signallcd.voh(lcdvoh);
        signallcd.vol(lcdvol);
        lcdsamp.samp(1,lcddigit1);
        lcdsamp.samp(2,lcddigit2);
        lcdsamp.samp(3,lcddigit3);
        lcdsamp.samp(4,lcddigit4);
        lcdsamp.Load();
        smux.scan(scan_mode);
        smux.step(scan_step);
        smux.scan_idx(LIDX1);
        smux.avrg(ravg);
        smux.avrg_idx(LIDX2);
        if(lcdoption!=NONE) signallcd.option(LCDIL,lcdoption);
        else signallcd.option(lcdoption);
        lcdpsel_vtil.Load();
        signallcd.Load();
        mdgt_samp.lcdpin(lcdpinlist);
        mdgt_samp.smux(smux);
        mdgt_samp.timeout(tout);
        mdgt_samp.Set();
        
        measindx=1;
        break;
        
      case ppcp:
        
        lcdpsel_vtil.input(FT);
        signallcd.kind(OUT);
              
        signallcd.voh(lcdvoh);
        signallcd.vol(lcdvol);
        lcdpsel_vtil.Load();
        lcdstrb.strb(1,lcdstrb1);
        lcdstrb.strb(2,lcdstrb2);
        lcdstrb.strb(3,lcdstrb3);
        lcdstrb.strb(4,lcdstrb4);
        lcdstrb.option(lcdstrboption);
        lcdstrb.Load();
        if(lcdoption!=NONE) signallcd.option(LCDIL,lcdoption);
        else signallcd.option(lcdoption);
        lcdpsel_vtil.Load();
        signallcd.Load();
        measindx=0;
        break;
      default:  //pmu
    
        signallcd.kind(OPEN);
        signallcd.voh(lcdvoh);
        signallcd.vol(lcdvol);
        if(lcdoption!=NONE) signallcd.option(LCDIL,lcdoption);
        else signallcd.option(lcdoption);
        lcdpsel_vtil.Load();
        signallcd.Load();
        measure_im.pinlist(lcdpinlist);
        measure_vm.pinlist(lcdpinlist);
        break;
    }  
  }
}
