void power_im_judge(int &a, Amperes &b, Amperes &c ,VSPIN &tmp_vs_p)
{
  int tmp_ii;
  Amperes tmp_i_val;
  
  TEST.Set();
  im_limit.upper(c);
  im_limit.lower(b);
  im_limit.Load(); 
  measure_dpsim.vsim(dpsvsim);
  measure_dpsim.limit(im_limit);
  measure_dpsim.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
  
  for( tmp_ii=0; tmp_ii<=a ; tmp_ii+=1 )
  {
   measure_dpsim.Start();
   //cout<<" I="<<measure_dpsim.Get_PinVal(1,tmp_vs_p)<<"\n";
   if( tmp_ii>0 )
    { tmp_i_val=tmp_i_val+measure_dpsim.Get_PinVal(1,tmp_vs_p)/a; }
  }
  
  judge_limit.upper(c);
  judge_limit.lower(b);
  
  judgedata.limit(judge_limit);
  judgedata.value(tmp_i_val);
  judgedata.type(DC);
  judgedata.Exec();
  
}

void alarm_func_off()
{
  ALARM alarm_all_off;
  
  alarm_all_off.clamp(ALARM_FAIL);
  alarm_all_off.guard(ALARM_FAIL);
  alarm_all_off.kelvin(ALARM_FAIL);
  alarm_all_off.limiter(ALARM_FAIL);
  alarm_all_off.osc(ALARM_FAIL);
  alarm_all_off.pbutlps(ALARM_FAIL);
 
  alarm_all_off.pbvcc(ALARM_FAIL);
  alarm_all_off.pbvee(ALARM_FAIL);
  
  //alarm_all_off.dcload(ALARM_FAIL);
  //alarm_all_off.pbsafe(ALARM_FAIL);
  //alarm_all_off.over_voltage(ALARM_FAIL);
  
  alarm_all_off.Load();
}
void alarm_func_on()
{
  ALARM alarm_all_on;
  
  alarm_all_on.clamp(ALARM_RTE);
  alarm_all_on.guard(ALARM_RTE);
  alarm_all_on.osc(ALARM_RTE);
  alarm_all_on.kelvin(ALARM_RTE);
  alarm_all_on.limiter(ALARM_RTE);
  
  alarm_all_on.pbvcc(ALARM_RTE);
  alarm_all_on.pbvee(ALARM_RTE);
  alarm_all_on.pbutlps(ALARM_RTE);
  
  //alarm_all_on.dcload(ALARM_RTE);
  //alarm_all_on.pbsafe(ALARM_RTE);
  //alarm_all_on.over_voltage(ALARM_RTE);
  
  alarm_all_on.Load();
}
//=========================== GS Code Define ======================================================
ARRAY<Volts>  ideal_positive_float(levelno);
ARRAY<Volts>  ideal_negative_float(levelno);    

ARRAY<Volts>  ideal_positive_0101_sp1(levelno);
ARRAY<Volts>  ideal_negative_0101_sp1(levelno);

ARRAY<Volts>  ideal_positive_0h0l_sp1(levelno);
ARRAY<Volts>  ideal_negative_0h0l_sp1(levelno);

ARRAY<double>  douArray_gamma_positive_float(levelno);
ARRAY<double>  douArray_gamma_negative_float(levelno);

ARRAY<double>  douArray_gamma_positive_hlimit(levelno); 
ARRAY<double>  douArray_gamma_positive_llimit(levelno); 
ARRAY<double>  douArray_gamma_negative_hlimit(levelno); 
ARRAY<double>  douArray_gamma_negative_llimit(levelno); 


void Deviation(Volts &avdd)
{
  
  gamma[ 1]= avdd-0.2V;
  gamma[ 7]= +0.2V;
  gamma[ 8]= -0.2V;
  gamma[14]= (avdd-0.2V)*-1.0;

  ideal_positive_float[0  ]=(-0.03274334 )*(gamma[ 1]-gamma[ 7])+gamma[ 7];
  ideal_positive_float[1  ]=(0.11262743  )*(gamma[ 1]-gamma[ 7])+gamma[ 7];
  ideal_positive_float[2  ]=(0.13586719  )*(gamma[ 1]-gamma[ 7])+gamma[ 7];
  ideal_positive_float[3  ]=(0.15119214  )*(gamma[ 1]-gamma[ 7])+gamma[ 7];
  ideal_positive_float[4  ]=(0.16354078  )*(gamma[ 1]-gamma[ 7])+gamma[ 7];
