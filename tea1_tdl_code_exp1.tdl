void freq_get_val( double &freq_01,DPIN &p1)
{
  Hertz tmp_ff;
  tmp_ff=measure_freq.Get_PinVal(1,p1);
  freq_01=tmp_ff/1.0MHz;
}
void freq_get_val( double &freq_01,DPIN &p1, double &freq_02,DPIN &p2)
{
  Hertz tmp_ff;
  tmp_ff=measure_freq.Get_PinVal(1,p1);
  freq_01=tmp_ff/1.0MHz;

  tmp_ff=measure_freq.Get_PinVal(1,p2);
  freq_02=tmp_ff/1.0MHz;
}
void freq_run()
{
  TEST.Set();
  freq_limit.lower(NONE);
  freq_limit.upper(NONE);
  
  freq_counter.rng(freq_rng);

  measure_freq.freq(freq_counter);
  measure_freq.limit(freq_limit);
  measure_freq.Set();
  measure_freq.Start();

}

void freq_judge( double &freq,DPIN &p1)
{
  TEST.Set();
  freq_limit.lower(NONE);
  freq_limit.upper(NONE);
  
  freq_counter.rng(freq_rng);

  measure_freq.freq(freq_counter);
  measure_freq.limit(freq_limit);
  measure_freq.Set();
  measure_freq.Start();

  Hertz tmp_ff;
  tmp_ff=measure_freq.Get_PinVal(1,p1);
  freq=tmp_ff/1.0MHz;
}

void freq_judge( Hertz &freq,DPIN &p1)
{
  TEST.Set();
  freq_limit.lower(NONE);
  freq_limit.upper(NONE);
  
  freq_counter.rng(freq_rng);

  measure_freq.freq(freq_counter);
  measure_freq.limit(freq_limit);
  measure_freq.Set();
  measure_freq.Start();

  freq=measure_freq.Get_PinVal(1,p1);
}
