    sr(on);
    rly=off;vi=ifvm; i= 70uA; irng=R800UA; v=3V; vrng=M8V; rvipin(ALL_OS2_RVS); judge(vm, 0.2V, 1.0V,V);
    //rly=off;vi=ifvm; i=-110uA; irng=R800UA; v=3V; vrng=M8V; rvipin(PL_OS_RVS_2); judge(vm,-1.0V,-0.2V,V);
    
