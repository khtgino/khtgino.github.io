void pat(int &a)
{  
  
  if(a==run)
  {vectorreg.stopSPA(NORMAL);
    if(mode==ppdz)
    {
      if(verrngindx==0)
      {
      if (fstop==off) TEST.pg(FAILINH);
      if (fstop==on) TEST.pg(NORMAL);
      TEST.Set();

      vectorreg.STA(startadrn);
      vectorreg.SPA(stopadrn);
      vectorreg.LIDX3(indx_3);
      vectorreg.LIDX4(indx_4);
      vectorreg.LIDX5(indx_5);
      vectorreg.LIDX6(indx_6);
      vectorreg.Load();
      mdgt_samp.Start();
      vectorfile.PreExec();
      mdgt_samp.Wait();
      
      verrngindx=1;
      }  
      else
      {
      mdgt_samp.Start();
      vectorfile.PreExec();
      mdgt_samp.Wait();
      }
    }
    else if(conn==RVS)
    {
      if (fstop==off) TEST.pg(FAILINH);
      if (fstop==on) TEST.pg(NORMAL);
      TEST.Set();

      vectorreg.STA(startadrn);
      vectorreg.SPA(stopadrn);
      vectorreg.LIDX3(indx_3);
      vectorreg.Load();  
      smux.scan(scan_mode);
      smux.step(scan_step);
      smux.scan_idx(LIDX1);
      smux.avrg(ravg);
      smux.avrg_idx(LIDX2);
      rvs_im.smux(smux);
      rvs_im.timeout(tout);
      rvs_im.Set();
      rvs_im.Start();
      vectorfile.PreExec();
      rvs_im.Wait();
    }
    else 
    {
      if (fstop==off) TEST.pg(FAILINH);
      if (fstop==on) TEST.pg(NORMAL);
      TEST.Set();

      vectorreg.STA(startadrn);
      vectorreg.SPA(stopadrn);
      vectorreg.LIDX3(indx_3);
      vectorreg.LIDX4(indx_4);
      vectorreg.LIDX5(indx_5);
      vectorreg.LIDX6(indx_6);
      vectorreg.Load();  
      vectorfile.PreExec();
    }
    performace=0;
  }
  else 
  {
    pg.start(NORMAL);
    pg.pend(OFF);
    pg.Load();
    vectorfile.PostExec();
    vectorreg.init();
  }
  dpsindx=0;
}
