void vm_judge(Volts &b,RVSPIN &p1)
{
  TEST.Set();
  vm_limit.upper(NONE);
  vm_limit.lower(NONE);
  vm_limit.Load();
    
  switch(chkind)    
  {
    case vspinkind:
      measure_dpsvm.isvm(dpsisvm);
      measure_dpsvm.limit(vm_limit);
      measure_dpsvm.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
      measure_dpsvm.Exec();
      break;
    case rvspinkind:
      isvm.Resc(HVDC);
      isvm.SRng(irng);
      isvm.MRng(vrng);
      isvm.SVal(i);
      isvm.CPVal(v);
      isvm.CMVal(v*-1);
      isvm.Load();
      
      measure_vm.isvm(isvm);
      measure_vm.limit(vm_limit);
      measure_vm.sequence(seq_vm);
      measure_vm.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
      measure_vm.Start();
      b=measure_vm.Get_PinVal(1,p1);
      break;
    case lcdpinkind:
        //$if __TESTER_TYPE__ == 119 //for ND4
          if(vrng==M8V || vrng==M12V){vrng=M12V;}
        //$else
        //  if(vrng==M8V || vrng==M12V){vrng=M8V;}
        //$endif
      isvm.Resc(LPPDC);
      isvm.SRng(irng);
      isvm.MRng(vrng);
      isvm.SVal(i);
      isvm.CPVal(v);
      isvm.CMVal(v*-1);
      isvm.Load();
      
      measure_vm.isvm(isvm);
      measure_vm.limit(vm_limit);
      measure_vm.sequence(seq_vm);
      measure_vm.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
      measure_vm.Start();
      b=measure_vm.Get_PinVal(1,p1);
      break;
    case iopinkind:  

      isvm.Resc(MDC);
      isvm.SRng(irng);
      isvm.MRng(vrng);
      isvm.SVal(i);
      isvm.CPVal(v);
      isvm.CMVal(-1.5V);
      isvm.Load();
      
      measure_vm.isvm(isvm);
      measure_vm.limit(vm_limit);
      measure_vm.sequence(seq_vm);
      measure_vm.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
      measure_vm.Start();
      b=measure_vm.Get_PinVal(1,p1);
      break;

    case hsifpinkind:  

      isvm.Resc(MDC);
      isvm.SRng(irng);
      isvm.MRng(vrng);
      isvm.SVal(i);
      isvm.CPVal(v);
      isvm.CMVal(-1.5V);
      isvm.Load();
      
      measure_vm.isvm(isvm);
      measure_vm.limit(vm_limit);
      measure_vm.sequence(seq_vm);
      measure_vm.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
      measure_vm.Start();
      b=measure_vm.Get_PinVal(1,p1);
      break;      
    default: break;  
  }

}
