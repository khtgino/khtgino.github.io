  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 2400MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.5V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  //ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(2); edge(rate2*0,rate2*0.5); pin(DPIN_PAD_LOCK   );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_TEST_DP_SEL   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD_MV_1);
  rly=off; fmt=open; vih=     6.0V; vil=    0.0V;  pin(DPIN_PAD_TEST_SD_MV_2);

  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=512; ravg=1;
  ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;
  //lcdoption=NONE;
  lcdoption=LCDVT1;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================  
  ARRAY<string> gs_tmp_pat(11);
  gs_tmp_pat[ 0]="fn01a1_0101_ch1446_dpsel_2p_8b_shl_0_int_stb_0_reg_dpsel_en_1_25_1105_all";
  gs_tmp_pat[ 1]="fn01a1_0101_ch1446_dpsel_2p_8b_shl_0_int_stb_1_reg_dpsel_en_0_25_1105_all";
  gs_tmp_pat[ 2]="fn01a1_0101_ch1446_dpsel_2p_8b_shl_0_int_stb_1_reg_dpsel_en_1_25_1105_all";
  gs_tmp_pat[ 3]="fn01a1_0101_ch1446_dpsel_2p_8b_shl_1_int_stb_0_reg_dpsel_en_0_25_1105_all";
  gs_tmp_pat[ 4]="fn01a1_0101_ch1446_dpsel_2p_8b_shl_1_int_stb_0_reg_dpsel_en_1_25_1105_all";
  gs_tmp_pat[ 5]="fn01a1_0101_ch1446_dpsel_2p_8b_shl_1_int_stb_1_reg_dpsel_en_0_25_1105_all";
  gs_tmp_pat[ 6]="";
  gs_tmp_pat[ 7]="";
  gs_tmp_pat[ 8]="";
  gs_tmp_pat[ 9]="";
  gs_tmp_pat[10]="";

  ARRAY<string> gs_tmp_pat_6p(16);
  gs_tmp_pat_6p[ 0]="fn01a1_0101_ch1446_dpsel_2p_6b_shl_0_int_stb_0_reg_dpsel_en_0_25_1105_all";
  gs_tmp_pat_6p[ 1]="fn01a1_0101_ch1446_dpsel_2p_6b_shl_0_int_stb_0_reg_dpsel_en_1_25_1105_all";
  gs_tmp_pat_6p[ 2]="fn01a1_0101_ch1446_dpsel_2p_6b_shl_0_int_stb_1_reg_dpsel_en_1_25_1105_all";
  gs_tmp_pat_6p[ 3]="fn01a1_0101_ch1446_dpsel_2p_6b_shl_1_int_stb_0_reg_dpsel_en_0_25_1105_all";
  gs_tmp_pat_6p[ 4]="fn01a1_0101_ch1446_dpsel_2p_6b_shl_1_int_stb_0_reg_dpsel_en_1_25_1105_all";
  gs_tmp_pat_6p[ 5]="fn01a1_0101_ch1446_dpsel_2p_6b_shl_1_int_stb_1_reg_dpsel_en_0_25_1105_all";
  gs_tmp_pat_6p[ 6]="fn01a1_0101_ch1446_dpsel_2p_6b_shl_1_int_stb_1_reg_dpsel_en_1_25_1105_all";
  gs_tmp_pat_6p[ 7]="";
  gs_tmp_pat_6p[ 8]="";
  gs_tmp_pat_6p[ 9]="";
  gs_tmp_pat_6p[10]="";
  gs_tmp_pat_6p[11]="";
  gs_tmp_pat_6p[12]="";
  gs_tmp_pat_6p[13]="";
  gs_tmp_pat_6p[14]="";

//================================================================================================  

  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();
  wait(6.0mS);

  for( int_k=0 ; int_k<=5 ; int_k+=1 )
  {
  //--------------------------------------------------------------------
  tno(tmp_test_num++); cat(34); dcmnt("GS "+gs_tmp_pat[int_k].substr(12,49)+" Pattern Test");

  patf(gs_tmp_pat[int_k]+".lpa"); pat(run); calcstart(ALL_LCD , gs0101_pinc_d01_02);
  compare_temp_gst(dev_vh_0101_d01_02,dev_vl_0101_d01_02,dev_gs0101vh_hlimit_165V,dev_gs0101vh_llimit_165V,dev_gs0101vl_hlimit_165V,dev_gs0101vl_llimit_165V,gs0101_all_result_01[1]);  
 
  judge( gs0101_all_result_01[1] , 0,0 );
  //--------------------------------------------------------------------
  }
//===========================================================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=128; ravg=1;
  ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;
  //lcdoption=NONE;
  lcdoption=LCDVT1;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================
  for( int_k=0 ; int_k<=6 ; int_k+=1 )
  {
  tno(tmp_test_num++); cat(34); dcmnt("GS "+gs_tmp_pat_6p[int_k].substr(12,49)+" Pattern Test");

  patf(gs_tmp_pat_6p[int_k]+".lpa"); 
  
  pat(run); calcstart(ALL_LCD , dev_gs0101_raw_data_6p);
  compare_temp_gst(dev_gs0101_raw_data_6p,dev_gs0101_hlimit_6p,dev_gs0101_llimit_6p,gs0101_all_result_01[1]);  
 
  judge( gs0101_all_result_01[1] , 0,0 );
  }
  
//===========================================================================================  

  //sr(off);
  POWER_OFF_FUNC1();
  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("GS_OTHER-02 2p(6b/8b) Pattern Test ");

  return 0;
}
