//===========================================================================================
  if( test_chip_num!=103 ){  tno(tmp_test_num++); cat(38); dcmnt("GOA FUNCTION CHECK"); lcd_meas(goz_out_all,goz_out_all_max,goz_out_all_min ); }
  else{  tno(tmp_test_num++); cat(38); dcmnt("GOA FUNCTION CHECK"); lcd_meas(goz_out_all,goz_out_all_max_t3,goz_out_all_min_t3 ); }
