  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-2-S2 MAX");  judge( sxmux_p2_max_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-2-S2 MIN");  judge( sxmux_p2_min_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-3-S2 MAX");  judge( sxmux_p3_max_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-3-S2 MIN");  judge( sxmux_p3_min_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-4-S2 MAX");  judge( sxmux_p4_max_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-4-S2 MIN");  judge( sxmux_p4_min_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-5-S2 MAX");  judge( sxmux_p5_max_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-5-S2 MIN");  judge( sxmux_p5_min_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-6-S2 MAX");  judge( sxmux_p6_max_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-6-S2 MIN");  judge( sxmux_p6_min_s2 , 2000 , 5500 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-7-S2 MAX");  judge( sxmux_p7_max_s2 ,    0 ,  100 );
  tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-7-S2 MIN");  judge( sxmux_p7_min_s2 ,    0 ,  100 );

  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-1 MAX Ratio");  judge( (sxmux_p1_max_s2-sxmux_p1_avg_s2)/sxmux_p1_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-1 MIN Ratio");  judge( (sxmux_p1_avg_s2-sxmux_p1_min_s2)/sxmux_p1_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-2 MAX Ratio");  judge( (sxmux_p2_max_s2-sxmux_p2_avg_s2)/sxmux_p2_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-2 MIN Ratio");  judge( (sxmux_p2_avg_s2-sxmux_p2_min_s2)/sxmux_p2_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-3 MAX Ratio");  judge( (sxmux_p3_max_s2-sxmux_p3_avg_s2)/sxmux_p3_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-3 MIN Ratio");  judge( (sxmux_p3_avg_s2-sxmux_p3_min_s2)/sxmux_p3_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-4 MAX Ratio");  judge( (sxmux_p4_max_s2-sxmux_p4_avg_s2)/sxmux_p4_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-4 MIN Ratio");  judge( (sxmux_p4_avg_s2-sxmux_p4_min_s2)/sxmux_p4_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-5 MAX Ratio");  judge( (sxmux_p5_max_s2-sxmux_p5_avg_s2)/sxmux_p5_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-5 MIN Ratio");  judge( (sxmux_p5_avg_s2-sxmux_p5_min_s2)/sxmux_p5_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-6 MAX Ratio");  judge( (sxmux_p6_max_s2-sxmux_p6_avg_s2)/sxmux_p6_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-6 MIN Ratio");  judge( (sxmux_p6_avg_s2-sxmux_p6_min_s2)/sxmux_p6_avg_s2 , 0.005 , 0.09 );

  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_L  Freq");  judge( 1/(OSC_P1*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_L1 Freq");  judge( 1/(OSC_P2*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_L2 Freq");  judge( 1/(OSC_P3*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_R  Freq");  judge( 1/(OSC_P4*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_R1 Freq");  judge( 1/(OSC_P5*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_R2 Freq");  judge( 1/(OSC_P6*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-7 Freq");  judge( 1/(OSC_P7*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );

//================================================================================================
  adc_sxmux_f4.close();
  wait(1mS);
//===========================================================================================
  dfm.type(DFM_FAILSTORE);
  dfm.begin(0);
  dfm.end(0x3ffffdf);
  dfm.fcnt(4095);
  dfm.Load();
  
  pat(stop);
  //sr(off);
  POWER_OFF_FUNC1();
  
//  /*************************  HSIF  ***********************************/
////dutoffest.pinlist(ALL_IOPIN);
////dutoffest.timing(0nS);
////dutoffest.Load();
////dutoffest.ClearAll();
//
//  hsif_all_t.kind(OPEN);          
//  hsif_all_t.Load();              
//
//  rate.hsif_rate(OFF);
//  rate.Load();
//
//  hsif_tshift.shift(0pS);
//  hsif_tshift.Load();
//
////HSIF_CTRL.trig(OFF);
////HSIF_CTRL.Load();  

  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("Touch SXMUX           ");

  return 0;
}

ARRAY<double> cp_04_tx_all_v(1428*4);
ARRAY<double> cp_04_tx_all_max(1428*4);
ARRAY<double> cp_04_tx_all_min(1428*4);

ARRAY<double> cp_04_tx_odd(1428*2);
ARRAY<double> cp_04_tx_evn(1428*2);
ARRAY<double> cp_04_tx_odd_s1(1428*1);
ARRAY<double> cp_04_tx_evn_s1(1428*1);

ARRAY<double> cp_04_tx_odd1_max(1428*1);
ARRAY<double> cp_04_tx_odd1_min(1428*1);
ARRAY<double> cp_04_tx_evn1_max(1428*1);
ARRAY<double> cp_04_tx_evn1_min(1428*1);

double cp_04_offset=0.5;

for( int_i=0   ; int_i<714*1 ; int_i+=1 ){ cp_04_tx_odd1_max[int_i]=6.0+cp_04_offset; cp_04_tx_odd1_min[int_i]=6.0-cp_04_offset; cp_04_tx_evn1_max[int_i]=6.0+cp_04_offset; cp_04_tx_evn1_min[int_i]=6.0-cp_04_offset; }
for( int_i=714 ; int_i<714*2 ; int_i+=1 ){ cp_04_tx_odd1_max[int_i]=0.0+cp_04_offset; cp_04_tx_odd1_min[int_i]=0.0-cp_04_offset; cp_04_tx_evn1_max[int_i]=0.0+cp_04_offset; cp_04_tx_evn1_min[int_i]=0.0-cp_04_offset; }


int touch_uplink()
{
  int tmp_test_num=0;


  testno=72000;

  cw1_num[ 0]=1;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 40MHz;

  rate1 = (1/freq)*1;
  rate2 = (1/freq)*1;
  rate3 = (1/freq)*1;
  rate4 = (1/freq)*1;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.5;
  vol_in[1]  = (1.8V)*0.5;
  voh_in[2]  = 1.2V;
  vol_in[2]  = 1.2V;
  
  Volts sine_vt=2.5V;

  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(OFF,rate1,rate2,rate3,rate4);

  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(TOURCH_GP01);
  rly=on; fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

//=========================== FIXH/L Setting ======================================================
  rly=on;  fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

  rly=off; fmt=OPEN; vih=1.75V; vil=vil_in[2]; pin(DPIN_PAD_LOCK);
  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IN; t(1); edge(rate1*0); pin(DPIN_PAD_XON);
  rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IN; t(1); edge(rate1*0); pin(DPIN_PAD_WAKE);

  rly=on;  fmt=FIXH; pin(DPIN_PAD_XON);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_WAKE);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_STB);

  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_08);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_09);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_10);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_11);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_12);
  // 3.610mS
  //rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IO; t(1); edge(rate1*0); pin(DPIN_PAD_TEST_DIP_I_08);
  //rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IO; t(1); edge(rate1*0); pin(DPIN_PAD_TEST_DIP_I_09);
  //rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IO; t(1); edge(rate1*0); pin(DPIN_PAD_TEST_DIP_I_10);
  //rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IO; t(1); edge(rate1*0); pin(DPIN_PAD_TEST_DIP_I_11);
  //rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IO; t(1); edge(rate1*0); pin(DPIN_PAD_TEST_DIP_I_12);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=off; mode=ppdz; rng=R10V; scan_mode=STEP_INC;scan_step=1; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-50uA; iol=50uA; vt1=0V;vt2=0V;
  lcdoption=NONE; lcdvoh= 1.5V;lcdvol= 1.5V;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate2/2;
  lcdstrb3 =rate3/2;
  lcddigit1=rate1/2;
  lcddigit2=rate2/2;
  lcddigit3=rate3/2;

  lcdpin(ALL_LCDPIN);

  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=STEP_INC;scan_step=2; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-0.1uA; iol=0.1uA; vt1=-1.5V;vt2=0V;
  lcdoption=NONE; lcdvoh= 1.2V;lcdvol= 1.2V;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate2/2;
  lcdstrb3 =rate3/2;
  lcddigit1=rate1/2;
  lcddigit2=rate2/2;
  lcddigit3=rate3/2;

  lcdpin(ALL_TX_PIN);
    
  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================
  int eng_stob1;

//================================================================================================
  POWER_ON_FUNC1();
  wait(2.0mS);
 
  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  patf("fn01a1_tp_cp05_sx_mode_rotate_250908_nor_nd4.lpa");

  pat(run);
  calcstart(ALL_TX_PIN , cp_05_tx_all_v);

  //patf("fn01a1_tp_cp05_sx_mode_rotate_251028_nor_nd4.lpa");
  //
  //pat(run);
  //calcstart(ALL_TX_PIN , cp_05_tx_all_v);

//================================================================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=STEP_INC;scan_step=4; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-0.1uA; iol=0.1uA; vt1=-1.0V;vt2=-1.0V;
  lcdoption=LCDVT1; lcdvoh= 2.4V+0.15V;lcdvol= 2.4V-0.15V;
  
  lcdpin(ALL_TX_PIN);
//================================================================================================
  tno(tmp_test_num++); cat(72); dcmnt("Touch UPLINK");

  patf("fn01a1_tp_cp4_pen_uplink_250908_nor_nd4.lpa");
  pat(run);
  //calcstart(ALL_TX_PIN , cp_04_tx_all_v);
  calcstart(ALL_TX_ODD , cp_04_tx_odd);
  calcstart(ALL_TX_EVN , cp_04_tx_evn);
  
  ary_xpart(cp_04_tx_odd,   0,1428*1,cp_04_tx_odd_s1,0);
  ary_xpart(cp_04_tx_evn,1428,1428*2,cp_04_tx_evn_s1,0);
//===========================================================================================

  tno(tmp_test_num++); cat(72); dcmnt("TOUCH CP_04 UPLINK ODD CHECK");          lcd_meas( cp_04_tx_odd_s1 , cp_04_tx_odd1_max  , cp_04_tx_odd1_min );
  tno(tmp_test_num++); cat(72); dcmnt("TOUCH CP_04 UPLINK EVN CHECK");          lcd_meas( cp_04_tx_evn_s1 , cp_04_tx_evn1_max  , cp_04_tx_evn1_min );

  tno(tmp_test_num++); cat(73); dcmnt("TOUCH CP_05 SX_MODE CHECK");          lcd_meas( cp_05_tx_all_v , cp_05_tx_all_max  , cp_05_tx_all_min );


//===========================================================================================

//===========================================================================================
  dfm.type(DFM_FAILSTORE);
  dfm.begin(0);
  dfm.end(0x3ffffdf);
  dfm.fcnt(4095);
  dfm.Load();
  
  pat(stop);
  POWER_OFF_FUNC1();
  
//  /*************************  HSIF  ***********************************/
////dutoffest.pinlist(ALL_IOPIN);
////dutoffest.timing(0nS);
////dutoffest.Load();
////dutoffest.ClearAll();
//
//  hsif_all_t.kind(OPEN);          
//  hsif_all_t.Load();              
//
//  rate.hsif_rate(OFF);
//  rate.Load();
//
//  hsif_tshift.shift(0pS);
//  hsif_tshift.Load();
//
////HSIF_CTRL.trig(OFF);
////HSIF_CTRL.Load();  

  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("Touch CP-04 UPLINK/CP-05 SX_MODE Test");

  return 0;
}

      
int touch_mbist()
{
  int tmp_test_num=0;


  testno=78000;

  cw1_num[ 0]=0;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
