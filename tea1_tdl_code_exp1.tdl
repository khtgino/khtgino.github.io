int goa_func_dig()
{
  int tmp_test_num=0;

  testno=38000;

  cw1_num[ 0]=1;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
