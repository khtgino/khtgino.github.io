//=========================== GS Code p2p short ===================================================
//=========================== No Chopper Limit = 100mV ============================================
ARRAY<double>  dev_gs_p2p_short_hlimit_01(lcdpinno*48);
ARRAY<double>  dev_gs_p2p_short_llimit_01(lcdpinno*48);
ARRAY<double>  dev_gs_p2p_short_hlimit_02(lcdpinno*48);
ARRAY<double>  dev_gs_p2p_short_llimit_02(lcdpinno*48);

for(int_j=0; int_j<48; int_j++)
  {
  for(int_i=0; int_i<lcdpinno; int_i++)
  {
    limit=0.100;
    if((int_i%48)==int_j)
    {
      if(int_i%2==0)
      {
        dev_gs_p2p_short_hlimit_01[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[255]+limit;
        dev_gs_p2p_short_llimit_01[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[255]-limit;

        dev_gs_p2p_short_hlimit_02[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[170]+limit;
        dev_gs_p2p_short_llimit_02[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[170]-limit;
      }
      else
      {
        dev_gs_p2p_short_hlimit_01[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[255]+limit;
        dev_gs_p2p_short_llimit_01[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[255]-limit;

        dev_gs_p2p_short_hlimit_02[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[170]+limit;
        dev_gs_p2p_short_llimit_02[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[170]-limit;
      }
    }
    else
    {
      if(int_i%2==0)
      {
        dev_gs_p2p_short_hlimit_01[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[  0]+limit;
        dev_gs_p2p_short_llimit_01[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[  0]-limit;

        dev_gs_p2p_short_hlimit_02[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[  0]+limit;
        dev_gs_p2p_short_llimit_02[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[  0]-limit;
      }
      else
      {
        dev_gs_p2p_short_hlimit_01[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[  0]+limit;
        dev_gs_p2p_short_llimit_01[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[  0]-limit;

        dev_gs_p2p_short_hlimit_02[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[  0]+limit;
        dev_gs_p2p_short_llimit_02[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[  0]-limit;
      }
    }
  }
}

//=========================== GS Charge share Judge ===================================================

for(int_j=0; int_j<4; int_j++)
  {
  for(int_i=0; int_i<lcdpinno; int_i++)
  {
    limit=0.150;
    if( int_j==0 )
    {
      if(int_i%2==0)
      {
        gs_cs_data_max[lcdpinno*int_j+int_i]=+0.20;//douArray_gamma_positive_float[202]+limit*5;
        gs_cs_data_min[lcdpinno*int_j+int_i]=-0.20;//douArray_gamma_positive_float[202]-limit*5;
      }
      else
      {
        gs_cs_data_max[lcdpinno*int_j+int_i]=+0.20;//douArray_gamma_negative_float[221]+limit*5;
        gs_cs_data_min[lcdpinno*int_j+int_i]=-0.20;//douArray_gamma_negative_float[221]-limit*5;
      }
    }
    if( int_j==2 )
    {
      if(int_i%2==0)
      {
        gs_cs_data_max[lcdpinno*int_j+int_i]=+0.20;//douArray_gamma_positive_float[202]+limit*5;
        gs_cs_data_min[lcdpinno*int_j+int_i]=-0.20;//douArray_gamma_positive_float[202]-limit*5;
      }
      else
      {
        gs_cs_data_max[lcdpinno*int_j+int_i]=+0.20;//douArray_gamma_negative_float[221]+limit*5;
        gs_cs_data_min[lcdpinno*int_j+int_i]=-0.20;//douArray_gamma_negative_float[221]-limit*5;
      }
    }
    if( int_j==1 )
    {
      if(int_i%2==0)
      {
        gs_cs_data_max[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[255]+limit;
        gs_cs_data_min[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[255]-limit-0.080;
      }
      else
      {
        gs_cs_data_max[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[255]+limit+0.080;
        gs_cs_data_min[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[255]-limit;
      }
    }
    if( int_j==3 )
    {
      if(int_i%2==0)
      {
        gs_cs_data_max[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[255]+limit+0.080;
        gs_cs_data_min[lcdpinno*int_j+int_i]=douArray_gamma_positive_float[255]-limit;
      }
      else
      {
        gs_cs_data_max[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[255]+limit;
        gs_cs_data_min[lcdpinno*int_j+int_i]=douArray_gamma_negative_float[255]-limit-0.080;
      }
    }
  }
}

