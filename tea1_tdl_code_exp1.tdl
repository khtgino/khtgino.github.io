    int_k=0;
    int_M=lcdpinno/2+1;
    for(int_j=0;int_j<levelno;int_j++)
    {for(int_i=0;int_i<lcdpinno;int_i++)
    {
      switch(int_i%4)
      {
        case 0 : intArray_index1[lcdpinno*int_j+int_k]=int_i+lcdpinno*int_j; int_k++; break;
        case 1 : intArray_index1[lcdpinno*int_j+int_k]=int_i+lcdpinno*int_j; int_k++; break;
        case 2 : intArray_index1[lcdpinno*int_j+int_M]=int_i+lcdpinno*int_j; int_M++; break;
        case 3 : intArray_index1[lcdpinno*int_j+int_M]=int_i+lcdpinno*int_j; int_M++; break;

        default:break;
      }
      if(int_k>lcdpinno/2) int_k=0;
      if(int_M==lcdpinno) int_M=lcdpinno/2+1;


    }}

void array_f_display(ARRAY<double> &i_data1,ARRAY<double> &i_data2,ARRAY<double> &i_data3,int &level)
{

  print "*************************ARRAY FAIL DISPLAY*****************************\n\n\n";
  print "******",testname,"******\n\n";
  
  for(int_j=0;int_j<level;int_j++)
  {
    print "*************************LEVEL=",int_j+1,"*****************************\n";
    for(int_i=0;int_i<lcdpinno;int_i++)
     {
       if(i_data1[int_j*lcdpinno+int_i]>i_data2[int_j*lcdpinno+int_i]||i_data1[int_j*lcdpinno+int_i]<i_data3[int_j*lcdpinno+int_i])
       print "LCD ",int_i+1,"=",i_data1[int_j],"\n";
     }
  }
}
