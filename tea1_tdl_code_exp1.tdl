        dmem_ary_sine5[int_i-2]==0 && 
        dmem_ary_sine5[int_i-1]==0 && 
        dmem_ary_sine5[int_i-0]==1 ){ L_TO_H_POINT_ARY05[L_TO_H_cnt5]=int_i; L_TO_H_cnt5+=1; }

    if( dmem_ary_sine6[int_i-6]==0 && 
        dmem_ary_sine6[int_i-5]==0 && 
        dmem_ary_sine6[int_i-4]==0 && 
        dmem_ary_sine6[int_i-3]==0 && 
        dmem_ary_sine6[int_i-2]==0 && 
        dmem_ary_sine6[int_i-1]==0 && 
        dmem_ary_sine6[int_i-0]==1 ){ L_TO_H_POINT_ARY06[L_TO_H_cnt6]=int_i; L_TO_H_cnt6+=1; }

  }

  for( int_i=1 ; int_i<14 ; int_i+=1 )
  {
  	if(  (int_i%7!=0 ) )
  		{
  			OSC_P1=OSC_P1+(L_TO_H_POINT_ARY01[int_i]-L_TO_H_POINT_ARY01[int_i-1]);
  			OSC_P2=OSC_P2+(L_TO_H_POINT_ARY02[int_i]-L_TO_H_POINT_ARY02[int_i-1]);
  			OSC_P3=OSC_P3+(L_TO_H_POINT_ARY03[int_i]-L_TO_H_POINT_ARY03[int_i-1]);
  			OSC_P4=OSC_P4+(L_TO_H_POINT_ARY04[int_i]-L_TO_H_POINT_ARY04[int_i-1]);
  			OSC_P5=OSC_P5+(L_TO_H_POINT_ARY05[int_i]-L_TO_H_POINT_ARY05[int_i-1]);
  			OSC_P6=OSC_P6+(L_TO_H_POINT_ARY06[int_i]-L_TO_H_POINT_ARY06[int_i-1]);
  			
  		}
  	
  	
  }

  OSC_P1=OSC_P1/12;  //cout<<"TRX01 Freq(AVG):"<<1/(OSC_P1*rate1)<<"\n";
  OSC_P2=OSC_P2/12;  //cout<<"TRX01 Freq(AVG):"<<1/(OSC_P1*rate1)<<"\n";
  OSC_P3=OSC_P3/12;  //cout<<"TRX01 Freq(AVG):"<<1/(OSC_P1*rate1)<<"\n";
  OSC_P4=OSC_P4/12;  //cout<<"TRX01 Freq(AVG):"<<1/(OSC_P1*rate1)<<"\n";
  OSC_P5=OSC_P5/12;  //cout<<"TRX01 Freq(AVG):"<<1/(OSC_P1*rate1)<<"\n";
  OSC_P6=OSC_P6/12;  //cout<<"TRX01 Freq(AVG):"<<1/(OSC_P1*rate1)<<"\n";

  if( OSC_P1==0 ){ OSC_P1=0.000001; }
  if( OSC_P2==0 ){ OSC_P2=0.000001; }
  if( OSC_P3==0 ){ OSC_P3=0.000001; }
  if( OSC_P4==0 ){ OSC_P4=0.000001; }
  if( OSC_P5==0 ){ OSC_P5=0.000001; }
  if( OSC_P6==0 ){ OSC_P6=0.000001; }
  if( OSC_P7==0 ){ OSC_P7=0.000001; }

  exdmem.Disconnect();
  wait(1.0mS);

 
  //------------------------------------------------------------------------------------------ 

  rly=off; fmt=OPEN; option=NONE; pin(GRID_02);
  //------------------------------------------------------------------------------------------ 
  patf("tp_cp02_sdmcp_on_off_kaiser_ahb_on_crc_chk_panel_reg_20251120_dmem.lpa");

  exdmem.pinlist(ADC_GROUP_01);
  exdmem.Load();
  exdmem.Start();

  meas(result,int_i);
  
  exdmem.Stop();
    
  dmem_cnt_1= exdmem.Get_AcquiredCount (1,1);
  //exdmem.Get_AcquiredData(1,ADC_GROUP_01,0,dmem_ary_data1);
  exdmem.Get_AcquiredData(1,DPIN_PAD_SPI_MISO,0,MSB,8,dmem_dec1_all);
  
  exdmem.Disconnect();

  //sr(off);
  
