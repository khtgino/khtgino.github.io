void rvipin(RVSPIN &rvspin)
{
  if(vi==ifvm)
  {
    if(rly==off) 
    {
      rvsunit_relay.rvspin(rvspin);
      rvsunit_relay.relay_mode(OPEN);
      rvsunit_relay.Load();
      measure_vm.pinlist(rvspin);
    }  
    if(rly==hvdc) 
    {
      rvsunit_relay.rvspin(rvspin);
      rvsunit_relay.relay_mode(HVDC);
      rvsunit_relay.Load();
      
      isvm.Resc(HVDC);
      isvm.SRng(irng);
      isvm.MRng(vrng);
      isvm.SVal(i);
      isvm.CPVal(v);
      isvm.CMVal(v*-1);
      isvm.Load();
      
      measure_vm.pinlist(rvspin);
    }
    if(rly==ppdz) 
    {
      
      rvsunit_relay.rvspin(rvspin);
      rvsunit_relay.relay_mode(RVS);
      rvsunit_relay.Load();
      
      smux.scan(scan_mode);
      smux.step(scan_step);
      smux.scan_idx(LIDX1);
      smux.avrg(ravg);
      smux.avrg_idx(LIDX2);

      rvs_vm.rvspin(rvspin);
      rvs_vm.smux(smux);
      rvs_vm.timeout(5S);

      rvs_vm.Set();
      rvs_vm.Start();
      rvs_vm.Wait();
    }
  }
  else if(vi==vfim)
  {

    if(rly==on||rly==dir) 
    {
      rvsunit_relay.rvspin(rvspin);
      rvsunit_relay.relay_mode(RVS);
      rvsunit_relay.Load();

      rvs_vs.rvspin(rvspin);
      rvs_vs.SRng(vrng);
      rvs_vs.SVal(v);
      //rvs_vs.MRng(irng);
      rvs_vs.MRng(M10MA);
      rvs_vs.Load();
      rvs_im.rvspin(rvspin);
    }
    else if(rly==off) 
    {
      rvsunit_relay.rvspin(rvspin);
      rvsunit_relay.relay_mode(OPEN);
      rvsunit_relay.Load();

      measure_im.pinlist(rvspin);
    }
    else if(rly==hvdc) 
    {
      rvsunit_relay.rvspin(rvspin);
      rvsunit_relay.relay_mode(HVDC);
      rvsunit_relay.Load();
      
      vsim.Resc(HVDC);
      vsim.MRng(irng);
      vsim.SRng(vrng);
      vsim.SVal(v);
      vsim.CPVal(i);
      vsim.CMVal(i*-1);
        vsim.Load();
    
      measure_im.pinlist(rvspin);
      
    }
  }
  chkind=rvspinkind;

}
void rvipin(RVSPIN &rvspin1,RVSPIN &rvspin2)
{
  if(vi==ifvm)
  {
    if(rly==off) 
    {
      rvsunit_relay.rvspin(rvspin1,rvspin2);
      rvsunit_relay.relay_mode(OPEN);
      rvsunit_relay.Load();
      measure_vm.pinlist(rvspin1,rvspin2);
    }  
    if(rly==hvdc) 
    {
      
      rvsunit_relay.rvspin(rvspin1,rvspin2);
      rvsunit_relay.relay_mode(HVDC);
      rvsunit_relay.Load();
      
      isvm.Resc(HVDC);
      isvm.SRng(irng);
      isvm.MRng(vrng);
      isvm.SVal(i);
      isvm.CPVal(v);
      isvm.CMVal(v*-1);
      isvm.Load();
      
      measure_vm.pinlist(rvspin1,rvspin2);
    }
  }
  else if(vi==vfim)
  {

    if(rly==on||rly==dir) 
    {
      rvsunit_relay.rvspin(rvspin1,rvspin2);
      rvsunit_relay.relay_mode(RVS);
      rvsunit_relay.Load();

      rvs_vs.rvspin(rvspin1,rvspin2);
      rvs_vs.SRng(vrng);
      rvs_vs.SVal(v);
      //rvs_vs.MRng(irng);
      rvs_vs.MRng(M10MA);
      rvs_vs.Load();
      rvs_im.rvspin(rvspin1,rvspin2);
    }
    else if(rly==off) 
    {
      rvsunit_relay.rvspin(rvspin1,rvspin2);
      rvsunit_relay.relay_mode(OPEN);
      rvsunit_relay.Load();

      measure_im.pinlist(rvspin1,rvspin2);
    }
    else if(rly==hvdc) 
    {
      rvsunit_relay.rvspin(rvspin1,rvspin2);
      rvsunit_relay.relay_mode(HVDC);
      rvsunit_relay.Load();
      
      vsim.Resc(HVDC);
      vsim.MRng(irng);
      vsim.SRng(vrng);
      vsim.SVal(v);
      vsim.CPVal(i);
      vsim.CMVal(i*-1);
        vsim.Load();
    
      measure_im.pinlist(rvspin1,rvspin2);
      
    }
  }
  chkind=rvspinkind;

}
