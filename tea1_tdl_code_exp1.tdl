string toggle_w1;
int    toggle_int1;

limit=0.100;

ifstream ideal_toggle_112( __PATH__"toggle_112_ideal.log");
 for( int_i=0; int_i<lcdpinno*112; int_i=int_i+1)
   { ideal_toggle_112>>toggle_w1;
   	 toggle_int1=hex2dec(toggle_w1.substr(1,2));
   	 toggle_w1=toggle_w1.substr(0,1);
   	 
   	 if( toggle_w1=="1" ){  dev_gs_toggle_hlimit_01[int_i]=douArray_gamma_positive_float[toggle_int1]+limit; dev_gs_toggle_llimit_01[int_i]=douArray_gamma_positive_float[toggle_int1]-limit; }
   	 if( toggle_w1=="0" ){  dev_gs_toggle_hlimit_01[int_i]=douArray_gamma_negative_float[toggle_int1]+limit; dev_gs_toggle_llimit_01[int_i]=douArray_gamma_negative_float[toggle_int1]-limit; }

   }
