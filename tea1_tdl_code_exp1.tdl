void pat(int &a,int &b)
{  
  if (fstop==off) TEST.pg(FAILINH);
  if (fstop==on) TEST.pg(NORMAL);
  TEST.Set();
  pg.start(NORMAL);
  pg.pend(ON);
  pg.Load();
  
  vectorreg.STA(startadrn);
  vectorreg.SPA(stopadrn);
  vectorreg.LIDX3(indx_3);
  vectorreg.LIDX4(indx_4);
  vectorreg.LSTA(lstartadrn);
  vectorreg.LSPA(lstopadrn);
  vectorreg.Load();
  vectorfile.PreExec();
  
  avrsamp.mode(TIMER_STOP);
  avrsamp.time(avg*100uS);
  
  meas_dpsavrim.sample(avrsamp);
  meas_dpsavrim.vector(vectorfile);
  meas_dpsavrim.reg(vectorreg);
  lstartadrn=0;lstopadrn=0;
  dpsindx=b;
}
void meas( DPIN &dpin1,Hertz &Freq)
{
  TEST.Set();

  freq_limit.lower(NONE);
  freq_limit.upper(NONE);
  freq_limit.Load(); 
  
  freq_counter.rng(freq_rng);
  freq_counter.Load(); 

  measure_freq.freq(freq_counter);
  measure_freq.limit(freq_limit);
  measure_freq.Set();
  measure_freq.Start();
  
  Freq=measure_freq.Get_PinVal(1,dpin1);
}
void meas_addr(int &a,int &b,int &adr_s,int &adr_e)
{
  if(a==result) 
  {
    if (fstop==off) TEST.pg(FAILINH);
    if (fstop==on) TEST.pg(NORMAL);
    TEST.Set();

    vectorreg.STA(startadrn);
    vectorreg.SPA(stopadrn);
    vectorreg.LIDX3(indx_3);
    vectorreg.LIDX4(indx_4);
    vectorreg.LIDX5(indx_5);
    vectorreg.LIDX6(indx_6);
    vectorreg.Load();

    dfm.type(DFM_FAILSTORE);
    dfm.begin(adr_s);
    dfm.end(adr_e);
    dfm.fcnt(4095);
    dfm.Load();

    measure_ft.vector(vectorfile);
    measure_ft.reg(vectorreg);
    measure_ft.dfm(dfm);
    measure_ft.Set();
    measure_ft.Start();
    b=measure_ft.Get_Result(1);
  }
}
