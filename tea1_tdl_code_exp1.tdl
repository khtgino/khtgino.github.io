  {

  print "//=======================================================================================\n";
  if( shm_n03==1 ){ print "//Pattern:fn01_keyboard_plus_ch1446_dpsel_4p_bsel_1_shl_1_25_1224_1,Jitter:NA \n"; }
  if( shm_n03==2 ){ print "//Pattern:fn01_keyboard_plus_ch1446_dpsel_4p_bsel_1_shl_1_25_1224,Jitter:NA \n"; }
