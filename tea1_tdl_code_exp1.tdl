  //func_02_pat_ary[32]="fn01_wake_sel_ch1446_4p8b_shl_1_25_0925_redu";


  func_02_pat_ary[0 ]="fn01_keyboard_plus_ch1446_dpsel_4p_bsel_1_shl_1_25_1030_redu";
  func_02_pat_ary[1 ]="lock_4p_2025_11_07_2u";
  func_02_pat_ary[2 ]="relock_2025_09_24_4u_te_redu";
  func_02_pat_ary[3 ]="fn01_int_stb_dpsel_4p_25_0925_redu2";
  func_02_pat_ary[4 ]="fn01_prbs_dpsel_4p_25_0925_redu";
  func_02_pat_ary[5 ]="fn01_rego_ch1446_dpsel_4p_25_0925_redu";
  func_02_pat_ary[6 ]="fn01_wake_sel_ch1446_4p8b_shl_1_25_0925_redu";

//================================== variable setting ======================================
  freq  = 2000MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.5V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;

  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ========================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting ============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );

  vih=vih_in[2]; vil=vil_in[2]; voh=(1.8V)*0.5;vol=(1.8V)*0.5; vt=+1.9V;ilh=-200uA;ill=200uA; pin(DPIN_PAD_LOCK   );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); signal_timing.option(IL,PTMUX); pin(DPIN_PAD_LOCK   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_EN);
  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL);

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; t(1); edge(rate1*0,rate1*0.5); signal_timing.option(HINIT,PTMUX); pin(DPIN_PAD_WAKE );
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; t(1); edge(rate1*0,rate1*0.5); signal_timing.option(HINIT,PTMUX); pin(DPIN_PAD_XON  );


//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=off; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=2; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 0.01V; lcdvol= -0.01V;
  lcdoption=NONE;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();
//================================================================================================  

  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();
  wait(6.0mS);
  
  for( int_i=1 ; int_i<=2 ; int_i+=1 )
   {
    tno(tmp_test_num++); cat(19); dcmnt(func_02_pat_ary[int_i]); patf(func_02_pat_ary[int_i]+".lpa"); pjudge(result);  	
   }


//===========================================================================================
//===========================================================================================

  POWER_OFF_FUNC1();
  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
  sr(off);
//===========================================================================================

  TSTime("Normal Func (lock) Test ");

  return 0;
}


