          vsim.Load();
          
          measure_im.vsim(vsim);
        measure_im.limit(im_limit);
        measure_im.sequence(seq_im);
        measure_im.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_im.Exec();
          break;
      case lcdpinkind:
        //$if __TESTER_TYPE__ == 119 //for ND4
        //  if(vrng==M8V || vrng==M12V){vrng=M12V;}
        //$else
        //  if(vrng==M8V || vrng==M12V){vrng=M8V;}
        //$endif
        vsim.Resc(LPPDC);
        vsim.MRng(irng);
        vsim.SRng(vrng);
        vsim.SVal(v);
        vsim.CPVal(i);
        vsim.CMVal(i*-1);
          vsim.Load();
          
          measure_im.vsim(vsim);
        measure_im.limit(im_limit);
        measure_im.sequence(seq_im);
        measure_im.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_im.Exec();
          break;
      case iopinkind:  
        //$if __TESTER_TYPE__ == 119 //for ND4
          if(irng==M8UA){i=10.5uA;} 
          else if(irng==M80UA){i=105uA;}
          else if(irng==M800UA){i=1.05mA;}
          else{i=42mA;}
        //$else          
        //  if(irng==M8UA || irng==M80UA || irng==M800UA){i=0.999mA;}
        //  else if(irng==M8MA){i=6mA;}
        //$endif
        vsim.Resc(MDC);
        vsim.MRng(irng);
        vsim.SRng(vrng);
        vsim.SVal(v);
        vsim.CPVal(i);
        vsim.CMVal(i*-1);
          vsim.Load();
          
          measure_im.vsim(vsim);
        measure_im.limit(im_limit);
        measure_im.sequence(seq_im);
        measure_im.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_im.Exec();
        break;

      case hsifpinkind:  
        //$if __TESTER_TYPE__ == 119 //for ND4
          if(irng==M8UA){i=20.0uA;} 
          else if(irng==M80UA){i=200uA;}
          else if(irng==M800UA){i=2.00mA;}
          else{i=42mA;}
        //$else          
        //  if(irng==M8UA || irng==M80UA || irng==M800UA){i=0.999mA;}
        //  else if(irng==M8MA){i=6mA;}
        //$endif
        vsim.Resc(MDC);
        vsim.MRng(irng);
        vsim.SRng(vrng);
        vsim.SVal(v);
        vsim.CPVal(i);
        vsim.CMVal(i*-1);
          vsim.Load();
          
          measure_im.vsim(vsim);
        measure_im.limit(im_limit);
        measure_im.sequence(seq_im);
        measure_im.Set();   waittime.time(1mS); waittime.PreExec();//for ND4 im_seq bug,20160427
        measure_im.Exec();
        break;        
      default: break;  
    }
       break;
    default: break;
  }
}
