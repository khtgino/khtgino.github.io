      if( tmp_chk1==1 )
       {
         sxmux_dec2_all[int_j]=read_temp_dec;
       	
         if( int(int_i/482)==0 ){ sxmux_dec2_p1[int_k]=read_temp_dec; int_k=int_k+1; if( sxmux_sel[int_j]==1 ){ sxmux_dec2_p1_s1[sxmux_dec2_p1_s1_cnt]=read_temp_dec; sxmux_dec2_p1_s1_cnt+=1; }else{ sxmux_dec2_p1_s2[sxmux_dec2_p1_s2_cnt]=read_temp_dec; sxmux_dec2_p1_s2_cnt+=1; } }
