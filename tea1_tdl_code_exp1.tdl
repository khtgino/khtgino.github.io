void compare_temp_gst(ARRAY<double> &pos_data1,ARRAY<double> &pos_hlimit,ARRAY<double> &pos_llimit, int &gs_temp_result)
{
  gs_temp_result=ary_mcmp(pos_data1,pos_hlimit,pos_llimit);

}
void compare_temp_gst(ARRAY<double> &pos_data1,ARRAY<double> &pos_data2,ARRAY<double> &pos_hlimit1,ARRAY<double> &pos_llimit1, int &gs_temp_result1, int &gs_temp_result2)
{
  gs_temp_result1=ary_mcmp(pos_data1,pos_hlimit1,pos_llimit1);
  gs_temp_result2=ary_mcmp(pos_data2,pos_hlimit1,pos_llimit1);

}
void compare_temp_gst(ARRAY<double> &pos_data1,ARRAY<double> &pos_data2,ARRAY<double> &pos_hlimit1,ARRAY<double> &pos_llimit1,ARRAY<double> &pos_hlimit2,ARRAY<double> &pos_llimit2, int &gs_temp_result1, int &gs_temp_result2)
{
  gs_temp_result1=ary_mcmp(pos_data1,pos_hlimit1,pos_llimit1);
  gs_temp_result2=ary_mcmp(pos_data2,pos_hlimit2,pos_llimit2);

}
void compare_temp_gst(ARRAY<double> &pos_data1,ARRAY<double> &pos_data2,ARRAY<double> &pos_hlimit1,ARRAY<double> &pos_llimit1,ARRAY<double> &pos_hlimit2,ARRAY<double> &pos_llimit2, int &gs_temp_result1)
{ int ttmp1,ttmp2;
  ttmp1=ary_mcmp(pos_data1,pos_hlimit1,pos_llimit1);
  ttmp2=ary_mcmp(pos_data2,pos_hlimit2,pos_llimit2);
  gs_temp_result1=ttmp1+ttmp2;
}
void compare_gs_0101_gst()
{
  int tmp_vh_result;
  int tmp_vl_result;

  ARRAY<double> gray_diff_tmp1(levelno*1*lcdpinno);
  ARRAY<double> gray_diff_tmp2(levelno*1*lcdpinno);

  //---------------------------------------------------------------------------
  //------< 0101 - 1-pair >------//
  //---------------------------------------------------------------------------

  tmp_vh_result=ary_mcmp(dev_vh_0101_d01_01,dev_gs0101vh_hlimit_165V,dev_gs0101vh_llimit_165V);
  tmp_vl_result=ary_mcmp(dev_vl_0101_d01_01,dev_gs0101vl_hlimit_165V,dev_gs0101vl_llimit_165V);
  
  ary_davg(dev_vh_0101_d01_01,lcdpinno,avg_pos_0101_d01_01);
  ary_dmax(dev_vh_0101_d01_01,lcdpinno,max_pos_0101_d01_01);
  ary_dmin(dev_vh_0101_d01_01,lcdpinno,min_pos_0101_d01_01);

  ary_davg(dev_vl_0101_d01_01,lcdpinno,avg_neg_0101_d01_01);
  ary_dmax(dev_vl_0101_d01_01,lcdpinno,max_neg_0101_d01_01);
  ary_dmin(dev_vl_0101_d01_01,lcdpinno,min_neg_0101_d01_01);

  abs1_pos_0101_d01_01=avg_pos_0101_d01_01-max_pos_0101_d01_01;
  abs2_pos_0101_d01_01=avg_pos_0101_d01_01-min_pos_0101_d01_01;
  abs1_neg_0101_d01_01=avg_neg_0101_d01_01-max_neg_0101_d01_01;
  abs2_neg_0101_d01_01=avg_neg_0101_d01_01-min_neg_0101_d01_01;
 
  gray_diff_tmp1=dev_vh_0101_d01_01-dev_vl_0101_d01_01;

  ary_davg(gray_diff_tmp1,lcdpinno,avg_rms_0101_d01_01);
  ary_dmax(gray_diff_tmp1,lcdpinno,max_rms_0101_d01_01);
  ary_dmin(gray_diff_tmp1,lcdpinno,min_rms_0101_d01_01);

  rms_vh_0101_d01_01=avg_rms_0101_d01_01-max_rms_0101_d01_01;
  rms_vl_0101_d01_01=avg_rms_0101_d01_01-min_rms_0101_d01_01;
 
  ary_part(dev_vh_0101_d01_01,0*lcdpinno,lcdpinno*levelno-lcdpinno,ideal_diff_vh_v0_0101_d01_01);
  ary_part(dev_vh_0101_d01_01,1*lcdpinno,lcdpinno*levelno-lcdpinno,ideal_diff_vh_v1_0101_d01_01);
  ary_part(dev_vl_0101_d01_01,0*lcdpinno,lcdpinno*levelno-lcdpinno,ideal_diff_vl_v0_0101_d01_01);
  ary_part(dev_vl_0101_d01_01,1*lcdpinno,lcdpinno*levelno-lcdpinno,ideal_diff_vl_v1_0101_d01_01);

  ary_part(gray_diff_d01_01,0*lcdpinno,lcdpinno*levelno-lcdpinno,rms_diff_v0_0101_d01_01);
  ary_part(gray_diff_d01_01,1*lcdpinno,lcdpinno*levelno-lcdpinno,rms_diff_v1_0101_d01_01);

  gs0101_all_result_01[0]=tmp_vh_result+tmp_vl_result;
  gs0101_abs_result_01[0]=ary_mcmp(abs1_pos_0101_d01_01,DVABShlimit,DVABSllimit)+ary_mcmp(abs1_neg_0101_d01_01,DVABShlimit,DVABSllimit);
  gs0101_abs_result_01[0]=ary_mcmp(abs2_pos_0101_d01_01,DVABShlimit,DVABSllimit)+ary_mcmp(abs2_neg_0101_d01_01,DVABShlimit,DVABSllimit)+gs0101_abs_result_01[0];
  gs0101_rms_result_01[0]=ary_mcmp(rms_vh_0101_d01_01,DVRMShlimit,DVRMSllimit)+ary_mcmp(rms_vl_0101_d01_01,DVRMShlimit,DVRMSllimit);
  gs0101_all_diff_result_01[0]=ary_mcmp(ideal_diff_vh_v0_0101_d01_01,ideal_diff_vh_v1_0101_d01_01,0)+ary_mcmp(ideal_diff_vl_v1_0101_d01_01,ideal_diff_vl_v0_0101_d01_01,0);
  gs0101_rms_diff_result_01[0]=ary_mcmp(rms_diff_v0_0101_d01_01,rms_diff_v1_0101_d01_01,0);

  //---------------------------------------------------------------------------

}
