    //pat(run);  
  lcdtmu_status = lcd_tmu.sGet_PinVal(1, ALL_LCD, slew_3_vol_time, slew_3_voh_time); 
//sr(off);    

  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  patf("fn01a1_slew_rate_04_pol_0_data_10_pwrc_a_000_25_0925.lpa"); //LH --> HL
 
  lcd_tmu.event(6200);
  //lcd_tmu.sampling_rate(S32NS);
  lcd_tmu.sampling_rate(AUTO_RNG);
  lcd_tmu.Load();
  lcd_tmu.Start();
    //pat(run);  
  lcdtmu_status = lcd_tmu.sGet_PinVal(1, ALL_LCD, slew_4_vol_time, slew_4_voh_time); 

//=============================================================================
  TSTime("SLEW TMU0 Test");

  //sr(off);
  POWER_OFF_FUNC1();

//=============================================================================
  for( int_i=0 ; int_i<lcdpinno ; int_i+=2 )
  {
  	
     //if( (int_i%2)==0 ){ rise_voh_time[int_i]=slew_1_voh_time[int_i]-slew_1_vol_time[int_i]; }
     //if( (int_i%2)==1 ){ rise_voh_time[int_i]=slew_3_voh_time[int_i]-slew_3_vol_time[int_i]; }
     //if( (int_i%2)==0 ){ rise_vol_time[int_i]=slew_4_voh_time[int_i]-slew_4_vol_time[int_i]; }
     //if( (int_i%2)==1 ){ rise_vol_time[int_i]=slew_2_voh_time[int_i]-slew_2_vol_time[int_i]; }
     //
     //if( (int_i%2)==0 ){ fall_voh_time[int_i]=slew_2_vol_time[int_i]-slew_2_voh_time[int_i]; }
     //if( (int_i%2)==1 ){ fall_voh_time[int_i]=slew_4_vol_time[int_i]-slew_4_voh_time[int_i]; }
     //if( (int_i%2)==0 ){ fall_vol_time[int_i]=slew_3_vol_time[int_i]-slew_3_voh_time[int_i]; }
     //if( (int_i%2)==1 ){ fall_vol_time[int_i]=slew_1_vol_time[int_i]-slew_1_voh_time[int_i]; }

     odd_p_rise_time[int_i/2]=slew_1_voh_time[int_i+0]-slew_1_vol_time[int_i+0];
     evn_p_rise_time[int_i/2]=slew_3_voh_time[int_i+1]-slew_3_vol_time[int_i+1];
     odd_n_rise_time[int_i/2]=slew_4_voh_time[int_i+0]-slew_4_vol_time[int_i+0];
     evn_n_rise_time[int_i/2]=slew_2_voh_time[int_i+1]-slew_2_vol_time[int_i+1];

     odd_p_fall_time[int_i/2]=slew_2_vol_time[int_i+0]-slew_2_voh_time[int_i+0];
     evn_p_fall_time[int_i/2]=slew_4_vol_time[int_i+1]-slew_4_voh_time[int_i+1];
     odd_n_fall_time[int_i/2]=slew_3_vol_time[int_i+0]-slew_3_voh_time[int_i+0];
     evn_n_fall_time[int_i/2]=slew_1_vol_time[int_i+1]-slew_1_voh_time[int_i+1];
  	
  }

//odd_p_rise_time
//odd_p_fall_time
//odd_n_rise_time
//odd_n_fall_time
//evn_p_rise_time
//evn_p_fall_time
//evn_n_rise_time
//evn_n_fall_time

//=============================================================================
  odd_p_rise_time_max=ary_max(odd_p_rise_time)*1000000; // cout<<"odd_p_rise_time_max="<<odd_p_rise_time_max<<"\n";
  evn_p_rise_time_max=ary_max(evn_p_rise_time)*1000000; // cout<<"evn_p_rise_time_max="<<evn_p_rise_time_max<<"\n";
  odd_n_rise_time_max=ary_max(odd_n_rise_time)*1000000; // cout<<"odd_n_rise_time_max="<<odd_n_rise_time_max<<"\n";
  evn_n_rise_time_max=ary_max(evn_n_rise_time)*1000000; // cout<<"evn_n_rise_time_max="<<evn_n_rise_time_max<<"\n";
  odd_p_fall_time_max=ary_max(odd_p_fall_time)*1000000; // cout<<"odd_p_fall_time_max="<<odd_p_fall_time_max<<"\n";
  evn_p_fall_time_max=ary_max(evn_p_fall_time)*1000000; // cout<<"evn_p_fall_time_max="<<evn_p_fall_time_max<<"\n";
  odd_n_fall_time_max=ary_max(odd_n_fall_time)*1000000; // cout<<"odd_n_fall_time_max="<<odd_n_fall_time_max<<"\n";
  evn_n_fall_time_max=ary_max(evn_n_fall_time)*1000000; // cout<<"evn_n_fall_time_max="<<evn_n_fall_time_max<<"\n";

  odd_p_rise_time_min=ary_min(odd_p_rise_time)*1000000; // cout<<"odd_p_rise_time_min="<<odd_p_rise_time_min<<"\n";
  evn_p_rise_time_min=ary_min(evn_p_rise_time)*1000000; // cout<<"evn_p_rise_time_min="<<evn_p_rise_time_min<<"\n";
  odd_n_rise_time_min=ary_min(odd_n_rise_time)*1000000; // cout<<"odd_n_rise_time_min="<<odd_n_rise_time_min<<"\n";
  evn_n_rise_time_min=ary_min(evn_n_rise_time)*1000000; // cout<<"evn_n_rise_time_min="<<evn_n_rise_time_min<<"\n";
  odd_p_fall_time_min=ary_min(odd_p_fall_time)*1000000; // cout<<"odd_p_fall_time_min="<<odd_p_fall_time_min<<"\n";
  evn_p_fall_time_min=ary_min(evn_p_fall_time)*1000000; // cout<<"evn_p_fall_time_min="<<evn_p_fall_time_min<<"\n";
  odd_n_fall_time_min=ary_min(odd_n_fall_time)*1000000; // cout<<"odd_n_fall_time_min="<<odd_n_fall_time_min<<"\n";
  evn_n_fall_time_min=ary_min(evn_n_fall_time)*1000000; // cout<<"evn_n_fall_time_min="<<evn_n_fall_time_min<<"\n";

/*====================== Judge ======================*/
  tno( 1); cat(22); dcmnt("ODD POS Slew Rate Rising Max-Min(uS)"); judge(odd_p_rise_time_max-odd_p_rise_time_min , 0.0 , 1.90 );      
  tno( 2); cat(22); dcmnt("ODD POS Slew Rate Rising MAX(uS)");     judge(odd_p_rise_time_max                     , 1.5 , 5.65 );
  tno( 3); cat(22); dcmnt("ODD POS Slew Rate Rising MIN(uS)");     judge(odd_p_rise_time_min                     , 1.5 , 4.65 );
  tno( 4); cat(22); dcmnt("EVN POS Slew Rate Rising Max-Min(uS)"); judge(evn_p_rise_time_max-evn_p_rise_time_min , 0.0 , 1.90 );      
  tno( 5); cat(22); dcmnt("EVN POS Slew Rate Rising MAX(uS)");     judge(evn_p_rise_time_max                     , 1.5 , 5.65 );
  tno( 6); cat(22); dcmnt("EVN POS Slew Rate Rising MIN(uS)");     judge(evn_p_rise_time_min                     , 1.5 , 4.65 );
  tno(11); cat(22); dcmnt("ODD POS Slew Rate Falling Max-Min(uS)");judge(odd_p_fall_time_max-odd_p_fall_time_min , 0.0 , 1.50 );      
  tno(12); cat(22); dcmnt("ODD POS Slew Rate Falling MAX(uS)");    judge(odd_p_fall_time_max                     , 1.5 , 5.65 );
  tno(13); cat(22); dcmnt("ODD POS Slew Rate Falling MIN(uS)");    judge(odd_p_fall_time_min                     , 1.5 , 4.65 );
  tno(14); cat(22); dcmnt("EVN POS Slew Rate Falling Max-Min(uS)");judge(evn_p_fall_time_max-evn_p_fall_time_min , 0.0 , 1.50 );      
  tno(15); cat(22); dcmnt("EVN POS Slew Rate Falling MAX(uS)");    judge(evn_p_fall_time_max                     , 1.5 , 5.65 );
  tno(16); cat(22); dcmnt("EVN POS Slew Rate Falling MIN(uS)");    judge(evn_p_fall_time_min                     , 1.5 , 4.65 );

  tno(21); cat(22); dcmnt("ODD NEG Slew Rate Rising Max-Min(uS)"); judge(odd_n_rise_time_max-odd_n_rise_time_min , 0.0 , 1.50 );    
  tno(22); cat(22); dcmnt("ODD NEG Slew Rate Rising MAX(uS)");     judge(odd_n_rise_time_max                     , 1.5 , 5.65 );
  tno(23); cat(22); dcmnt("ODD NEG Slew Rate Rising MIN(uS)");     judge(odd_n_rise_time_min                     , 1.5 , 4.65 );
  tno(24); cat(22); dcmnt("EVN NEG Slew Rate Rising Max-Min(uS)"); judge(evn_n_rise_time_max-evn_n_rise_time_min , 0.0 , 1.50 );    
  tno(25); cat(22); dcmnt("EVN NEG Slew Rate Rising MAX(uS)");     judge(evn_n_rise_time_max                     , 1.5 , 5.65 );
  tno(26); cat(22); dcmnt("EVN NEG Slew Rate Rising MIN(uS)");     judge(evn_n_rise_time_min                     , 1.5 , 4.65 );
  tno(31); cat(22); dcmnt("ODD NEG Slew Rate Falling Max-Min(uS)");judge(odd_n_fall_time_max-odd_n_fall_time_min , 0.0 , 1.50 );    
  tno(32); cat(22); dcmnt("ODD NEG Slew Rate Falling MAX(uS)");    judge(odd_n_fall_time_max                     , 1.5 , 5.65 );
  tno(33); cat(22); dcmnt("ODD NEG Slew Rate Falling MIN(uS)");    judge(odd_n_fall_time_min                     , 1.5 , 4.65 );
  tno(34); cat(22); dcmnt("EVN NEG Slew Rate Falling Max-Min(uS)");judge(evn_n_fall_time_max-evn_n_fall_time_min , 0.0 , 1.50 );    
  tno(35); cat(22); dcmnt("EVN NEG Slew Rate Falling MAX(uS)");    judge(evn_n_fall_time_max                     , 1.5 , 5.65 );
  tno(36); cat(22); dcmnt("EVN NEG Slew Rate Falling MIN(uS)");    judge(evn_n_fall_time_min                     , 1.5 , 4.65 );
  
//===========================================================================================

  sr(off);
  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("SLEW calc Test");
return 0;
  
}


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
void touch_read_data(int &addr_line , DPIN &tmp_pin, int &data_d1)
{
   ARRAY<int> read_code(8);
   
   read_code[0]=(measure_ft.Get_Pinfail(   1 ,   addr_line*8+7  ,  tmp_pin   )-2)*(-1);
   read_code[1]=(measure_ft.Get_Pinfail(   1 ,   addr_line*8+6  ,  tmp_pin   )-2)*(-1);
   read_code[2]=(measure_ft.Get_Pinfail(   1 ,   addr_line*8+5  ,  tmp_pin   )-2)*(-1);
   read_code[3]=(measure_ft.Get_Pinfail(   1 ,   addr_line*8+4  ,  tmp_pin   )-2)*(-1);
   read_code[4]=(measure_ft.Get_Pinfail(   1 ,   addr_line*8+3  ,  tmp_pin   )-2)*(-1);
   read_code[5]=(measure_ft.Get_Pinfail(   1 ,   addr_line*8+2  ,  tmp_pin   )-2)*(-1);
   read_code[6]=(measure_ft.Get_Pinfail(   1 ,   addr_line*8+1  ,  tmp_pin   )-2)*(-1);
   read_code[7]=(measure_ft.Get_Pinfail(   1 ,   addr_line*8+0  ,  tmp_pin   )-2)*(-1);

   data_d1=bin2dec(read_code);
}
int touch_spi_test()
{
  int tmp_test_num=0;

  testno=74000;

  cw1_num[ 0]=1;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 40MHz;

  rate1 = (1/freq)*1;
  rate2 = (1/freq)*1;
  rate3 = (1/freq)*1;
  rate4 = (1/freq)*1;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =100mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.6;
  vol_in[1]  = (1.8V)*0.6;
  voh_in[2]  = 1.2V;
  vol_in[2]  = 1.2V;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(OFF,rate1,rate2,rate3,rate4);

  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(TOURCH_GP01);
  rly=on; fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

//=========================== FIXH/L Setting ======================================================
  rly=on;  fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

  rly=off; fmt=OPEN; vih=1.75V; vil=vil_in[2]; pin(DPIN_PAD_LOCK);
  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_EN);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppcp; rng=R10V; scan_mode=STEP_INC;scan_step=levelno*2; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-0uA; iol=0uA; vt1=0V;vt2=0V;
  lcdoption=NONE;

  lcdstrb1 =rate1/2;
  lcdstrb2 =rate2/2;
  lcdstrb3 =rate3/2;
  lcddigit1=rate1/2;
  lcddigit2=rate2/2;
  lcddigit3=rate3/2;

  lcdpin(ALL_LCD);
  
  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================
  rly=dir; vi=ifvm; i=-1mA;  irng=R3MA;   v=20V;  vrng=M40V; i=-100uA; uvipin(VS_PAD_TEST_VREFN    ); 
  //sr(on);
  POWER_ON_FUNC1();
 
  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;

  wait(2mS);

  tno(tmp_test_num++); cat(74); dcmnt("TOUCH SPI SINGLE CRC TEST");
  
  patf("fn01a1_tp_cp06_spi_single_250908_nor_nd4.lpa");
  pjudge(result);

  tno(tmp_test_num++); cat(74); dcmnt("TOUCH SPI DUAL CRC TEST");
  
  patf("fn01a1_tp_cp07_spi_dual_250908_nor_nd4.lpa");
  pjudge(result);
//===========================================================================================
  //rly=off; term=off; fmt=OPEN; vi=ifvm; i=-10uA; irng=R800UA; v=6.0V; vrng=M8V; pin(DPIN_PAD_TEST_VREFN); judge(vm, -1.0V, -0.2V, V);
  //rly=dir; vi=ifvm; i=-1mA;  irng=R3MA;   v=20V;  vrng=M40V; i=10uA; uvipin(VS_PAD_TEST_VREFN    ); judge(vm, -20.0V, 20.0V, V);

//===========================================================================================
    dfm.type(DFM_FAILSTORE);
    dfm.begin(0);
    dfm.end(0x3ffffdf);
    dfm.fcnt(4095);
    dfm.Load();
    
  pat(stop);
  //sr(off);
  POWER_OFF_FUNC1();

//  /*************************  HSIF  ***********************************/
////dutoffest.pinlist(ALL_IOPIN);
////dutoffest.timing(0nS);
////dutoffest.Load();
////dutoffest.ClearAll();
//
//  hsif_all_t.kind(OPEN);          
//  hsif_all_t.Load();              
//
//  rate.hsif_rate(OFF);
//  rate.Load();
//
//  hsif_tshift.shift(0pS);
//  hsif_tshift.Load();
//
////HSIF_CTRL.trig(OFF);
////HSIF_CTRL.Load();  

  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("Touch SPI Test  ");

  return 0;
}

