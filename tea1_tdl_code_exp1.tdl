void uvipin(VSPIN &vspin)
{  
  if(dpsindx==para)
  {
    dpsvsim.pin(vspin);
    dpsvsim.SRng(vrng);
    dpsvsim.SVal(v);
    dpsvsim.MRng(irng);
    dpsvsim.CPVal(i);
    dpsvsim.CMVal(i*-1);
    dpsvsim.Load();
  }    
  else
  {
    switch(vi)
    {
      case vfim:
        if(rly==off) vrng=OPEN;
            
        dpsvsim.pin(vspin);
        dpsvsim.SRng(vrng);
        dpsvsim.SVal(v);
        dpsvsim.MRng(irng);
        dpsvsim.CPVal(i);
        dpsvsim.CMVal(i*-1);
        dpsvsim.Load();
        break;
      case vfvm:
      case ifvm:
        //$if __TESTER_TYPE__ == 119 //for ND4
        if(rly==off) vrng=OPEN;
        dpsisvm.pin(vspin);
        dpsisvm.SRng(irng);
        dpsisvm.SVal(i);
        dpsisvm.MRng(vrng);
        dpsisvm.CPVal(v);
        dpsisvm.CMVal(v*-1);
        dpsisvm.Load();
        //$else    //not ND4    
        //i=250mA; irng=M20V; v=-2V; vrng=R20V;//for OS test  
        //if(rly==off) vrng=OPEN;          
        //dpsvsvm.pin(vspin);
        //dpsvsvm.SRng(vrng);
        //dpsvsvm.SVal(v);
        //dpsvsvm.MRng(irng);
        //dpsvsvm.Load();        
        //$endif
        break;
      default:  break;
    }
  }
  chkind=vspinkind;
}

