void t(int &a)
{
  indx=a;
}
void edge(Seconds &t1)
{
  signal_timing.wavekind(indx,fmt);
  
  if(rly==off) signal_timing.kind(OPEN);
  else signal_timing.kind(iokindsel);
  
  if(iokindsel==IN) 
  {
    if(option==pinmux) signal_timing.option(DRONINIT,PMUX,PTMUX); 
    if(option==ptmux) signal_timing.option(DRONINIT,PTMUX); 
    if(option!=pinmux&&option!=ptmux) signal_timing.option(option);
  } 
  else if(iokindsel==OUT)
  {
    if(term==on)
    {
      if(option==pinmux) signal_timing.option(PMUX,PTMUX,TERM); 
      if(option==ptmux) signal_timing.option(PTMUX,TERM); 
      if(option!=pinmux&&option!=ptmux) 
      if(option!=NONE) signal_timing.option(TERM);
      else signal_timing.option(TERM);
    }
    if(term==off)
    {
      if(option==pinmux) signal_timing.option(PMUX,PTMUX); 
      if(option==ptmux) signal_timing.option(PTMUX); 
      if(option!=pinmux&&option!=ptmux) signal_timing.option(option);
    }
  }
  else
  {
    if(term==on)
    {
      if(option==pinmux) signal_timing.option(DRONINIT,PMUX,PTMUX,TERM); 
      if(option==ptmux) signal_timing.option(DRONINIT,PTMUX,TERM); 
      if(option!=pinmux&&option!=ptmux) 
      if(option!=NONE) signal_timing.option(TERM);
      else signal_timing.option(TERM);
    }
    if(term==off)
    {
      if(option==pinmux) signal_timing.option(DRONINIT,PMUX,PTMUX); 
      if(option==ptmux) signal_timing.option(DRONINIT,PTMUX); 
      if(option!=pinmux&&option!=ptmux) signal_timing.option(option);
    }
  }
  
  signal_timing.timing(indx,T1,t1);
  signal_timing.timing(indx,STBL,strb);
  signal_timing.timing(indx,DREL,drel);
  signal_timing.timing(indx,DRET,dret);

  kindsel[0]=1;
}
void edge(Seconds &t1,Seconds &t2)
{
  
  signal_timing.wavekind(indx,fmt);
  
  if(rly==off) signal_timing.kind(OPEN);
  else signal_timing.kind(iokindsel);
  
  if(iokindsel==IN) 
  {
    if(option==pinmux) signal_timing.option(DRONINIT,PMUX,PTMUX); 
    if(option==ptmux) signal_timing.option(DRONINIT,PTMUX); 
    if(option!=pinmux&&option!=ptmux) signal_timing.option(DRONINIT,option);
  }
  else if(iokindsel==OUT)
  {
    if(term==on)
    {
      if(option==pinmux) signal_timing.option(PMUX,PTMUX,TERM); 
      if(option==ptmux) signal_timing.option(PTMUX,TERM); 
      if(option!=pinmux&&option!=ptmux) 
      if(option!=NONE) signal_timing.option(TERM);
      else signal_timing.option(TERM);
    }
    if(term==off)
    {
      if(option==pinmux) signal_timing.option(PMUX,PTMUX); 
      if(option==ptmux) signal_timing.option(PTMUX); 
      if(option!=pinmux&&option!=ptmux) signal_timing.option(option);
    }
  }
  else 
  {
    if(term==on)
    {
      if(option==pinmux) signal_timing.option(DRONINIT,PMUX,PTMUX,TERM); 
      if(option==ptmux) signal_timing.option(DRONINIT,PTMUX,TERM); 
      if(option!=pinmux&&option!=ptmux) 
      if(option!=NONE) signal_timing.option(DRONINIT,option,TERM);
      else signal_timing.option(DRONINIT,TERM);
    }
    if(term==off)
    {
      if(option==pinmux) signal_timing.option(DRONINIT,PMUX,PTMUX); 
      if(option==ptmux) signal_timing.option(DRONINIT,PTMUX); 
      if(option!=pinmux&&option!=ptmux) signal_timing.option(DRONINIT,option);
    }
  }  
  if(option==ptmux)
  {
  signal_timing.timing(indx,T1,t1);
  signal_timing.timing(indx,T3,t2);
  signal_timing.timing(indx,STBL,strb);
  signal_timing.timing(indx,STBT,strt);
  signal_timing.timing(indx,DREL,drel);
  signal_timing.timing(indx,DRET,dret);
  }
  else
  {
  signal_timing.timing(indx,T1,t1);
  signal_timing.timing(indx,T2,t2);
  signal_timing.timing(indx,STBL,strb);
  signal_timing.timing(indx,DREL,drel);
  signal_timing.timing(indx,DRET,dret);
  }
  kindsel[0]=1;
}
void edge(Seconds &t1,Seconds &t2,Seconds &t3)
{
  signal_timing.wavekind(indx,fmt);
  
  if(rly==off) signal_timing.kind(OPEN);
  else signal_timing.kind(iokindsel);
  
  if(iokindsel==IN) 
  {
    if(option==pinmux) signal_timing.option(DRONINIT,PMUX,PTMUX); 
    if(option==ptmux) signal_timing.option(DRONINIT,PTMUX); 
    if(option!=pinmux&&option!=ptmux) signal_timing.option(option);
  }
  else if(iokindsel==OUT)
  {
    if(term==on)
    {
      if(option==pinmux) signal_timing.option(PMUX,PTMUX,TERM); 
      if(option==ptmux) signal_timing.option(PTMUX,TERM); 
      if(option!=pinmux&&option!=ptmux) 
      if(option!=NONE) signal_timing.option(TERM);
      else signal_timing.option(TERM);
    }
    if(term==off)
    {
      if(option==pinmux) signal_timing.option(PMUX,PTMUX); 
      if(option==ptmux) signal_timing.option(PTMUX); 
      if(option!=pinmux&&option!=ptmux) signal_timing.option(option);
    }
  }
  else 
  {
    if(term==on)
    {
      if(option==pinmux) signal_timing.option(DRONINIT,PMUX,PTMUX,TERM,IL); 
      if(option==ptmux) signal_timing.option(DRONINIT,PTMUX,TERM,IL); 
      if(option!=pinmux&&option!=ptmux) 
      if(option!=NONE) signal_timing.option(option,TERM,IL);
      else signal_timing.option(TERM,IL);
    }
    if(term==off)
    {
      if(option==pinmux) signal_timing.option(DRONINIT,PMUX,PTMUX); 
      if(option==ptmux) signal_timing.option(DRONINIT,PTMUX); 
      if(option!=pinmux&&option!=ptmux) signal_timing.option(option);
    }
  }
  
  signal_timing.timing(indx,T1,t1);
  signal_timing.timing(indx,T2,t2);
  signal_timing.timing(indx,T3,t3);
  signal_timing.timing(indx,STBL,strb);
  signal_timing.timing(indx,STBT,strt);
  signal_timing.timing(indx,DREL,drel);
  signal_timing.timing(indx,DRET,dret);
  kindsel[0]=1;
}
void edge(Seconds &t1,Seconds &t2,Seconds &t3,Seconds &t4)
{
  signal_timing.wavekind(0,fmt);
  
  if(iokindsel==OUT)
  {
  if(option==ptmux) signal_timing.option(PTMUX); 
  if(option==pinmux) signal_timing.option(PMUX,PTMUX); 
  if(option!=pinmux&&option!=ptmux) signal_timing.option(option);
  }
  else
  {
  if(option==ptmux) signal_timing.option(DRONINIT,PTMUX); 
  if(option==pinmux) signal_timing.option(DRONINIT,PMUX,PTMUX); 
  if(option!=pinmux&&option!=ptmux) signal_timing.option(option);
  }
   
  if(rly==off) signal_timing.kind(OPEN);
  else signal_timing.kind(iokindsel);
  signal_timing.timing(indx,T1,t1);
  signal_timing.timing(indx,T2,t2);
  signal_timing.timing(indx,T3,t3);
  signal_timing.timing(indx,T4,t4);
  signal_timing.timing(indx,STBL,strb);
  signal_timing.timing(indx,STBT,strt);
  signal_timing.timing(indx,DREL,drel);
  signal_timing.timing(indx,DRET,dret);

  kindsel[0]=1;
}
void pin(DPIN &dpin)
{
  if(kindsel[0]==1)
  {
    signal_timing.pinlist(dpin);
    signal_timing.Load();
    kindsel[0]=0;  
  }
  else 
  {
    if(fmt==FIXH||fmt==FIXL) 
    {
    signal_timing.pinlist(dpin);
    signal_timing.kind(IN);
    signal_timing.wavekind(0,fmt);
    signal_timing.option(NONE);
    signal_timing.Load();
    
    }
    if(fmt==OPEN)
    {
    signal_timing.pinlist(dpin);
    signal_timing.kind(OPEN);
    signal_timing.Load();
    }
    signal_level.pinlist(dpin);
    signal_level.vt(vt);
    signal_level.vih(vih);
    signal_level.vil(vil);
    signal_level.voh(voh);
    signal_level.vol(vol);
    signal_level.ilh(ilh);
    signal_level.ill(ill);
    signal_level.Load();
  }
  measure_im.pinlist(dpin);
  measure_vm.pinlist(dpin);
  measure_freq.pinlist(dpin);
  measure_period.pin(dpin);

  chkind=iopinkind;
}
void pin(DPIN &dpin1,DPIN &dpin2)
{
  if(kindsel[0]==1)
  {
    signal_timing.pinlist(dpin1,dpin2);
    signal_timing.Load();  
    kindsel[0]=0;  
  }
  else 
  {
    if(fmt==FIXH||fmt==FIXL) 
    {
    signal_timing.pinlist(dpin1,dpin2);
    signal_timing.kind(IN);
    signal_timing.wavekind(0,fmt);
    signal_timing.option(NONE);
    signal_timing.Load();
    }
    if(fmt==OPEN)
    {
      signal_timing.pinlist(dpin1,dpin2);
      signal_timing.kind(OPEN);
      signal_timing.Load();
    }
    signal_level.pinlist(dpin1,dpin2);
    signal_level.vih(vih);
    signal_level.vil(vil);
    signal_level.voh(voh);
    signal_level.vol(vol);
    signal_level.ilh(ilh);
    signal_level.ill(ill);
    signal_level.Load();
  }
  measure_im.pinlist(dpin1,dpin2);
  measure_vm.pinlist(dpin1,dpin2);
  measure_freq.pinlist(dpin1,dpin2);
  measure_period.pin(dpin1,dpin2);
  chkind=iopinkind;
}
