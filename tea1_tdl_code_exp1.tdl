  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 40MHz;

  rate1 = (1/freq)*1;
  rate2 = (1/freq)*1;
  rate3 = (1/freq)*1;
  rate4 = (1/freq)*1;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.5;
  vol_in[1]  = (1.8V)*0.5;
  voh_in[2]  = 1.2V;
  vol_in[2]  = 1.2V;
  
  Volts sine_vt=2.5V;

  //ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(OFF,rate1,rate2,rate3,rate4);

  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(TOURCH_GP01);
  rly=on; fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

//=========================== FIXH/L Setting ======================================================
  rly=on;  fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

  rly=off; fmt=OPEN; vih=1.75V; vil=vil_in[2]; pin(DPIN_PAD_LOCK);
  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IN; t(1); edge(rate1*0); pin(DPIN_PAD_XON);
  rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IN; t(1); edge(rate1*0); pin(DPIN_PAD_WAKE);

  rly=off; fmt=OPEN; option=NONE; pin(GRID_02);

  rly=on;  fmt=FIXH; pin(DPIN_PAD_XON);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_WAKE);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_STB);

  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_08);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_09);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_10);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_11);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_12);
//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=off; mode=ppdz; rng=R10V; scan_mode=STEP_INC;scan_step=1; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-50uA; iol=50uA; vt1=0V;vt2=0V;
  lcdoption=NONE; lcdvoh= 0.9V;lcdvol= 0.9V;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate2/2;
  lcdstrb3 =rate3/2;
  lcddigit1=rate1/2;
  lcddigit2=rate2/2;
  lcddigit3=rate3/2;

  lcdpin(ALL_LCDPIN);
     
  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=STEP_INC;scan_step=6; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-0uA; iol=0uA; vt1=0V;vt2=0V;
  lcdoption=NONE; lcdvoh= 2.4V+0.15V;lcdvol= 2.4V-0.15V;
         
  lcdpin(ALL_TX_PIN);

  mode=ppcp;
//================================================================================================
  ofstream adc_afe_pd_f1(datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-afepd-data.asc", ios::app); 

  ExDMEM exdmem;
  long long int dmem_cnt_1,dmem_cnt_2;
  ARRAY<int> afe_pd_ary_data1(482*8*1);

  ARRAY<int> afe_pd_dec1_all(482*1);
  ARRAY<int> afe_pd_dec2_all(482*1/2);

  ARRAY<int> afe_pd_dec2_p1(482/2-3);
  ARRAY<int> afe_pd_dec2_p2(482/2-3);
  ARRAY<int> afe_pd_dec2_p3(482/2-3);
  ARRAY<int> afe_pd_dec2_p4(482/2-3);
                                  
   ARRAY<int> read_dmem_bin(8);   
   int    read_temp_dec;          
   string read_temp_hex;
   int    tmp_chk1,tmp_ckh2;
   
   double afe_pd_p1_max,afe_pd_p1_min,afe_pd_p1_avg;
   double afe_pd_p2_max,afe_pd_p2_min,afe_pd_p2_avg;
   double afe_pd_p3_max,afe_pd_p3_min,afe_pd_p3_avg;
   double afe_pd_p4_max,afe_pd_p4_min,afe_pd_p4_avg;
   
   
  ARRAY<int> afe_pd_dec2_p1_odd(119);
  ARRAY<int> afe_pd_dec2_p1_evn(119);
   
//================================================================================================
  //sr(on);
  POWER_ON_FUNC1();

  patf("tp_cp10_afe_pd_chk_kaiser_check_20251120_nor_nd4_dmem.lpa");
    
  exdmem.pinlist(ADC_GROUP_01);
  exdmem.Load();
  exdmem.Start();

  meas(result,int_i);
  
  exdmem.Stop();
    
  dmem_cnt_2= exdmem.Get_AcquiredCount (1,1);
  //exdmem.Get_AcquiredData(1,ADC_GROUP_01,0,sxmux_ary_data1);
  exdmem.Get_AcquiredData(1,DPIN_PAD_SPI_MISO,0,MSB,8,afe_pd_dec1_all);

  exdmem.Disconnect();

  //afe_pd_dec1_all=cp_03_ideal_code;
//===========================================================================================

//===========================================================================================   
  adc_afe_pd_f1<<"------------------------------------------------------\n";
  adc_afe_pd_f1.width(3); adc_afe_pd_f1<<"======< X:"<<str_axis_x1<<" , Y:"<<str_axis_y1<<" > "<<test_chip_name<<"======\n";

   int_j=0;
   int_k=0;
   int pd_int01=0;
   for( int_i=0; int_i<(482*1) ; int_i+=2 )
   {
     tmp_chk1=0;
     read_temp_dec=afe_pd_dec1_all[int_i+0]*256+afe_pd_dec1_all[int_i+1];
     read_temp_hex=dec2hex(afe_pd_dec1_all[int_i+0])+dec2hex(afe_pd_dec1_all[int_i+1]);

      //if( (int_i%358)>=6   && (int_i%358)<=345 ){ tmp_chk1=1; }
      //if( (int_i%358)>=348 && (int_i%358)<=349 ){ tmp_chk1=1; }
      //
      
      if( int(int_i%482)>=6 ){ tmp_chk1=1; }
      
      if( (int_i%482)==0 ){ int_k=0; }
      
      if( tmp_chk1==1 )
       {
         afe_pd_dec2_all[int_j]=read_temp_dec;
         int_j=int_j+1;
       	
         if( int(int_i/482)==0 ){ afe_pd_dec2_p1[int_k]=read_temp_dec;
         	if( (int_k%2)==0 ){ afe_pd_dec2_p1_odd[pd_int01]=afe_pd_dec2_p1[int_k]; }
         	if( (int_k%2)==1 ){ afe_pd_dec2_p1_evn[pd_int01]=afe_pd_dec2_p1[int_k]; pd_int01=pd_int01+1; }
         	 int_k=int_k+1; }
         if( int(int_i/482)==1 ){ afe_pd_dec2_p2[int_k]=read_temp_dec; int_k=int_k+1; }
         if( int(int_i/482)==2 ){ afe_pd_dec2_p3[int_k]=read_temp_dec; int_k=int_k+1; }
         if( int(int_i/482)==3 ){ afe_pd_dec2_p4[int_k]=read_temp_dec; int_k=int_k+1; }
         
       }

         adc_afe_pd_f1.width(2); adc_afe_pd_f1<<"Block["<<int(int_i/482)<<"-";
         adc_afe_pd_f1.width(3); adc_afe_pd_f1<<(int_i%482)/2<<"] , Read R= ";
         adc_afe_pd_f1.width(6); adc_afe_pd_f1<<read_temp_dec<<", "<<read_temp_hex<<"\n";


   }
//================================================================================================


  afe_pd_p1_max=ary_max(afe_pd_dec2_p1_evn); afe_pd_p1_min=ary_min(afe_pd_dec2_p1_evn); afe_pd_p1_avg=ary_avg(afe_pd_dec2_p1_evn);
  afe_pd_p2_max=ary_max(afe_pd_dec2_p1_odd); afe_pd_p2_min=ary_min(afe_pd_dec2_p1_odd); afe_pd_p2_avg=ary_avg(afe_pd_dec2_p1_odd);
  //afe_pd_p3_max=ary_max(afe_pd_dec2_p3); afe_pd_p3_min=ary_min(afe_pd_dec2_p3); afe_pd_p3_avg=ary_avg(afe_pd_dec2_p3);
  //afe_pd_p4_max=ary_max(afe_pd_dec2_p4); afe_pd_p4_min=ary_min(afe_pd_dec2_p4); afe_pd_p4_avg=ary_avg(afe_pd_dec2_p4);
                                                                                          
  if( afe_pd_p1_avg ==0 ){ afe_pd_p1_avg=0.00001; }
  if( afe_pd_p2_avg ==0 ){ afe_pd_p2_avg=0.00001; }
  //if( afe_pd_p2_avg ==0 ){ afe_pd_p2_avg=0.00001; }
  //if( afe_pd_p2_avg ==0 ){ afe_pd_p2_avg=0.00001; }
  	
  adc_afe_pd_f1<<"TOUCH ADC AFE_PD_EVN MAX = "<<afe_pd_p1_max<<"\n";
  adc_afe_pd_f1<<"TOUCH ADC AFE_PD_EVN MIN = "<<afe_pd_p1_min<<"\n";
  adc_afe_pd_f1<<"TOUCH ADC AFE_PD_EVN AVG = "<<afe_pd_p1_avg<<"\n";
  adc_afe_pd_f1<<"TOUCH ADC AFE_PD_ODD MAX = "<<afe_pd_p2_max<<"\n";
  adc_afe_pd_f1<<"TOUCH ADC AFE_PD_ODD MIN = "<<afe_pd_p2_min<<"\n";
  adc_afe_pd_f1<<"TOUCH ADC AFE_PD_ODD AVG = "<<afe_pd_p2_avg<<"\n";

  adc_afe_pd_f1<<"TOUCH ADC AFE_PD_ALL MAX Ratio = "<<(afe_pd_p1_max-afe_pd_p1_avg)/afe_pd_p1_avg<<"\n";
  adc_afe_pd_f1<<"TOUCH ADC AFE_PD_ALL MIN Ratio = "<<(afe_pd_p1_avg-afe_pd_p1_min)/afe_pd_p1_avg<<"\n";
  adc_afe_pd_f1<<"TOUCH ADC AFE_PD_ALL MAX Ratio = "<<(afe_pd_p2_max-afe_pd_p2_avg)/afe_pd_p2_avg<<"\n";
  adc_afe_pd_f1<<"TOUCH ADC AFE_PD_ALL MIN Ratio = "<<(afe_pd_p2_avg-afe_pd_p2_min)/afe_pd_p2_avg<<"\n";

  tno(tmp_test_num++); cat(80); dcmnt("TOUCH ADC AFE_PD_EVN MAX");  judge( afe_pd_p1_max , 82.0 , 82.0 );
  tno(tmp_test_num++); cat(80); dcmnt("TOUCH ADC AFE_PD_EVN MIN");  judge( afe_pd_p1_min , 82.0 , 82.0 );
  tno(tmp_test_num++); cat(80); dcmnt("TOUCH ADC AFE_PD_ODD MIN");  judge( afe_pd_p2_min , 1000.0 , 16800.0 );
  //tno(tmp_test_num++); cat(80); dcmnt("TOUCH ADC AFE_PD_ALL-2 MIN");  judge( afe_pd_p2_min , 0 , 300 );
  //tno(tmp_test_num++); cat(80); dcmnt("TOUCH ADC AFE_PD_ALL-2 AVG");  judge( afe_pd_p2_avg , 0 , 300 );
  
  //tno(tmp_test_num++); cat(80); dcmnt("TOUCH ADC AFE_PD_ALL-1 MAX Ratio");  judge( (afe_pd_p1_max-afe_pd_p1_avg)/afe_pd_p1_avg , NONE , NONE );
  //tno(tmp_test_num++); cat(80); dcmnt("TOUCH ADC AFE_PD_ALL-1 MIN Ratio");  judge( (afe_pd_p1_avg-afe_pd_p1_min)/afe_pd_p1_avg , NONE , NONE );
  //tno(tmp_test_num++); cat(80); dcmnt("TOUCH ADC AFE_PD_ALL-2 MAX Ratio");  judge( (afe_pd_p2_max-afe_pd_p2_avg)/afe_pd_p2_avg , NONE , NONE );
  //tno(tmp_test_num++); cat(80); dcmnt("TOUCH ADC AFE_PD_ALL-2 MIN Ratio");  judge( (afe_pd_p2_avg-afe_pd_p2_min)/afe_pd_p2_avg , NONE , NONE );

//================================================================================================
  //adc_afe_pd_f1.close();
  //wait(1mS);
//===========================================================================================
  dfm.type(DFM_FAILSTORE);
  dfm.begin(0);
  dfm.end(0x3ffffdf);
  dfm.fcnt(4095);
  dfm.Load();
  
  pat(stop);
  //sr(off);
  POWER_OFF_FUNC1(); 
  
//  /*************************  HSIF  ***********************************/
////dutoffest.pinlist(ALL_IOPIN);
////dutoffest.timing(0nS);
////dutoffest.Load();
////dutoffest.ClearAll();
//
//  hsif_all_t.kind(OPEN);          
//  hsif_all_t.Load();              
//
//  rate.hsif_rate(OFF);
//  rate.Load();
//
//  hsif_tshift.shift(0pS);
//  hsif_tshift.Load();
//
////HSIF_CTRL.trig(OFF);
////HSIF_CTRL.Load();  

  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("Touch CP-10 AFE POWER DOWN Test ");

  return 0;
}

int touch_test01()
{
  cw1_num[ 0]=0;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 40MHz;

  rate1 = (1/freq)*1;
  rate2 = (1/freq)*1;
  rate3 = (1/10MHz)*1;
  rate4 = (1/freq)*1;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  Volts sine_vt=2.5V;
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(OFF,rate1,rate2,rate3,rate4);

  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(TOURCH_GP01);
  rly=on; fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

//=========================== FIXH/L Setting ======================================================
  rly=on;  fmt=NRZ1; option=NONE; iokindsel=IO; 
  t(1); edge(rate1*0); pin(TOURCH_GP01);
  t(2); edge(rate2*0); pin(TOURCH_GP01);
  t(3); edge(rate3*0); pin(TOURCH_GP01);
  t(4); edge(rate4*0); pin(TOURCH_GP01);

  rly=off; fmt=OPEN; vih=1.75V; vil=vil_in[2]; pin(DPIN_PAD_LOCK);
  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IN; t(1); edge(rate1*0); pin(DPIN_PAD_XON);
  rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IN; t(1); edge(rate1*0); pin(DPIN_PAD_WAKE);

  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=sine_vt; vol=sine_vt; pin(GRID_01);
  rly=on; fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(GRID_01);

  rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IN; t(1); edge(rate1*0); pin(DPIN_ALL_TEST_DIP_I);

  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_08);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_09);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_10);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_11);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_12);

  rly=on;  fmt=FIXH; pin(DPIN_PAD_XON);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_WAKE);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_STB);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=off; mode=ppdz; rng=R10V; scan_mode=STEP_INC;scan_step=1; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-0uA; iol=0uA; vt1=0V;vt2=0V;
  lcdoption=NONE; lcdvoh= 1.2V;lcdvol= 0.6V;
  
  lcdstrb1 =rate1-4nS;
  lcdstrb2 =rate2-4nS;
  lcdstrb3 =rate3-4nS;
  lcddigit1=rate1-4nS;
  lcddigit2=rate2-4nS;
  lcddigit3=rate3-4nS;

  lcdsamp.samp(1,lcddigit1);
  lcdsamp.samp(2,lcddigit2);
  lcdsamp.samp(3,lcddigit3);
  lcdsamp.samp(4,lcddigit4);
  lcdsamp.Load();
  
  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
        
  lcdpin(ALL_LCDPIN);
  
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=STEP_INC;scan_step=1; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-0uA; iol=0uA; vt1=0V;vt2=0V;
  lcdoption=NONE; lcdvoh= 1.2V;lcdvol= 0.6V;
  
  lcdstrb1 =rate1-4nS;
  lcdstrb2 =rate2-4nS;
  lcdstrb3 =rate3-4nS;
  lcddigit1=rate1-4nS;
  lcddigit2=rate2-4nS;
  lcddigit3=rate3-4nS;

  lcdsamp.samp(1,lcddigit1);
  lcdsamp.samp(2,lcddigit2);
  lcdsamp.samp(3,lcddigit3);
  lcdsamp.samp(4,lcddigit4);
  lcdsamp.Load();
  
  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
        
  lcdpin(ALL_LCD);
 
  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

  mode =ppcp;
//===========================================================================================
  ARRAY<double> tmp_ary_00(6);
  ARRAY<double> tmp_ary_01(6000);
  ARRAY<double> tmp_ary_02(6000);

  rly=on;  fmt=RZO; option=FREERUN; iokindsel=IN;  t(3); edge(rate3*0,rate3*0.5); pin(DPIN_PAD_TP_CLK);
  
  startadrn=0;
  stopadrn =2000; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();
  wait(6.0mS);
  
  FCLK.PreExec();
    
  patf("fn01a1_tp_cp01_txrx_adc_251001_org_nor_nd4_dmem.lpa");
  pat(run);
  

  wait(100mS);
  
  mode=ppdz;
  
  patf("mdgt_pat_01_exp2.lpa");

  for( int_i=0; int_i<6000;  int_i+=1 )
  {
  pat(run);
  calcstart(ALL_LCD_SOURCE1 , tmp_ary_00);
  tmp_ary_01[int_i]=tmp_ary_00[0];
  tmp_ary_02[int_i]=tmp_ary_00[1];
  
  }
  
  Plot_WS(tmp_ary_01,"tmp_ary_01");
  Plot_WS(tmp_ary_02,"tmp_ary_02");

  FCLK.PostExec();

  
//===========================================================================================
  //sr(off);
  POWER_OFF_FUNC1();

  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("GS_HRD 1 & 2-Pair Pattern Run                ");

  return 0;
}


int FLBL()
{
  if(   test_leakage_dut==3 ){ int_CurrentDut=3; }
  else{ int_CurrentDut=TESTDUT.Get_Dut(CURRENT); }
  int_FailDut=TESTDUT.Get_FailDut(CURRENT);
  
  if(dutno==1&&indx1_Category==0)
  {
    category.Num(int_CategoryNumber);
    category.dut(1);
    category.PostExec();
    indx1_Category=1;
  }
  
  if(dutno==2&&indx1_Category==0)
  {
    category.Num(int_CategoryNumber);
    category.dut(1);
    category.PostExec();
    if (int_FailDut==1||int_FailDut==3) {indx1_Category=1;}
  }
  
  if(dutno==2&&indx2_Category==0)
  {
    category.Num(int_CategoryNumber);
    category.dut(2);
    category.PostExec();
    if (int_FailDut==2||int_FailDut==3) {indx2_Category=1;}
  }
  if(int_CurrentDut==0) exit.branch(1);//no dut
  switch (int_CurrentDut-int_FailDut)
  {
    case 0: test_follow_chk=int_FailDut; exit.branch(1); break;
    case 1:
    case 2:  
    if(0==(int_FunctionKey & 0x0004)&&int_CategoryNumber!=9)//FK3 fail dut no reject  
    {
      CONTACT.Off(int_FailDut,EXCLUDE2,REF_WET);
      rejetindx=0;
    }
    else if(0==(int_FunctionKey & 0x0004)&&int_CategoryNumber==9) 
    {
      CONTACT.Off(int_FailDut,EXCLUDE,REF_WET);
      rejetindx=0;
    }
    case 3: exit.branch(0); break;
    default:
    break;
  }
  
  if(0!=(int_FunctionKey & 0x0004)&&vs_short!=1) //FK3 fail dut no reject  
  { test_follow_chk=0;
    if(int_FailDut==2||int_FailDut==3)
    {
      if(int_CategoryNumber!=DUT2_fail_bin[indx2_fail_bin-1]) 
      {
      DUT2_fail_bin[indx2_fail_bin]=int_CategoryNumber;
      indx2_fail_bin++;
      }
    }
    if(int_FailDut==1||int_FailDut==3)
    {
      if(int_CategoryNumber!=DUT1_fail_bin[indx1_fail_bin-1]) 
      {
      DUT1_fail_bin[indx1_fail_bin]=int_CategoryNumber;
      indx1_fail_bin++;
      }
    }
    if(int_CategoryNumber==2||int_CategoryNumber==3) exit.branch(1);
    else exit.branch(0);
    exit.branch(0);
  }

  exit.PostExec();
  return  ENABLE;
}

