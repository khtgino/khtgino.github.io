  lcdpin(ALL_LCDPIN);
  
//    //-----------------------
//    rly=dir; vi=vfim; v=0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
//    rly=dir; vi=vfim; v=0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);
//    rly=dir; vi=vfim; v=0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_PAVDD   );
//    rly=dir; vi=vfim; v=0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH1    );
//    rly=dir; vi=vfim; v=0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH2    );
//    rly=dir; vi=vfim; v=0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_NAVDD   );
//    rly=dir; vi=vfim; v=0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_LVGL    );
//    rly=dir; vi=vfim; v=0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGL     );
//    //VS_ALL_SET();
//    //------------------------------------------------------------------------------
//******************************* HSIF *******************
//******************************* HSIF *******************
  tno(91); cat(cat_os2); dcmnt("HSIFALL PIN Open/Short Pos Test");
  TEST.Set();

  fmt=open; vih=3V;vil=0V; option=NONE; iokindsel=IN; pin(ALL_IOPIN);

  lcdvoh=0V; lcdvol=0V;
  lcdrly=off; mode=ppcp; rng=R10V; ioh=-100uA; iol=100uA; vt2=2V;
  lcdoption=NONE;
  lcdpin(ALL_LCD);
    
  rly=off; vi=vfim; i=100uA; irng=M80UA; v=10V; vrng=R40V;  
  rvipin(PL_ALL_RVS);

  fmt=OPEN; vih=0V;vil=0V; hsifpin(ALL_HSIF_PIN); //HSIF vih-vil <= 2.5V

  sr(on);

  vi=ifvm; i=100uA; irng=R800UA; v=1.6V; vrng=M8V; hsifpin(ALL_HSIF_PIN);
  judge(vm,0.12V,0.9V,V);

//  tno(92); cat(cat_os2); dcmnt("HSIFALL PIN Open/Short Neg Test");
//  TEST.Set();
//
//  vi=ifvm; i=-100uA; irng=R800UA; v=1.6V; vrng=M8V; hsifpin(HSIF_OS);
//  judge(vm,-0.9V,-0.2V,V);

  sr(off);
//=============================================================================================
//************************************Pass Pin test***********************
  testno=passpin_testno;

  vih=3.0V; vil=0.0V; voh=1.0V;vol=0.2V;vt=+1.0V;ilh=-0uA;ill=00uA; pin(OS1_DPIN);

  rly=off;fmt=NRZ1; option=NONE;iokindsel=IO; 
  t(1); strb=rate1*0.0; edge(rate1*0/4);
  pin(ALL_INPIN);
  
  rly=off;fmt=NRZ; option=NONE; 
  t(1); strb=rate1*0.0; edge(rate1*0/4,rate1*0/4);pin(ALL_INPIN);
  
  lcdrly=off; rng=R10V; ioh=-100uA; iol=100uA; vt1=0V;vt2=0V;
  lcdoption=NONE;//LCDVT1,LCDVT2
  signallcd.vt(NONE);
  signallcd.ilh(NONE);
  signallcd.ill(NONE);
  lcdpin(ALL_LCDPIN); //Add RPIO/GMAIO
  
  sr(off);
  TSTime("OS test                                      ");

  //alarm_func_on();
  
  if (0!=(int_FunctionKey &0x0002))//ONLY CONTACT CHECK
  {
    exit.branch  (1);
    exit.PostExec  ();  
  }
  
return 0;

}

int leakage()
{
  int tmp_test_num=0;
  testno=5000;

  int_Relay = 0x00000000;

  cw1_num[ 0]=0;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();
//=========================== Setting Conditions ==================================================
  freq  = 10MHz;

  rate1 = (1/freq)*1;
  rate2 = (1/freq)*1;
  rate3 = 10uS;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =300mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;

//================================= power / level setting ==================================
  rly=dir; vi=vfim; v= 1.8V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
  rly=dir; vi=vfim; v= 1.8V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);
  rly=dir; vi=vfim; v= 6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_PAVDD   );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH1    );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH2    );
  rly=dir; vi=vfim; v=-6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_NAVDD   );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_LVGL    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGL     );
  
  rly=off;  vi=vfim; i=102.4uA; irng=M10MA; v= 5.8V; vrng=R20V; rvipin( RVS_PAD_VGMAL1   );
  rly=off;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.2V; vrng=R20V; rvipin( RVS_PAD_VGMAL7   );
  rly=off;  vi=vfim; i=102.4uA; irng=M10MA; v=-0.2V; vrng=R20V; rvipin( RVS_PAD_VGMAL8   );
  rly=off;  vi=vfim; i=102.4uA; irng=M10MA; v=-5.8V; vrng=R20V; rvipin(RVS_PAD_VGMAL14   );

  rly=off;  vi=vfim; i=102.4uA; irng=M10MA; v= 5.8V; vrng=R20V; rvipin( RVS_PAD_VGMAR1   );
  rly=off;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.2V; vrng=R20V; rvipin( RVS_PAD_VGMAR7   );
  rly=off;  vi=vfim; i=102.4uA; irng=M10MA; v=-0.2V; vrng=R20V; rvipin( RVS_PAD_VGMAR8   );
  rly=off;  vi=vfim; i=102.4uA; irng=M10MA; v=-5.8V; vrng=R20V; rvipin(RVS_PAD_VGMAR14   );

  //vih=vih_in[0]; vil=vil_in[0]; voh=voh_in[0]; vol=vol_in[0]; pin(HSIF_ALL  );
  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(ALL_IOPIN);
//=============================================================================
  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD);

//=============================================================================
  
//=============================================================================

  sr(on);    

  //fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_RSTB        );
  //fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_XON         );
  //fmt=fixh; vih=vih_in[1]; vil=vil_in[1]; pin(DPIN_TP_EXT_RSTN );
  //kindsel[0]=1;
//=============================================================================
  tno(tmp_test_num++); cat(cat_leak); dcmnt("DPIN pins IIL Test");

  rly=off; fmt=open; vi=vfim; vrng=R8V; v=0.0V; irng=M80UA; i=0.999mA; //pin(ALL_INPIN);
  measure_im.pinlist(LEAK_PIN1);  chkind=iopinkind;
  judge(im,-1.0uA,1.0uA,I);

//  if(exit.branch()!=0) return 0; //--fail on/off flag
//=============================================================================
  tno(tmp_test_num++); cat(cat_leak); dcmnt("DPIN pins IIH Test");

  rly=off; fmt=open; vi=vfim; vrng=R8V; v=1.8V; irng=M80UA; i=0.999mA; //pin(ALL_INPIN);
  measure_im.pinlist(LEAK_PIN1);  chkind=iopinkind;
  judge(im,-1.0uA,1.0uA,I);
//=============================================================================
  tno(tmp_test_num++); cat(cat_leak); dcmnt("PULL-H pins IIL Test");

  rly=off; fmt=open; vi=vfim; vrng=R8V; v=0.0V; irng=M80UA; i=0.999mA;
  measure_im.pinlist(PL_PULL_H);  chkind=iopinkind;
  judge(im,-26.0uA, -2.0uA,I);

  if( measure_im.Get_PinVal(1,DPIN_PAD_STB )!=0.0A ){ Ohm1[0]=(-1.8V/measure_im.Get_PinVal(1,DPIN_PAD_STB ))/1000.0R; }
  if( measure_im.Get_PinVal(1,DPIN_PAD_WAKE)!=0.0A ){ Ohm1[1]=(-1.8V/measure_im.Get_PinVal(1,DPIN_PAD_WAKE))/1000.0R; }
  if( measure_im.Get_PinVal(1,DPIN_PAD_XON )!=0.0A ){ Ohm1[2]=(-1.8V/measure_im.Get_PinVal(1,DPIN_PAD_XON ))/1000.0R; }
  
//=============================================================================
  tno(tmp_test_num++); cat(cat_leak); dcmnt("PULL-H pins IIH Test");

  rly=off; fmt=open; vi=vfim; vrng=R8V; v=1.8V; irng=M80UA; i=0.999mA;
  measure_im.pinlist(PL_PULL_H);  chkind=iopinkind;
  judge(im,-1.0uA,1.0uA,I);
  
//=============================================================================
  tno(tmp_test_num++); cat(cat_leak); dcmnt("PULL-L pins IIL Test");

  rly=off; fmt=open; vi=vfim; vrng=R8V; v=0.0V; irng=M80UA; i=0.999mA;
  measure_im.pinlist(PL_PULL_L);  chkind=iopinkind;
  judge(im,-1.0uA, 1.0uA,I);

//  if(exit.branch()!=0) return 0; //--fail on/off flag
//=============================================================================
  tno(tmp_test_num++); cat(cat_leak); dcmnt("PULL-L pins IIH Test");

  rly=off; fmt=open; vi=vfim; vrng=R8V; v=1.8V; irng=M80UA; i=0.999mA;
  measure_im.pinlist(PL_PULL_L);  chkind=iopinkind;
  judge(im, 2.0uA,26.0uA,I);

////=============================================================================
//  tno(tmp_test_num++); cat(cat_leak); dcmnt("PL_PULL_H2 pins IIL Test");
//
//  rly=off; fmt=open; vi=vfim; vrng=R8V; v=0.0V; irng=M80UA; i=0.999mA; //pin(ALL_INPIN);
//  measure_im.pinlist(PL_PULL_H2);  chkind=iopinkind;
//  judge(im,-1.0uA,1.0uA,I);
//
////  if(exit.branch()!=0) return 0; //--fail on/off flag
////=============================================================================
//  tno(tmp_test_num++); cat(cat_leak); dcmnt("PL_PULL_H2 pins IIH Test");
//
//  rly=off; fmt=open; vi=vfim; vrng=R8V; v=1.8V; irng=M80UA; i=0.999mA; //pin(ALL_INPIN);
//  measure_im.pinlist(PL_PULL_H2);  chkind=iopinkind;
//  judge(im,-1.0uA,1.0uA,I);

//  if(exit.branch()!=0) return 0; //--fail on/off flag
//=============================================================================

//=============================================================================
  tno(tmp_test_num++); cat(cat_leak); dcmnt("PAD_STB  PULL-H Resistance(kohm)"); judge( Ohm1[0] , 100 ,500);
  tno(tmp_test_num++); cat(cat_leak); dcmnt("PAD_WAKE PULL-H Resistance(kohm)"); judge( Ohm1[1] , 100 ,500);
  tno(tmp_test_num++); cat(cat_leak); dcmnt("PAD_XON  PULL-H Resistance(kohm)"); judge( Ohm1[2] , 100 ,500);

//=============================================================================

  fmt=open; pin(ALL_INPIN);

  sr(off);
  if(exit.branch()!=0) return 0; //--fail on/off flag

  TSTime("INPUT LEAK TEST                              ");
 
//=============================================================================
// --- Gamma pin leakage test and VDD/AVDD testmode current test
//
//=============================================================================
//=============================================================================

  tout=10S; lcdrly=off; mode=ppcp; rng=R20V; scan_mode=PIN_INC; scan_step=1; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS;

  lcdoption=NONE;
  lcdpin(ALL_LCDPIN);
 
  tno(9); cat(cat_rvsleak); dcmnt("Gamma IO Leak 1.0*VDDA Test");

  gamma1 = 5.8V;
  gamma14=-5.8V;

  rly=off;  vi=vfim; v=gamma14; vrng=R40V; i=10.24uA; irng=M8UA;  
  rvipin(RVS_GMA_ALL_RL_UP);
  rvipin(RVS_GMA_ALL_RL_DO);
  
  sr(on);

  tno(9); cat(6); dcmnt("Gamma IO Leak 1.0*VDDA Test (GAMMA-UP)");

  rly=off; vi=vfim; i=10.24uA; irng=M8UA; v=gamma1; vrng=R40V; rvipin(RVS_GMA_ALL_RL_UP);
  judge(im, -1.5uA, 1.5uA,I);

  rly=off; vi=vfim; v=gamma1; vrng=R40V; i=10.24uA; irng=M8UA;  
  rvipin(RVS_GMA_ALL_RL_UP);
  rvipin(RVS_GMA_ALL_RL_DO);

  sr(on);

  tno(10); cat(6); dcmnt("Gamma IO Leak 1.0*VDDA Test (GAMMA-DO)");
  rly=off; vi=vfim; i=10.24uA; irng=M8UA; v=gamma14; vrng=R40V; rvipin(RVS_GMA_ALL_RL_DO);

  judge(im, -1.5uA, 1.5uA,I);


  sr(off);

////=========================== Power / Level Setting ===============================================
//  rly=dir; vi=vfim; v=vdd;      i=250mA; irng=M800MA; vrng=R20V; uvipin(DVDD);
//  rly=dir; vi=vfim; v=avdd;     i=250mA; irng=M800MA; vrng=R20V; uvipin(AVDD);
//  rly=dir; vi=vfim; v=avdd*0.5; i=250mA; irng=M800MA; vrng=R20V; uvipin(HAVDD);
//
//  rly=off; vi=vfim; i=102.4uA; irng=M8UA; v=gamma1; vrng=R40V; rvipin(PL_GMA_RVS);
//
//   rly=off; fmt=open; vih=vih1; vil=vil1; pin(ALL_IOPIN);
//
//  lcdrly=off; mode=ppcp; rng=R20V; lcdstrb1=4nS;lcdstrb2=4nS;
//  lcdoption=NONE;//LCDVT1,LCDVT2 
//  lcdpin(ALL_LCDPIN);
//
//=============================================================================
//  tno(7); cat(cat_rvsleak); dcmnt("Gamma IO Leak 0.5*VDDA Test (GAMMA-UP)");
//
//  sr(on);
//
//  rly=off; vi=vfim; i=10.24uA; irng=M8UA; v=gamma1; vrng=R40V; rvipin(UP_RVS);
//  judge(im, -1uA, 1uA,I);
//
//  tno(8); cat(cat_rvsleak); dcmnt("Gamma IO Leak 0.5*VDDA Test (GAMMA-DO)");
//
//  rly=off; vi=vfim; i=10.24uA; irng=M8UA; v=gamma1; vrng=R40V; rvipin(DO_RVS);
//  judge(im, -1uA, 1uA,I);
//  
//  sr(off);
//
//  if(exit.branch()!=0) return 0; //--fail on/off flag
//
//=============================================================================
  tno(9); cat(cat_rvsleak); dcmnt("Gamma IO Leak 1.0*VDDA Test");

  gamma1 = 0.2V;
  gamma14=-0.2V;
  
  rly=off;  vi=vfim; v=gamma18; vrng=R40V; i=10.24uA; irng=M8UA;  
  rvipin(RVS_GMA_ALL_RL_UP);
  rvipin(RVS_GMA_ALL_RL_DO);
  
  sr(on);

  tno(9); cat(6); dcmnt("Gamma IO Leak 1.0*VDDA Test (GAMMA-UP)");

  rly=off; vi=vfim; i=10.24uA; irng=M8UA; v=gamma1; vrng=R40V; rvipin(RVS_GMA_ALL_RL_UP);
  judge(im, -1uA, 1uA,I);


  rly=off; vi=vfim; v=gamma1; vrng=R40V; i=10.24uA; irng=M8UA;  
  rvipin(RVS_GMA_ALL_RL_UP);
  rvipin(RVS_GMA_ALL_RL_DO);

  sr(on);

  tno(10); cat(6); dcmnt("Gamma IO Leak 1.0*VDDA Test (GAMMA-DO)");
  rly=off; vi=vfim; i=10.24uA; irng=M8UA; v=gamma18; vrng=R40V; rvipin(RVS_GMA_ALL_RL_DO);

  judge(im, -1.5uA, 1.5uA,I);

  sr(off);
  
  if(exit.branch()!=0) return 0; //--fail on/off flag

//=============================================================================
  sr(off);

  TSTime("GAMMA LEAK TEST                              ");

  return 0;

}
ARRAY<double> vgmo_01_ideal_val(256),vgmo_01_dvoc_max(256),vgmo_01_dvoc_min(256);
ARRAY<double> vgmo_02_ideal_val(256),vgmo_02_dvoc_max(256),vgmo_02_dvoc_min(256);
