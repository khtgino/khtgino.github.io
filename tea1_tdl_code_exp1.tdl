  rly=on; vi=vfim; v= 0.0V ;   i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
  rly=on; vi=vfim; v= 0.0V ;   i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);
