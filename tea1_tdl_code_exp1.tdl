     }
    sr(off);
//================================================================================================
    sr(on);
    tno(tmp_test_num++); cat(cat_os2); dcmnt("LCD PIN O/S (+)");

    rly=off; term=off; vi=ifvm; i=150uA;  irng=R800UA; v=1.6V; vrng=M12V; rng=R12V; lcdpin(ALL_LCD_OS); judge(vm, 0.2V, 1.0V, V);

    lcd_os_V=4.6V;
    measure_vm.Get_PinVal(1,ALL_LCD_OS,lcd_os_V);
    for( os_ii1=0; os_ii1<lcd_os_2_num ; os_ii1+=1)
     {
      //if( lcd_os_V[os_ii1]<4.0V )
