  ARRAY<double> gmao_tmp_8step_01(14*8),gmao_tmp_8step_02(14*8),gmao_tmp_8step_03(14*8),gmao_tmp_8step_04(14*8);
  ARRAY<double> gmao_tmp_8step_max1(14*8),gmao_tmp_8step_max2(14*8);
  ARRAY<double> gmao_tmp_8step_min1(14*8),gmao_tmp_8step_min2(14*8);
  double gmao_8step_offset=0.020;
  
int gmao_func()
{
  int tmp_test_num=0;

  testno=42000;

  cw1_num[ 0]=1;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 2400MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.5V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(2); edge(rate2*0,rate2*0.5); pin(DPIN_PAD_LOCK   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD_MV_1);
  rly=off; fmt=open; vih=     6.0V; vil=    0.0V;  pin(DPIN_PAD_TEST_SD_MV_2);

  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DP_SEL);
//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=8; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;     
  //lcdoption=NONE;     
  lcdoption=LCDVT1;     
       
  lcdstrb1 =rate1/2;     
  lcdstrb2 =rate1/2;     
  lcdstrb3 =rate1/2;     
  lcddigit1=rate1/2;     
  lcddigit2=rate1/2;     
  lcddigit3=rate1/2;     
     
  lcdstrb.strb(1,lcdstrb1);     
  lcdstrb.strb(2,lcdstrb2);     
  lcdstrb.strb(3,lcdstrb3);     
  //lcdstrb.strb(4,lcdstrb4);     
  lcdstrb.option(lcdstrboption);     
  lcdstrb.Load();     
         
  lcdpin(ALL_LCD_GMAO);     
     
  lcd_event.wavekind(NRZ1);     
  lcd_event.Load();  
//================================================================================================  
  ARRAY<int> gs_tmp_check(4);

  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();
  wait(12.0mS);
     
  //--------------------------------------------------------------------
  patf("fn01a1_gmao_03_ch1446_dpsel_4p_bsel_0_shl_1_gop_chop_0_25_0925.lpa");
       
  pat(run);     
  calcstart(gmao_tmp_8step_01);
  //--------------------------------------------------------------------
  patf("fn01a1_gmao_04_ch1446_dpsel_4p_bsel_0_shl_1_gop_chop_1_25_0925.lpa");
       
  pat(run);     
  calcstart(gmao_tmp_8step_02);
  //--------------------------------------------------------------------
  patf("fn01a1_gmao_03_ch1446_dpsel_4p_bsel_1_shl_1_gop_chop_0_25_0925.lpa");
       
  pat(run);     
  calcstart(gmao_tmp_8step_03);
  //--------------------------------------------------------------------
  patf("fn01a1_gmao_04_ch1446_dpsel_4p_bsel_1_shl_1_gop_chop_1_25_0925.lpa");
       
  pat(run);     
  calcstart(gmao_tmp_8step_04);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=256; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-1uA; iol=1uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;
  lcdoption=NONE;
  //lcdoption=LCDVT1;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD_GMAO);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();
    
//===========================================================================================
 
  tno(tmp_test_num++); cat(17); TSTime("GMAO Pattern Run");

  ARRAY<double> gmao_tmp_all_01(14*256),gmao_tmp_all_02(14*256),gmao_tmp_all_03(14*256),gmao_tmp_all_04(14*256);
  ARRAY<double> gmao_tmp_v01_01(256),gmao_tmp_v01_02(256),gmao_tmp_v01_03(256),gmao_tmp_v01_04(256);
  ARRAY<double> gmao_tmp_v02_01(256),gmao_tmp_v02_02(256),gmao_tmp_v02_03(256),gmao_tmp_v02_04(256);
  ARRAY<double> gmao_tmp_v03_01(256),gmao_tmp_v03_02(256),gmao_tmp_v03_03(256),gmao_tmp_v03_04(256);
  ARRAY<double> gmao_tmp_v04_01(256),gmao_tmp_v04_02(256),gmao_tmp_v04_03(256),gmao_tmp_v04_04(256);
  ARRAY<double> gmao_tmp_v05_01(256),gmao_tmp_v05_02(256),gmao_tmp_v05_03(256),gmao_tmp_v05_04(256);
  ARRAY<double> gmao_tmp_v06_01(256),gmao_tmp_v06_02(256),gmao_tmp_v06_03(256),gmao_tmp_v06_04(256);
  ARRAY<double> gmao_tmp_v07_01(256),gmao_tmp_v07_02(256),gmao_tmp_v07_03(256),gmao_tmp_v07_04(256);
  ARRAY<double> gmao_tmp_v08_01(256),gmao_tmp_v08_02(256),gmao_tmp_v08_03(256),gmao_tmp_v08_04(256);
  ARRAY<double> gmao_tmp_v09_01(256),gmao_tmp_v09_02(256),gmao_tmp_v09_03(256),gmao_tmp_v09_04(256);
  ARRAY<double> gmao_tmp_v10_01(256),gmao_tmp_v10_02(256),gmao_tmp_v10_03(256),gmao_tmp_v10_04(256);
  ARRAY<double> gmao_tmp_v11_01(256),gmao_tmp_v11_02(256),gmao_tmp_v11_03(256),gmao_tmp_v11_04(256);
  ARRAY<double> gmao_tmp_v12_01(256),gmao_tmp_v12_02(256),gmao_tmp_v12_03(256),gmao_tmp_v12_04(256);
  ARRAY<double> gmao_tmp_v13_01(256),gmao_tmp_v13_02(256),gmao_tmp_v13_03(256),gmao_tmp_v13_04(256);
  ARRAY<double> gmao_tmp_v14_01(256),gmao_tmp_v14_02(256),gmao_tmp_v14_03(256),gmao_tmp_v14_04(256);
    
  //-------------------------------------------------------------------- 
  patf("fn01a1_gmao_01_ch1446_dpsel_4p_bsel_0_shl_1_gop_chop_0_25_0925.lpa");
       
  pat(run);     
  calcstart(ALL_LCD_GMAO,gmao_tmp_all_01);     
  calcstart(LCD_PAD_GMAO_01,gmao_tmp_v01_01); vgmo_01_dvoc_v1=gmao_tmp_v01_01-vgmo_01_ideal_val;
  calcstart(LCD_PAD_GMAO_02,gmao_tmp_v02_01); vgmo_02_dvoc_v1=gmao_tmp_v02_01-vgmo_02_ideal_val;
  calcstart(LCD_PAD_GMAO_03,gmao_tmp_v03_01); vgmo_03_dvoc_v1=gmao_tmp_v03_01-vgmo_03_ideal_val;
  calcstart(LCD_PAD_GMAO_04,gmao_tmp_v04_01); vgmo_04_dvoc_v1=gmao_tmp_v04_01-vgmo_04_ideal_val;
  calcstart(LCD_PAD_GMAO_05,gmao_tmp_v05_01); vgmo_05_dvoc_v1=gmao_tmp_v05_01-vgmo_05_ideal_val;
  calcstart(LCD_PAD_GMAO_06,gmao_tmp_v06_01); vgmo_06_dvoc_v1=gmao_tmp_v06_01-vgmo_06_ideal_val;
  calcstart(LCD_PAD_GMAO_07,gmao_tmp_v07_01); vgmo_07_dvoc_v1=gmao_tmp_v07_01-vgmo_07_ideal_val;
  calcstart(LCD_PAD_GMAO_08,gmao_tmp_v08_01); vgmo_08_dvoc_v1=gmao_tmp_v08_01-vgmo_08_ideal_val;
  calcstart(LCD_PAD_GMAO_09,gmao_tmp_v09_01); vgmo_09_dvoc_v1=gmao_tmp_v09_01-vgmo_09_ideal_val;
  calcstart(LCD_PAD_GMAO_10,gmao_tmp_v10_01); vgmo_10_dvoc_v1=gmao_tmp_v10_01-vgmo_10_ideal_val;
