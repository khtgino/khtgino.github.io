  if( sxmux_p7_avg_s1==0 ){ sxmux_p7_avg_s1=1; } adc_sxmux_f1<<"TOUCH ADC SXMUX-7-S1 MAX Ratio = "<<(sxmux_p7_max_s1-sxmux_p7_avg_s1)/sxmux_p7_avg_s1<<"\n";
