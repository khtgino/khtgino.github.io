//=========================== Index Define ======================================================
ARRAY<int>  pos_idx_gs0101(levelno*lcdpinno);
ARRAY<int>  neg_idx_gs0101(levelno*lcdpinno);
ARRAY<int>  pos_idx_gs0ff0(levelno*lcdpinno);
ARRAY<int>  neg_idx_gs0ff0(levelno*lcdpinno);
