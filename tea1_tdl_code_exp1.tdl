  tno(tmp_test_num++); cat(25); dcmnt("0101_ch1446_dpsel_4p_8b_shl_1_int_stb_0_reg_dpsel_en_0 Ideal");    judge( gs0101_all_result_02[1] , 0,0 );

  tno(tmp_test_num++); cat(25); dcmnt("0f0f_bus12_ch1446_dpsel_4p_8b_shl_1 Ideal"); judge( gs0f0f_all_result_01[0] , 0,0 );
  tno(tmp_test_num++); cat(26); dcmnt("0f0f_bus12_ch1446_dpsel_4p_8b_shl_1 ABS  "); judge( gs0f0f_abs_result_01[0] , 0,0 );
  tno(tmp_test_num++); cat(27); dcmnt("0f0f_bus12_ch1446_dpsel_4p_8b_shl_1 RMS  "); judge( gs0f0f_rms_result_01[0] , 0,0 );

  tno(tmp_test_num++); cat(25); dcmnt("0ff0_ch1446_dpsel_4p_8b_shl_1 Ideal"); judge( gs0ff0_all_result_01[0] , 0,0 );
  tno(tmp_test_num++); cat(26); dcmnt("0ff0_ch1446_dpsel_4p_8b_shl_1 ABS  "); judge( gs0ff0_abs_result_01[0] , 0,0 );
