int test_start(void)
{
  ON_BRANCH.event(FLBL,ON_DCTF,ON_FCTF,ON_ACTF);
  ON_BRANCH.event(w_start,ON_WSTART);
  ON_BRANCH.event(W_END,ON_WEND);
  ON_BRANCH.event(L_END,ON_LEND);
  ON_BRANCH.Load();
  
  str_lot_name=prober.Get_Info("lot");
  str_wafer_id=prober.Get_Info("wafer");
  str_slot_name=prober.Get_Info("slot");
  
  exit.branch(0);
  exit.PostExec();
  
  int_SettingDut=TESTDUT.Get_Dut(SETTING);
  //reset  
  pg.start(NORMAL);
  pg.pend(OFF);
  pg.Load();
  
  drel=0S; 
  dret=0S;
  //vectorfile.init();
  vectorreg.init();
  signal_level.Init();
  signal_timing.Init();
  vt1=0V;
  vt2=0V;
  
  return ENABLE;
};

int test_end(void)
{

  int ff_num;

  prober.mGet_Axis(axis_x, axis_y);

  int_TotalFailDut=TESTDUT.Get_FailDut(TOTAL);
  int_TotalPassDut=~int_TotalFailDut & int_SettingDut;//~int_TotalFailDut->complement of int_TotalFailDut
 
  ff_num=test_chip_num;

  //========================================
    //& int_SettingDut->remove not setting dut  
  if(int_TotalPassDut!=0)
  {
    //category.Num(1);
    //prober.mGet_Axis(axis_x, axis_y);
    //if(axis_x[0]<0){ axis_x[0]=0; }

    ff_num=test_chip_num;
    //if(  0<=(axis_x[0]%17) && (axis_x[0]%17)<=0  ){ ff_num=121; }
    //if(  1<=(axis_x[0]%17) && (axis_x[0]%17)<=2  ){ ff_num=122; }
    //if(  3<=(axis_x[0]%17) && (axis_x[0]%17)<=7  ){ ff_num=123; }
    //if(  8<=(axis_x[0]%17) && (axis_x[0]%17)<=12 ){ ff_num=124; }
    //if( 13<=(axis_x[0]%17) && (axis_x[0]%17)<=16 ){ ff_num=121; }
  
  
    if( (int_TotalPassDut & 0x01) == 0x01 )
      {
      category.Num(ff_num);
      category.dut(1);
      category.PostExec();
      }
    if( (int_TotalPassDut & 0x02) == 0x02 )
      {
      category.Num(ff_num);
      category.dut(2);
      category.PostExec();
  
      }
      //category.dut(int_TotalPassDut);
      //category.PostExec();
  }
  return  ENABLE;
};

