  else if( sub2_hex_mm == "D" ){ sub2_dec_mm=13; }
  else if( sub2_hex_mm == "E" ){ sub2_dec_mm=14; }
  else if( sub2_hex_mm == "F" ){ sub2_dec_mm=15; }
  else if( sub2_hex_mm == "a" ){ sub2_dec_mm=10; }
  else if( sub2_hex_mm == "b" ){ sub2_dec_mm=11; }
  else if( sub2_hex_mm == "c" ){ sub2_dec_mm=12; }
  else if( sub2_hex_mm == "d" ){ sub2_dec_mm=13; }
  else if( sub2_hex_mm == "e" ){ sub2_dec_mm=14; }
  else if( sub2_hex_mm == "f" ){ sub2_dec_mm=15; }

  dec_mm=sub1_dec_mm+sub2_dec_mm;

  }

  return dec_mm;
}

string dec2hex(int &dec_mm)
{ 
  string bin_mm_01;
  string bin_mm_02;
  string hex_mm;
  string sub1_hex_mm;
  string sub2_hex_mm;

  if( dec_mm<=15 )
  {
    bin_mm_01=dec2bin(dec_mm).substr(14,4);

       if( bin_mm_01 == "0000" ){ hex_mm="00"; }
  else if( bin_mm_01 == "0001" ){ hex_mm="01"; }
  else if( bin_mm_01 == "0010" ){ hex_mm="02"; }
  else if( bin_mm_01 == "0011" ){ hex_mm="03"; }
  else if( bin_mm_01 == "0100" ){ hex_mm="04"; }
