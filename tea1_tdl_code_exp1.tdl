  //if( pat_cnt_01==14 ){ freq  = 2500MHz; keyboard_vdd=2.0V; VCOM =0.9V; Vdiff_p2p  =130mV; }
  //if( pat_cnt_01==15 ){ freq  = 2500MHz; keyboard_vdd=2.0V; VCOM =0.9V; Vdiff_p2p  =150mV; }
  //
  //if( pat_cnt_01==16 ){ freq  =  400MHz; keyboard_vdd=1.6V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  //if( pat_cnt_01==17 ){ freq  =  400MHz; keyboard_vdd=2.0V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  //if( pat_cnt_01==18 ){ freq  =  400MHz; keyboard_vdd=1.6V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  //if( pat_cnt_01==19 ){ freq  =  400MHz; keyboard_vdd=2.0V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  //if( pat_cnt_01==20 ){ freq  = 1600MHz; keyboard_vdd=1.6V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  //if( pat_cnt_01==21 ){ freq  = 1600MHz; keyboard_vdd=1.6V; VCOM =0.3V; Vdiff_p2p  =130mV; }
  //if( pat_cnt_01==22 ){ freq  = 1600MHz; keyboard_vdd=1.6V; VCOM =0.3V; Vdiff_p2p  =150mV; }
  //if( pat_cnt_01==23 ){ freq  = 1600MHz; keyboard_vdd=2.0V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  //if( pat_cnt_01==24 ){ freq  = 1600MHz; keyboard_vdd=2.0V; VCOM =0.3V; Vdiff_p2p  =130mV; }
  //if( pat_cnt_01==25 ){ freq  = 1600MHz; keyboard_vdd=2.0V; VCOM =0.3V; Vdiff_p2p  =150mV; }
  //if( pat_cnt_01==26 ){ freq  = 1600MHz; keyboard_vdd=1.6V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  //if( pat_cnt_01==27 ){ freq  = 1600MHz; keyboard_vdd=1.6V; VCOM =0.9V; Vdiff_p2p  =130mV; }
  //if( pat_cnt_01==28 ){ freq  = 1600MHz; keyboard_vdd=1.6V; VCOM =0.9V; Vdiff_p2p  =150mV; }
  //if( pat_cnt_01==29 ){ freq  = 1600MHz; keyboard_vdd=2.0V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  //if( pat_cnt_01==30 ){ freq  = 1600MHz; keyboard_vdd=2.0V; VCOM =0.9V; Vdiff_p2p  =130mV; }
  //if( pat_cnt_01==31 ){ freq  = 1600MHz; keyboard_vdd=2.0V; VCOM =0.9V; Vdiff_p2p  =150mV; }

  if( pat_cnt_01== 0 ){ freq  =  400MHz; keyboard_vdd=1.6V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01== 1 ){ freq  =  400MHz; keyboard_vdd=2.0V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01== 2 ){ freq  = 2500MHz; keyboard_vdd=1.6V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01== 3 ){ freq  = 2500MHz; keyboard_vdd=2.0V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01== 4 ){ freq  =  400MHz; keyboard_vdd=1.6V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01== 5 ){ freq  =  400MHz; keyboard_vdd=2.0V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01== 6 ){ freq  = 1600MHz; keyboard_vdd=1.6V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01== 7 ){ freq  = 1600MHz; keyboard_vdd=2.0V; VCOM =0.3V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01== 8 ){ freq  =  400MHz; keyboard_vdd=1.6V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01== 9 ){ freq  =  400MHz; keyboard_vdd=2.0V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01==10 ){ freq  = 2500MHz; keyboard_vdd=1.6V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01==11 ){ freq  = 2500MHz; keyboard_vdd=2.0V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01==12 ){ freq  =  400MHz; keyboard_vdd=1.6V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01==13 ){ freq  =  400MHz; keyboard_vdd=2.0V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01==14 ){ freq  = 1600MHz; keyboard_vdd=1.6V; VCOM =0.9V; Vdiff_p2p  =120mV; }
  if( pat_cnt_01==15 ){ freq  = 1600MHz; keyboard_vdd=2.0V; VCOM =0.9V; Vdiff_p2p  =120mV; }


  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(keyboard_vdd);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  //VCOM       =0.5V;
  //Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (keyboard_vdd)*1.0;
  vil_in[1]  = (keyboard_vdd)*0.0;
  vih_in[2]  = (keyboard_vdd)*1.0;
  vil_in[2]  = (keyboard_vdd)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (keyboard_vdd)*0.7;
  vol_in[1]  = (keyboard_vdd)*0.3;
  voh_in[2]  = (keyboard_vdd)*0.7;
  vol_in[2]  = (keyboard_vdd)*0.3;

//================================= power / level setting ========================================
  POWER_INIT_FUNC(keyboard_vdd , 6.0V);
  rly=off; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_TEST_VREFN    );

  rly=dir; vi=vfim; v= keyboard_vdd; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
  rly=dir; vi=vfim; v= keyboard_vdd; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);
  
  if( pat_cnt_01== 0 )
  {
  rly=dir; vi=vfim; v=         6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_PAVDD   );
  rly=dir; vi=vfim; v=         6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH1    );
  rly=dir; vi=vfim; v=         6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH2    );
  rly=dir; vi=vfim; v=        -6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_NAVDD   );
  rly=dir; vi=vfim; v=        -6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_LVGL    );
  rly=dir; vi=vfim; v=        -6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGL     );
  
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAL14   );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAR14   );

  rly=dir; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_VCOM_ALL );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_TX_H   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_TX_L   );

  rly=on; fmt=NRZ1; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(ALL_IOPIN);
  }
//=========================== Format / Timing Setting ============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );

  vih=vih_in[2]; vil=vil_in[2]; voh=(1.8V)*0.5;vol=(1.8V)*0.5; vt=+1.9V;ilh=-200uA;ill=200uA; pin(DPIN_PAD_LOCK   );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); signal_timing.option(IL,PTMUX); pin(DPIN_PAD_LOCK   );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_TEST_DP_SEL   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_EN);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=off; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=2; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 0.01V; lcdvol= -0.01V;
  lcdoption=NONE;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();
//================================================================================================  
  //TSTime("Normal Func (keyboard-ALL) Test :" + string(pat_cnt_01));

  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  if( pat_cnt_01== 0 )
  {
  POWER_ON_FUNC1();            
  }
  if( pat_cnt_01==0  ){ wait(10.0mS); }

  //if( (pat_cnt_01%4)<2  ){ wait(10.0mS); }
  //if( (pat_cnt_01%4)>=2 ){ wait( 2.0mS); }
 
  //TSTime("Normal Func (keyboard-ALL) Test :" + string(pat_cnt_01));
 
  tno(tmp_test_num++); cat(23); dcmnt(func_02_pat_ary[pat_cnt_01]);
  patf(func_02_pat_ary2[pat_cnt_01]);
  //pjudge(result);
  meas(result,int_k);
  judge(int_k,int_k,int_k);

  //TSTime("Normal Func (keyboard-ALL) Test :" + string(pat_cnt_01));

//===========================================================================================
//===========================================================================================
  }
  
  POWER_OFF_FUNC1();
  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
  sr(off);


//===========================================================================================

  TSTime("Normal Func (keyboard-ALL) Test ");

  return 0;
}

int isb_bef()
{
  testno = isb_bef_testno;

  int_Relay = 0x00000000;

  cw1_num[ 0]=0;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//=========================== Variable Setting ====================================================
  freq  = 1600MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = 10uS;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =300mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  rly=dir; vi=vfim; v= 1.8V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 0, VS_DVDD    );
  rly=dir; vi=vfim; v= 1.8V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 1, VS_DVDD_CDR);
  rly=dir; vi=vfim; v= 6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin_ary1( 2, VS_PAVDD   );
  rly=dir; vi=vfim; v=-6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin_ary1( 3, VS_NAVDD   );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 4, VS_VGH1    );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 5, VS_VGH2    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 6, VS_LVGL    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 7, VS_VGL     );
  
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAL14   );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAR14   );

  rly=dir; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_VCOM_ALL );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_TX_H   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_TX_L   );

  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(ALL_IOPIN);
//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(OFF,rate1,rate2,rate3,rate4);

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD);

  wait(6mS);

  //sr(on);
	sr(on);

  rly=dir; vi=vfim; v=-1.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_VCOM_ALL );

  rvs_vs.SRng(R20V); rvs_vs.MRng(M10MA);
  rvs_vs.rvspin(RVS_PAD_TX_H  ); rvs_vs.SVal(   4.0V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_TX_L  ); rvs_vs.SVal(   0.9V); rvs_vs.Load();
  rvsunit_relay.rvspin(RVS_TX_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();
  
  wait(2mS);
  rvs_vs.rvspin( RVS_PAD_VGMAL1); rvs_vs.SVal(   5.8V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAL7); rvs_vs.SVal(   0.2V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAL8); rvs_vs.SVal(  -0.2V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_VGMAL14); rvs_vs.SVal(  -5.8V); rvs_vs.Load();

  rvs_vs.rvspin( RVS_PAD_VGMAR1); rvs_vs.SVal(   5.8V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAR7); rvs_vs.SVal(   0.2V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAR8); rvs_vs.SVal(  -0.2V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_VGMAR14); rvs_vs.SVal(  -5.8V); rvs_vs.Load();

  rvsunit_relay.rvspin(RVS_GMA_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();

  wait(2mS);

  rly=dir; vi=vfim; v= 21.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 4, VS_VGH1    );
  rly=dir; vi=vfim; v= 22.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 5, VS_VGH2    );
  rly=dir; vi=vfim; v=-10.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 6, VS_LVGL    );
  rly=dir; vi=vfim; v= -9.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 7, VS_VGL     );

  wait(2mS); 	
  

  rly=dir; vi=vfim; v= 1.8V;  i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 0, VS_DVDD    );
  rly=dir; vi=vfim; v= 1.8V;  i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 1, VS_DVDD_CDR);
  rly=dir; vi=vfim; v= 6.0V;  i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 2, VS_PAVDD   );
  rly=dir; vi=vfim; v=-6.0V;  i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 3, VS_NAVDD   );
  rly=dir; vi=vfim; v= 21.0V; i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 4, VS_VGH1    );
  rly=dir; vi=vfim; v= 22.0V; i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 5, VS_VGH2    );
  rly=dir; vi=vfim; v=-10.0V; i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 6, VS_LVGL    );
  rly=dir; vi=vfim; v= -9.0V; i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 7, VS_VGL     );
 
//=========================== Judge ===============================================================
  measure_dpsim.vsim(dpsvsim_ary1[0],dpsvsim_ary1[1],dpsvsim_ary1[2],dpsvsim_ary1[3],dpsvsim_ary1[4],dpsvsim_ary1[5],dpsvsim_ary1[6],dpsvsim_ary1[7]);
  measure_dpsim.limit(im_limit);
  measure_dpsim.Set();
  wait(1.0mS);
  measure_dpsim.Start();
  
  ARRAY<Amperes> idd_tmp(8);
  
  idd_tmp[0]=measure_dpsim.Get_PinVal(1, VS_DVDD    );
  idd_tmp[1]=measure_dpsim.Get_PinVal(1, VS_DVDD_CDR);
  idd_tmp[2]=measure_dpsim.Get_PinVal(1, VS_PAVDD   );
  idd_tmp[3]=measure_dpsim.Get_PinVal(1, VS_NAVDD   );
  idd_tmp[4]=measure_dpsim.Get_PinVal(1, VS_VGH1    );
  idd_tmp[5]=measure_dpsim.Get_PinVal(1, VS_VGH2    );
  idd_tmp[6]=measure_dpsim.Get_PinVal(1, VS_LVGL    );
  idd_tmp[7]=measure_dpsim.Get_PinVal(1, VS_VGL     );
  

  tno(1); cat(cat_isb_dvdd); dcmnt("DVDD     Standby Current bef");  judge(idd_tmp[0], -1.50uA, 140uA);
  tno(2); cat(cat_isb_dvdd); dcmnt("DVDD_CDR Standby Current bef");  judge(idd_tmp[1], -1.50uA,  70uA);
  tno(3); cat(cat_isb_avdd); dcmnt("PAVDD_L  Standby Current bef");  judge(idd_tmp[2], -1.50uA,  50uA);
  tno(4); cat(cat_isb_avdd); dcmnt("NAVDD_L  Standby Current bef");  judge(idd_tmp[3], -50.0uA, 1.5uA);
  tno(5); cat(cat_isb_avdd); dcmnt("VS_VGH1  Standby Current bef");  judge(idd_tmp[4], -1.50uA,  50uA);
  tno(6); cat(cat_isb_avdd); dcmnt("VS_VGH2  Standby Current bef");  judge(idd_tmp[5], -1.50uA,  50uA);
  tno(7); cat(cat_isb_avdd); dcmnt("VS_LVGL  Standby Current bef");  judge(idd_tmp[6], -50.0uA, 1.5uA);
  tno(8); cat(cat_isb_avdd); dcmnt("VS_VGL   Standby Current bef");  judge(idd_tmp[7], -50.0uA, 1.5uA);


//  tno(1); cat(cat_isb_dvdd); dcmnt("DVDD Standby Current bef");
//
//  v=1.8V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_DVDD ); judge(im, -1.50uA, 140uA, I);
//
//  tno(2); cat(cat_isb_dvdd); dcmnt("DVDD_CDR Standby Current bef");
//
//  v=1.8V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_DVDD_CDR ); judge(im, -1.50uA, 70uA, I);
//
////=========================== Judge ===============================================================
//  wait(2mS);
//
//  tno(3); cat(cat_isb_avdd); dcmnt("PDVDD Standby Current bef");
//
//  v=6.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_PAVDD ); judge(im, -1.50uA, 50uA, I);
////=========================== Judge ===============================================================
//
//  tno(4); cat(cat_isb_avdd); dcmnt("NDVDD Standby Current bef");
//
//  v=-6.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_NAVDD ); judge(im, -50uA, 1.5uA, I);
////===========================================================================================
//
//  tno(5); cat(cat_isb_avdd); dcmnt("VGH1 Standby Current bef");
//
//  v=21.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_VGH1 ); judge(im, -1.50uA, 50uA, I);
////===========================================================================================
//
//  tno(6); cat(cat_isb_avdd); dcmnt("VGH2 Standby Current bef");
//
//  v=22.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_VGH2 ); judge(im, -1.50uA, 50uA, I);
////===========================================================================================
//
//  tno(7); cat(cat_isb_avdd); dcmnt("VGL Standby Current bef");
//
//  v=-10.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_VGL ); measure_dpsim.Start(); measure_dpsim.Start(); judge(im, -260uA, 1.5uA, I);
////===========================================================================================
//
//  tno(8); cat(cat_isb_avdd); dcmnt("LVGL Standby Current bef");
//
//  v=-9.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_LVGL ); judge(im, -50uA, 1.5uA, I);
//===========================================================================================

  fmt=fixl; vih=vih1; vil=vil1; pin(DPIN_PAD_TEST_SD);
//===========================================================================================
  //sr(off);
  POWER_OFF_FUNC1();
   

  //rly=off; fmt=open; vih=vih1; vil=vil1; pin(ALL_IOPIN);
//===========================================================================================
  TSTime("Standby Current Before Stress Test           ");

  return 0;

}

int isb_aft()
{
  testno = isb_aft_testno;

  int_Relay = 0x00000000;

  cw1_num[ 0]=0;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//=========================== Variable Setting ====================================================
  freq  = 1600MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = 10uS;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =300mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  rly=dir; vi=vfim; v= 1.8V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 0, VS_DVDD    );
  rly=dir; vi=vfim; v= 1.8V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 1, VS_DVDD_CDR);
  rly=dir; vi=vfim; v= 6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin_ary1( 2, VS_PAVDD   );
  rly=dir; vi=vfim; v=-6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin_ary1( 3, VS_NAVDD   );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 4, VS_VGH1    );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 5, VS_VGH2    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 6, VS_LVGL    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 7, VS_VGL     );
  
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAL14   );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAR14   );

  rly=dir; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_VCOM_ALL );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_TX_H   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_TX_L   );

  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(ALL_IOPIN);
//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(OFF,rate1,rate2,rate3,rate4);

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD);

  wait(6mS);

  //sr(on);
	sr(on);

  rly=dir; vi=vfim; v=-1.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_VCOM_ALL );

  rvs_vs.SRng(R20V); rvs_vs.MRng(M10MA);
  rvs_vs.rvspin(RVS_PAD_TX_H  ); rvs_vs.SVal(   4.0V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_TX_L  ); rvs_vs.SVal(   0.9V); rvs_vs.Load();
  rvsunit_relay.rvspin(RVS_TX_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();
  
  wait(2mS);
  rvs_vs.rvspin( RVS_PAD_VGMAL1); rvs_vs.SVal(   5.8V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAL7); rvs_vs.SVal(   0.2V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAL8); rvs_vs.SVal(  -0.2V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_VGMAL14); rvs_vs.SVal(  -5.8V); rvs_vs.Load();

  rvs_vs.rvspin( RVS_PAD_VGMAR1); rvs_vs.SVal(   5.8V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAR7); rvs_vs.SVal(   0.2V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAR8); rvs_vs.SVal(  -0.2V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_VGMAR14); rvs_vs.SVal(  -5.8V); rvs_vs.Load();

  rvsunit_relay.rvspin(RVS_GMA_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();

  wait(2mS);

  rly=dir; vi=vfim; v= 21.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 4, VS_VGH1    );
  rly=dir; vi=vfim; v= 22.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 5, VS_VGH2    );
  rly=dir; vi=vfim; v=-10.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 6, VS_LVGL    );
  rly=dir; vi=vfim; v= -9.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 7, VS_VGL     );

  wait(2mS); 	
  

  rly=dir; vi=vfim; v= 1.8V;  i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 0, VS_DVDD    );
  rly=dir; vi=vfim; v= 1.8V;  i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 1, VS_DVDD_CDR);
  rly=dir; vi=vfim; v= 6.0V;  i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 2, VS_PAVDD   );
  rly=dir; vi=vfim; v=-6.0V;  i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 3, VS_NAVDD   );
  rly=dir; vi=vfim; v= 21.0V; i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 4, VS_VGH1    );
  rly=dir; vi=vfim; v= 22.0V; i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 5, VS_VGH2    );
  rly=dir; vi=vfim; v=-10.0V; i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 6, VS_LVGL    );
  rly=dir; vi=vfim; v= -9.0V; i=200uA; irng=M800UA; vrng=R20V; uvipin_ary1( 7, VS_VGL     );
 
//=========================== Judge ===============================================================
  measure_dpsim.vsim(dpsvsim_ary1[0],dpsvsim_ary1[1],dpsvsim_ary1[2],dpsvsim_ary1[3],dpsvsim_ary1[4],dpsvsim_ary1[5],dpsvsim_ary1[6],dpsvsim_ary1[7]);
  measure_dpsim.limit(im_limit);
  measure_dpsim.Set();
  wait(1.0mS);
  measure_dpsim.Start();
  
  ARRAY<Amperes> idd_tmp(8);
  
  idd_tmp[0]=measure_dpsim.Get_PinVal(1, VS_DVDD    );
  idd_tmp[1]=measure_dpsim.Get_PinVal(1, VS_DVDD_CDR);
  idd_tmp[2]=measure_dpsim.Get_PinVal(1, VS_PAVDD   );
  idd_tmp[3]=measure_dpsim.Get_PinVal(1, VS_NAVDD   );
  idd_tmp[4]=measure_dpsim.Get_PinVal(1, VS_VGH1    );
  idd_tmp[5]=measure_dpsim.Get_PinVal(1, VS_VGH2    );
  idd_tmp[6]=measure_dpsim.Get_PinVal(1, VS_LVGL    );
  idd_tmp[7]=measure_dpsim.Get_PinVal(1, VS_VGL     );
  

  tno(1); cat(cat_isa_dvdd); dcmnt("DVDD     Standby Current aft");  judge(idd_tmp[0], -1.50uA, 140uA);
  tno(2); cat(cat_isa_dvdd); dcmnt("DVDD_CDR Standby Current aft");  judge(idd_tmp[1], -1.50uA,  70uA);
  tno(3); cat(cat_isa_avdd); dcmnt("PAVDD_L  Standby Current aft");  judge(idd_tmp[2], -1.50uA,  50uA);
  tno(4); cat(cat_isa_avdd); dcmnt("NAVDD_L  Standby Current aft");  judge(idd_tmp[3], -50.0uA, 1.5uA);
  tno(5); cat(cat_isa_avdd); dcmnt("VS_VGH1  Standby Current aft");  judge(idd_tmp[4], -1.50uA,  50uA);
  tno(6); cat(cat_isa_avdd); dcmnt("VS_VGH2  Standby Current aft");  judge(idd_tmp[5], -1.50uA,  50uA);
  tno(7); cat(cat_isa_avdd); dcmnt("VS_LVGL  Standby Current aft");  judge(idd_tmp[6], -50.0uA, 1.5uA);
  tno(8); cat(cat_isa_avdd); dcmnt("VS_VGL   Standby Current aft");  judge(idd_tmp[7], -50.0uA, 1.5uA);
  
  
////=========================== Judge ===============================================================
//  power_pclamp=400uA;
//
//  tno(1); cat(cat_isa_dvdd); dcmnt("DVDD Standby Current aft");
//
//  v=1.8V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_DVDD ); judge(im, -1.50uA, 140uA, I);
//
//  tno(2); cat(cat_isa_dvdd); dcmnt("DVDD_CDR Standby Current aft");
//
//  v=1.8V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_DVDD_CDR ); judge(im, -1.50uA, 70uA, I);
//
////=========================== Judge ===============================================================
//  wait(2mS);
//
//  tno(3); cat(cat_isa_avdd); dcmnt("PDVDD Standby Current aft");
//
//  v=6.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_PAVDD ); judge(im, -1.50uA, 50uA, I);
////=========================== Judge ===============================================================
//
//  tno(4); cat(cat_isa_avdd); dcmnt("NDVDD Standby Current aft");
//
//  v=-6.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_NAVDD ); judge(im, -50uA, 1.5uA, I);
////===========================================================================================
//
//  tno(5); cat(cat_isa_avdd); dcmnt("VGH1 Standby Current aft");
//
//  v=21.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_VGH1 ); judge(im, -1.50uA, 50uA, I);
////===========================================================================================
//
//  tno(6); cat(cat_isa_avdd); dcmnt("VGH2 Standby Current aft");
//
//  v=22.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_VGH2 ); judge(im, -1.50uA, 50uA, I);
////===========================================================================================
//
//  tno(7); cat(cat_isa_avdd); dcmnt("VGL Standby Current aft");
//
//  v=-10.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_VGL ); measure_dpsim.Start(); measure_dpsim.Start(); judge(im, -260uA, 1.5uA, I);
////  v=-10.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_VGL ); judge(im, -210uA, 1.5uA, I);
////===========================================================================================
//
//  tno(8); cat(cat_isa_avdd); dcmnt("LVGL Standby Current aft");
//
//  v=-9.0V; i=power_pclamp; irng=M800UA; vrng=R20V; uvipin( VS_LVGL ); judge(im, -50uA, 1.5uA, I);
//===========================================================================================
  fmt=fixl; vih=vih1; vil=vil1; pin(DPIN_PAD_TEST_SD);
//===========================================================================================
  //sr(off);
  POWER_OFF_FUNC1();
   

  rly=off; fmt=open; vih=vih1; vil=vil1; pin(ALL_IOPIN);
//===========================================================================================
  TSTime("Standby Current After Stress Test           ");

  return 0;

}

int idd()
{
  testno=power_f_testno;
  CW_Signals(int_Relay_Capa_PWR);

  int tmp_test_num=0;

  testno=11000;

  cw1_num[ 0]=0;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 2000MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  rly=dir; vi=vfim; v= 1.8V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 0, VS_DVDD    );
  rly=dir; vi=vfim; v= 1.8V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 1, VS_DVDD_CDR);
  rly=dir; vi=vfim; v= 6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin_ary1( 2, VS_PAVDD   );
  rly=dir; vi=vfim; v=-6.0V; i=400mA; irng=M800MA; vrng=R20V; uvipin_ary1( 3, VS_NAVDD   );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 4, VS_VGH1    );
  rly=dir; vi=vfim; v= 6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 5, VS_VGH2    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 6, VS_LVGL    );
  rly=dir; vi=vfim; v=-6.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 7, VS_VGL     );
  
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAL14   );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAR14   );

  rly=dir; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_VCOM_ALL );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_TX_H   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_TX_L   );

  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(ALL_IOPIN);

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(2); edge(rate2*0,rate2*0.5); pin(DPIN_PAD_LOCK   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD_MV_1);
  rly=off; fmt=open; vih=     6.0V; vil=    0.0V;  pin(DPIN_PAD_TEST_SD_MV_2);

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  //rly=dir; fmt=fixh; vih=2.2V; vil=vil_in[2]; pin(DPIN_PAD_CNT_L     );

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=off; mode=ppdz; rng=R10V; scan_mode=PIN_INC;scan_step=512; ravg=1;
  ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;
  //lcdoption=NONE;
  lcdoption=NONE;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

  mode=ppcp;
//================================================================================================  
	sr(on);

  rly=dir; vi=vfim; v=-1.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_VCOM_ALL );

  rvs_vs.SRng(R20V); rvs_vs.MRng(M10MA);
  rvs_vs.rvspin(RVS_PAD_TX_H  ); rvs_vs.SVal(   4.0V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_TX_L  ); rvs_vs.SVal(   0.9V); rvs_vs.Load();
  rvsunit_relay.rvspin(RVS_TX_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();
  
  wait(2mS);
  rvs_vs.rvspin( RVS_PAD_VGMAL1); rvs_vs.SVal(   5.8V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAL7); rvs_vs.SVal(   0.2V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAL8); rvs_vs.SVal(  -0.2V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_VGMAL14); rvs_vs.SVal(  -5.8V); rvs_vs.Load();

  rvs_vs.rvspin( RVS_PAD_VGMAR1); rvs_vs.SVal(   5.8V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAR7); rvs_vs.SVal(   0.2V); rvs_vs.Load();
  rvs_vs.rvspin( RVS_PAD_VGMAR8); rvs_vs.SVal(  -0.2V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_VGMAR14); rvs_vs.SVal(  -5.8V); rvs_vs.Load();

  rvsunit_relay.rvspin(RVS_GMA_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();

  wait(2mS);

  rly=dir; vi=vfim; v= 21.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 4, VS_VGH1    );
  rly=dir; vi=vfim; v= 22.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 5, VS_VGH2    );
  rly=dir; vi=vfim; v=-10.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 6, VS_LVGL    );
  rly=dir; vi=vfim; v= -9.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin_ary1( 7, VS_VGL     );

  wait(2mS); 	
//================================================================================================  
  wait(6.0mS);

  startadrn=0;
  stopadrn=0x3ffffdf; //Max
  fstop=off;
  
  patf("fn01a1_0101_ch1446_dpsel_4p_8b_shl_1_int_stb_1_reg_dpsel_en_1_25_0925.lpa");

  delay=10uS; avg=100; startadrn=0; stopadrn=0x3ffffdf; lstartadrn=0; lstopadrn=0x3ffffdf;

  pat( run, para );
  
  meas_dpsavrim.vsim(dpsvsim_ary1[0],dpsvsim_ary1[1],dpsvsim_ary1[2],dpsvsim_ary1[3],dpsvsim_ary1[4],dpsvsim_ary1[5],dpsvsim_ary1[6],dpsvsim_ary1[7]);
  meas_dpsavrim.limit(im_limit);
  meas_dpsavrim.pg(pg);
  meas_dpsavrim.Set();
  wait(1.0mS);
  meas_dpsavrim.Start();
  
  ARRAY<Amperes> idd_tmp(8);
  
  idd_tmp[0]=meas_dpsavrim.Get_PinVal(1, VS_DVDD    );
  idd_tmp[1]=meas_dpsavrim.Get_PinVal(1, VS_DVDD_CDR);
  idd_tmp[2]=meas_dpsavrim.Get_PinVal(1, VS_PAVDD   );
  idd_tmp[3]=meas_dpsavrim.Get_PinVal(1, VS_NAVDD   );
  idd_tmp[4]=meas_dpsavrim.Get_PinVal(1, VS_VGH1    );
  idd_tmp[5]=meas_dpsavrim.Get_PinVal(1, VS_VGH2    );
  idd_tmp[6]=meas_dpsavrim.Get_PinVal(1, VS_LVGL    );
  idd_tmp[7]=meas_dpsavrim.Get_PinVal(1, VS_VGL     );

  tno(1); cat(cat_icc); dcmnt("DVDD Current at AVDD=6.0V/-6.0V , DVDD=1.8, GS0101");     judge(idd_tmp[0],  -0.1mA,  48mA);
  tno(2); cat(cat_icc); dcmnt("DVDD_CDR Current at AVDD=6.0V/-6.0V , DVDD=1.8, GS0101"); judge(idd_tmp[1],  -0.1mA,  48mA);
  tno(3); cat(cat_icc); dcmnt("PAVDD_L Current at AVDD=6.0V/-6.0V , DVDD=1.8, GS0101");  judge(idd_tmp[2],  -0.1mA,  24mA);
  tno(4); cat(cat_icc); dcmnt("NAVDD_L Current at AVDD=6.0V/-6.0V , DVDD=1.8, GS0101");  judge(idd_tmp[3], -24.0mA,-0.1mA);
  tno(5); cat(cat_icc); dcmnt("VS_VGH1 Current at AVDD=6.0V/-6.0V , DVDD=1.8, GS0101");  judge(idd_tmp[4],  -0.1mA, 0.1mA);
  tno(6); cat(cat_icc); dcmnt("VS_VGH2 Current at AVDD=6.0V/-6.0V , DVDD=1.8, GS0101");  judge(idd_tmp[5],  -0.1mA, 0.1mA);
  tno(7); cat(cat_icc); dcmnt("VS_LVGL Current at AVDD=6.0V/-6.0V , DVDD=1.8, GS0101");  judge(idd_tmp[6],  -0.1mA,20.0uA);
  tno(8); cat(cat_icc); dcmnt("VS_VGL  Current at AVDD=6.0V/-6.0V , DVDD=1.8, GS0101");  judge(idd_tmp[7],  -0.1mA,20.0uA);

  pat(stop);
  
  //sr(off);
  POWER_OFF_FUNC1();
//===========================================================================================
  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
//===========================================================================================
  TSTime("Power Dynamic Current           ");

  return 0;

}
