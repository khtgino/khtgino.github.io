void tg(Seconds &abc)
{
  rate.rate(1, abc, 1);
  rate.Load();
}
void tg(Seconds &a,Seconds &b)
{
  rate.rate(1, a, 1);
  rate.rate(2, b, 1);
  rate.Load();
}
void tg(Seconds &a,Seconds &b,Seconds &c)
{
  rate.rate(1, a, 1);
  rate.rate(2, b, 1);
  rate.rate(3, c, 1);
  rate.Load();
}
void tg(Seconds &a,Seconds &b,Seconds &c,Seconds &d)
{
  rate.rate(1, a, 1);
  rate.rate(2, b, 1);
  rate.rate(3, c, 1);
  rate.rate(4, d, 1);
  rate.Load();
}
void wait(Seconds &a)
{
  waittime.time(a);
  waittime.PreExec();
}
void sr(int &a)
{
  switch(a)
  {
    case twobank:
        pg.start(NORMAL);
        pg.pend(ON);
        pg.Load();
    
        sequence.PreExec();
        break;
    case on:
        vectorreg.init();
        sequence.PreExec();
        break;
    default:
        pg.start(NORMAL);
        pg.pend(OFF);
        pg.Load();

        vectorreg.init();
        vectorfile.PostExec();
        sequence.PostExec();
        break;
  }
}

int bin2dec(ARRAY<int> bin_mm)
{ int bin_leng=bin_mm.len();
  int bin_ii,dec_mm;

  for( bin_ii=0;bin_ii<bin_leng;bin_ii=bin_ii+1)
  { dec_mm=dec_mm+bin_mm[bin_ii]*((int)pow(2,(double)bin_ii)); }

  return dec_mm;
}
int b4todec(int b7_mm3,int b7_mm2,int b7_mm1,int b7_mm0)
{ int bin_leng=4;
  int bin_ii,dec_mm;
  ARRAY<int> bin_mm(bin_leng);
  bin_mm[3]=b7_mm3;
  bin_mm[2]=b7_mm2;
  bin_mm[1]=b7_mm1;
  bin_mm[0]=b7_mm0;
  for( bin_ii=0;bin_ii<bin_leng;bin_ii=bin_ii+1)
  { dec_mm=dec_mm+bin_mm[bin_ii]*((int)pow(2,(double)bin_ii)); }

  return dec_mm;
}
int b7todec(int b7_mm7,int b7_mm6,int b7_mm5,int b7_mm4,int b7_mm3,int b7_mm2,int b7_mm1,int b7_mm0)
{ int bin_leng=8;
  int bin_ii,dec_mm;
  ARRAY<int> bin_mm(bin_leng);
  bin_mm[7]=b7_mm7;
  bin_mm[6]=b7_mm6;
  bin_mm[5]=b7_mm5;
  bin_mm[4]=b7_mm4;
  bin_mm[3]=b7_mm3;
  bin_mm[2]=b7_mm2;
  bin_mm[1]=b7_mm1;
  bin_mm[0]=b7_mm0;
  for( bin_ii=0;bin_ii<bin_leng;bin_ii=bin_ii+1)
  { dec_mm=dec_mm+bin_mm[bin_ii]*((int)pow(2,(double)bin_ii)); }

  return dec_mm;
}

string dec2bin(int dec_mm)
{ string bin_mm;
  int remainder,quotient,new_num1;

  remainder=dec_mm%2;
  quotient=dec_mm/2;
  bin_mm=string(remainder);
  if( dec_mm>=2 )
  {
  while( quotient>=2 )
  { remainder=quotient%2;
    quotient=quotient/2;
    bin_mm=string(remainder)+bin_mm;
  }
  bin_mm="1"+bin_mm;
  }
  int bin_leng=bin_mm.len();
  for( new_num1=bin_leng+1; new_num1<=18; new_num1+=1){ bin_mm="0"+bin_mm; }

  return bin_mm;
}
string dec2bin2(int dec_mm)
{ string bin_mm;
  int remainder,quotient,new_num1;

  remainder=dec_mm%2;
  quotient=dec_mm/2;
  if(remainder==1){ bin_mm="H"; }else{ bin_mm="L"; }
  if( dec_mm>=2 )
  {
  while( quotient>=2 )
  { remainder=quotient%2;
    quotient=quotient/2;
    if(remainder==1){ bin_mm="H"+bin_mm; }else{ bin_mm="L"+bin_mm; }
  }
  bin_mm="H"+bin_mm;
  }
  int bin_leng=bin_mm.len();
  for( new_num1=bin_leng+1; new_num1<=18; new_num1+=1){ bin_mm="L"+bin_mm; }

  return bin_mm;
}
