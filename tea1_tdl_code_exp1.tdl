  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 1500MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(2); edge(rate2*0,rate2*0.5); pin(DPIN_PAD_LOCK   );

   rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(2); edge(rate2*0,rate2*0.5); pin(GOA_I_GROUP_01   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );
  rly=off; fmt=open; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD_MV_1);
  rly=off; fmt=open; vih=     6.0V; vil=    0.0V;  pin(DPIN_PAD_TEST_SD_MV_2);

  //rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppdz; rng=R40V; scan_mode=PIN_INC;scan_step=58; ravg=1;
  ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;
  //lcdoption=NONE;
  lcdoption=NONE;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  //lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(GOA_O_GROUP_01);

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

//================================================================================================  

//================================================================================================  
  
  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();
  wait(6.0mS);

  tno(tmp_test_num++); cat(38);

  //--------------------------------------------------------------------
  patf("fn01a1_goa_num_01_ch1446_4p8b_shl_1_25_1008.lpa"); pat(run);  calcstart(GOA_O_GROUP_01 , goz_out_v01); //for( int_i=0 ; int_i<26*58 ; int_i+=1 ){ cout.width(8); cout<<goz_out_v01[int_i]<<",";  if( (int_i%26)==25){ cout<<"\n"; } }
  patf("fn01a1_goa_num_02_ch1446_4p8b_shl_1_25_1008.lpa"); pat(run);  calcstart(GOA_O_GROUP_01 , goz_out_v02); //for( int_i=0 ; int_i<26*58 ; int_i+=1 ){ cout.width(8); cout<<goz_out_v02[int_i]<<",";  if( (int_i%26)==25){ cout<<"\n"; } }
  patf("fn01a1_goa_num_03_ch1446_4p8b_shl_1_25_1008.lpa"); pat(run);  calcstart(GOA_O_GROUP_01 , goz_out_v03); //for( int_i=0 ; int_i<26*58 ; int_i+=1 ){ cout.width(8); cout<<goz_out_v03[int_i]<<",";  if( (int_i%26)==25){ cout<<"\n"; } }
  patf("fn01a1_goa_num_04_ch1446_4p8b_shl_1_25_1008.lpa"); pat(run);  calcstart(GOA_O_GROUP_01 , goz_out_v04); //for( int_i=0 ; int_i<26*58 ; int_i+=1 ){ cout.width(8); cout<<goz_out_v04[int_i]<<",";  if( (int_i%26)==25){ cout<<"\n"; } }
  patf("fn01a1_goa_num_05_ch1446_4p8b_shl_1_25_1008.lpa"); pat(run);  calcstart(GOA_O_GROUP_01 , goz_out_v05); //for( int_i=0 ; int_i<26*58 ; int_i+=1 ){ cout.width(8); cout<<goz_out_v05[int_i]<<",";  if( (int_i%26)==25){ cout<<"\n"; } }
