       if( lcd_os_V[os_ii1]< 0.2V ) { lcd_os_p[os_ii1]="S"; }
       if( lcd_os_V[os_ii1]> 1.0V ) { lcd_os_p[os_ii1]="O"; }
      //}
      //else
