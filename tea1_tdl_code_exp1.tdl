  gs0ff0_rms_result_01[1]=ary_mcmp(rms_vh_0ff0_d02_01,DVRMShlimit,DVRMSllimit)+ary_mcmp(rms_vl_0ff0_d02_01,DVRMShlimit,DVRMSllimit);
