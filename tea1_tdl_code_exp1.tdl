    path_pgma       = datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-pgma.asc";


    ofstream x01(path_dev_vh_avg, ios::app); 
      x01 << "X " << str_axis_x1 << " Y " << str_axis_y1 << " ";
      for(int_j=0;int_j<levelno;int_j++){ x01 << avg_pos_0101_d01_01[int_j] << " ";}
