//=========================== GS Code SP1 ========================================================
//=========================== No Chopper Limit = 45mV/30mV ========================================
Deviation(6.0V);

ARRAY<double>  dev_gs0101vh_hlimit_165V_sp1(lcdpinno*levelno);
ARRAY<double>  dev_gs0101vh_llimit_165V_sp1(lcdpinno*levelno);
ARRAY<double>  dev_gs0101vl_hlimit_165V_sp1(lcdpinno*levelno);
ARRAY<double>  dev_gs0101vl_llimit_165V_sp1(lcdpinno*levelno);

ARRAY<double>  dev_gs0h0lvh_hlimit_165V_sp1(lcdpinno*levelno);
ARRAY<double>  dev_gs0h0lvh_llimit_165V_sp1(lcdpinno*levelno);
ARRAY<double>  dev_gs0h0lvl_hlimit_165V_sp1(lcdpinno*levelno);
ARRAY<double>  dev_gs0h0lvl_llimit_165V_sp1(lcdpinno*levelno);

//--- double to voltage (ideal SPEC)
for(int_j=0; int_j<levelno; int_j++){
  douArray_gamma_positive_float[int_j]=ideal_positive_float[int_j]/1.0V;
  douArray_gamma_negative_float[int_j]=ideal_negative_float[int_j]/1.0V;
}


for(int_j=0; int_j<levelno; int_j++)
 {

    limit=0.060;
    if(   0<=int_j && int_j< 16 ){ limit=0.090; }
    if(  16<=int_j && int_j< 32 ){ limit=0.050; }
    if(  32<=int_j && int_j<223 ){ limit=0.035; }
    if( 223<=int_j && int_j<240 ){ limit=0.050; }
    if( 240<=int_j && int_j<253 ){ limit=0.090; }
    if( 253<=int_j && int_j<256 ){ limit=0.090; }


  for(int_i=0; int_i<lcdpinno; int_i++)
  {

        dev_gs0101vl_hlimit_165V_sp1[lcdpinno*int_j+int_i]=(ideal_negative_0101_sp1[int_j]/1.0V)+limit;
        dev_gs0101vl_llimit_165V_sp1[lcdpinno*int_j+int_i]=(ideal_negative_0101_sp1[int_j]/1.0V)-limit;
        dev_gs0101vh_hlimit_165V_sp1[lcdpinno*int_j+int_i]=(ideal_positive_0101_sp1[int_j]/1.0V)+limit;
        dev_gs0101vh_llimit_165V_sp1[lcdpinno*int_j+int_i]=(ideal_positive_0101_sp1[int_j]/1.0V)-limit;

        dev_gs0h0lvl_hlimit_165V_sp1[lcdpinno*int_j+int_i]=(ideal_negative_0h0l_sp1[int_j]/1.0V)+limit;
        dev_gs0h0lvl_llimit_165V_sp1[lcdpinno*int_j+int_i]=(ideal_negative_0h0l_sp1[int_j]/1.0V)-limit;
        dev_gs0h0lvh_hlimit_165V_sp1[lcdpinno*int_j+int_i]=(ideal_positive_0h0l_sp1[int_j]/1.0V)+limit;
        dev_gs0h0lvh_llimit_165V_sp1[lcdpinno*int_j+int_i]=(ideal_positive_0h0l_sp1[int_j]/1.0V)-limit;

  }
 }

