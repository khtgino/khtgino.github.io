  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-1 MIN Ratio");  judge( (sxmux_p1_avg_s2-sxmux_p1_min_s2)/sxmux_p1_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-2 MAX Ratio");  judge( (sxmux_p2_max_s2-sxmux_p2_avg_s2)/sxmux_p2_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-2 MIN Ratio");  judge( (sxmux_p2_avg_s2-sxmux_p2_min_s2)/sxmux_p2_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-3 MAX Ratio");  judge( (sxmux_p3_max_s2-sxmux_p3_avg_s2)/sxmux_p3_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-3 MIN Ratio");  judge( (sxmux_p3_avg_s2-sxmux_p3_min_s2)/sxmux_p3_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-4 MAX Ratio");  judge( (sxmux_p4_max_s2-sxmux_p4_avg_s2)/sxmux_p4_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-4 MIN Ratio");  judge( (sxmux_p4_avg_s2-sxmux_p4_min_s2)/sxmux_p4_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-5 MAX Ratio");  judge( (sxmux_p5_max_s2-sxmux_p5_avg_s2)/sxmux_p5_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-5 MIN Ratio");  judge( (sxmux_p5_avg_s2-sxmux_p5_min_s2)/sxmux_p5_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-6 MAX Ratio");  judge( (sxmux_p6_max_s2-sxmux_p6_avg_s2)/sxmux_p6_avg_s2 , 0.005 , 0.09 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH ADC SXMUX-6 MIN Ratio");  judge( (sxmux_p6_avg_s2-sxmux_p6_min_s2)/sxmux_p6_avg_s2 , 0.005 , 0.09 );

  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_L  Freq");  judge( 1/(OSC_P1*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_L1 Freq");  judge( 1/(OSC_P2*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_L2 Freq");  judge( 1/(OSC_P3*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_R  Freq");  judge( 1/(OSC_P4*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_R1 Freq");  judge( 1/(OSC_P5*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-GRID_R2 Freq");  judge( 1/(OSC_P6*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );
  //tno(tmp_test_num++); cat(69); dcmnt("TOUCH SXMUX-7 Freq");  judge( 1/(OSC_P7*rate1) , 50.0KHz*0.90 , 50.0KHz*1.10 );

//================================================================================================
  adc_sxmux_f1.close();
  wait(1mS);
//===========================================================================================
  dfm.type(DFM_FAILSTORE);
  dfm.begin(0);
  dfm.end(0x3ffffdf);
  dfm.fcnt(4095);
  dfm.Load();
  
  pat(stop);
  //sr(off);
  POWER_OFF_FUNC1();
  
//  /*************************  HSIF  ***********************************/
////dutoffest.pinlist(ALL_IOPIN);
////dutoffest.timing(0nS);
////dutoffest.Load();
////dutoffest.ClearAll();
