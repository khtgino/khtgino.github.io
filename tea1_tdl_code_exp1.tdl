  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
