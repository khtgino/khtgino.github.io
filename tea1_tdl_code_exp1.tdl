  //sr(off);
  POWER_OFF_FUNC1();
  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("GOA Function Test ");

  return 0;
}
int term_resistor()
{
  Ohms std_terminal_r=120R;
  Ohms r1pn;
  Ohms r2pn;
  Ohms r3pn;
  Ohms r4pn;
  Ohms r5pn;
  Ohms r6pn;
  Ohms r7pn;
  Ohms r8pn;

  Amperes I_val=2000uA; //RD comment
  Amperes I1P_val;
  Amperes I2P_val;
  Amperes I3P_val;
  Amperes I4P_val;
  Amperes I5P_val;
  Amperes I6P_val;
  Amperes I7P_val;
  Amperes I8P_val;
  Volts V1P_val;
  Volts V2P_val;
  Volts V3P_val;
  Volts V4P_val;
  Volts V5P_val;
  Volts V6P_val;
  Volts V7P_val;
  Volts V8P_val;
  Volts VP_val;
  Volts VN_val=0.80V;

  testno=leak_testno+100;

  cw1_num[ 0]=0;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//============================================================================================
  freq  = 1000MHz;

  rate1 = (1/freq)*32;
  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (1.8V)*1.0;
  vil_in[1]  = (1.8V)*0.0;
  vih_in[2]  = (1.8V)*1.0;
  vil_in[2]  = (1.8V)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (1.8V)*0.7;
  vol_in[1]  = (1.8V)*0.3;
  voh_in[2]  = (1.8V)*0.7;
  vol_in[2]  = (1.8V)*0.3;
  
  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();
  
//============================================================================================
  hsif_all_l.pinlist(ALL_HSIF_PIN);
  hsif_all_l.vih(VN_val);
  hsif_all_l.vil(VN_val);
  hsif_all_l.voh(voh);
  hsif_all_l.vol(vol);
  hsif_all_l.Load();

  hsif_all_t.pinlist(ALL_DATA_N); //N Connect
  hsif_all_t.kind(IN);
  hsif_all_t.wavekind(0,FIXH); //output VIL
  hsif_all_t.Load();

  hsif_all_t.pinlist(ALL_DATA_P); //P Open, N input VCOM=VIH+VIL/2
  hsif_all_t.kind(OPEN);
  hsif_all_t.Load();

  TEST.Set();
  vm_limit.upper(NONE);
  vm_limit.lower(NONE);
  vm_limit.Load();

  isvm.Resc(MDC);
  isvm.SRng(R8MA);
  isvm.MRng(M8V);
  isvm.SVal(I_val);
  isvm.CPVal(1.7V);
  isvm.CMVal(1.7V*-1);
  isvm.Load();

  sr(on);

  measure_vm.pinlist(ALL_DATA_P);
  measure_vm.isvm(isvm);
  measure_vm.limit(vm_limit);
  measure_vm.sequence(seq_vm);
  measure_vm.Set();
  measure_vm.Start();

  V1P_val=measure_vm.Get_PinVal(1,HSIF_PAD_DATA0P);
  V2P_val=measure_vm.Get_PinVal(1,HSIF_PAD_DATA1P);
  V3P_val=measure_vm.Get_PinVal(1,HSIF_PAD_DATA2P);
  V4P_val=measure_vm.Get_PinVal(1,HSIF_PAD_DATA3P);

  r1pn=(V1P_val-VN_val)/I_val-50R;
  r2pn=(V2P_val-VN_val)/I_val-50R;
  r3pn=(V3P_val-VN_val)/I_val-50R;
  r4pn=(V4P_val-VN_val)/I_val-50R;

  tno(1); cat(cat_t_resistor); dcmnt("DATA0PN Terminal Resistor Test");
  TEST.Set();
  judge_limit.upper(std_terminal_r*1.3);
  judge_limit.lower(std_terminal_r*0.7);
  judgedata.limit(judge_limit);
  judgedata.value(r1pn);
  judgedata.type(DC);
  judgedata.Exec();

  tno(2); cat(cat_t_resistor); dcmnt("DATA1PN Terminal Resistor Test");
  TEST.Set();
  judgedata.value(r2pn);
  judgedata.type(DC);
  judgedata.Exec();

  tno(3); cat(cat_t_resistor); dcmnt("DATA2PN Terminal Resistor Test");
  TEST.Set();
  judgedata.value(r3pn);
  judgedata.type(DC);
  judgedata.Exec();

  tno(4); cat(cat_t_resistor); dcmnt("DATA3PN Terminal Resistor Test");
  TEST.Set();
  judgedata.value(r4pn);
  judgedata.type(DC);
  judgedata.Exec();
//============================================================================================
  sr(off);
  
  hsif_all_t.pinlist(ALL_HSIF_PIN);
  hsif_all_t.kind(OPEN);
  hsif_all_t.Load();
  
  if(exit.branch()!=0) return 0; //--fail on/off flag
//============================================================================================
  TSTime("TERMINAL RESISTOR TEST                       ");

  return 0;

}

