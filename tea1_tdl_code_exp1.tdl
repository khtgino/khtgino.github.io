  rate2 = (1/freq)*32;
  rate3 = (1/freq)*32;
  rate4 = (1/freq)*32;

  str_vdd =string(1.8V);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =shm_n04*0.1V;  //0.6V;
  Vdiff_p2p  =shm_n05*1.0mV; //300mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (shm_dvdd)*1.0;
  vil_in[1]  = (shm_dvdd)*0.0;
  vih_in[2]  = (shm_dvdd)*1.0;
  vil_in[2]  = (shm_dvdd)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (shm_dvdd)*0.7;
  vol_in[1]  = (shm_dvdd)*0.3;
  voh_in[2]  = (shm_dvdd)*0.7;
  vol_in[2]  = (shm_dvdd)*0.3;

  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS); 
//================================= power / level setting ==================================
  POWER_INIT_FUNC(shm_dvdd, 6.0V);

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(ON,rate1,rate2,rate3,rate4);

  HSIF_PIN_SET( ALL_HSIF_PIN , HSIFNRZ , 0.0nS , vih_in[0] , vil_in[0] );

  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;
  t(1); drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS; edge(rate1*0,rate1*0.5); pin(ALL_INPIN);

//=========================== FIXH/L Setting ======================================================
 
  drel=rate1*1/4; dret=rate1*3/4; strb=rate1*2/4-1nS;strt=rate1*4/4-1nS;
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); pin(DPIN_PAD_STB    );

  vih=vih_in[2]; vil=vil_in[2]; voh=(1.8V)*0.5;vol=(1.8V)*0.5; vt=+1.9V;ilh=-200uA;ill=200uA; pin(DPIN_PAD_LOCK   );
  rly=on;  fmt=NRZ1; option=ptmux; iokindsel=IO;  t(1); edge(rate1*0,rate1*0.5); signal_timing.option(IL,PTMUX); pin(DPIN_PAD_LOCK   );
  
  rly=dir; fmt=fixl; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_SD     );

  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_TEST_DIP_EN);
//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=off; mode=ppcp; rng=R10V; scan_mode=PIN_INC;scan_step=512; ravg=1;
  ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
  lcdvoh= 1.2V;lcdvol= -1.2V;
  //lcdoption=NONE;
  lcdoption=LCDVT1;
  
  lcdstrb1 =rate1/2;
  lcdstrb2 =rate1/2;
  lcdstrb3 =rate1/2;
  lcddigit1=rate1/2;
  lcddigit2=rate1/2;
  lcddigit3=rate1/2;

  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
    
  lcdpin(ALL_LCD);
  if( test_chip_num==101 ){ lcdpin(ALL_LCD);    }
  if( test_chip_num==102 ){ lcdpin(ALL_LCD);    }
  if( test_chip_num==103 ){ lcdpin(ALL_LCD);    }

  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

  mode=ppcp;

//================================================================================================  
  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();
  wait(7.0mS);

  tno(tmp_test_num++); cat(17); TSTime("keyboard_pat_run");
                     
  if( shm_n03== 1 ){ patf("fn01_keyboard_plus_ch1446_dpsel_4p_bsel_1_shl_1_25_1224_1.lpa"); }
  if( shm_n03== 2 ){ patf("fn01_keyboard_plus_ch1446_dpsel_4p_bsel_1_shl_1_25_1224.lpa"); }
  if( shm_n03== 3 ){ patf("fn01_keyboard_plus_ch1446_dpsel_4p_bsel_1_shl_1_25_1219.lpa"); }
                
  meas(result , ee_ck01);
  pat_result=ee_ck01;
  
  if( ee_ck01==0 && pat_result==0 && ee_ck02!=0 ){ print "P"; vdd_tmp_02=shm_n01*0.01V;             }
  if( ee_ck01==0 && pat_result==0 && ee_ck02==0 ){ print "P"; vdd_tmp_01=shm_n01*0.01V; ee_ck02=1;  }
  if( ee_ck01!=0 && pat_result==0               ){ print "X";                             } 
  if( ee_ck01==0 && pat_result!=0               ){ print "-";                             } 
  if( ee_ck01!=0 && pat_result!=0               ){ print ".";                             } 

  pat(stop);

  }
  if( ee_ck02==0 ){ print " ALL FAIL\n"; }
  if( ee_ck02!=0 ){ cout.width(7); cout<<" Pass vdd :"<<vdd_tmp_01<<"~"; cout.width(7); cout<<vdd_tmp_02<<"\n"; }
  }

  print "           +-----------------------+     \n";
  print "          2.40V                   1.20V\n\n";
  }}}}}
  
//===========================================================================================
//===========================================================================================

  //sr(off);
  POWER_OFF_FUNC1();

  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("GS_HRD 1 & 2-Pair Pattern Run                ");

  return 0;
}

