{
  aqmdata.unit(MDGT);
  aqmdata.mode(PIN_INC);
  aqmdata.step(scan_step);
  aqmdata.sGet_Data(1,i_data);
}
void calcstart(ARRAY<double> &i_data1,ARRAY<double> &i_data2)
{
  
  aqmdata.unit(MDGT);
  aqmdata.mode(PIN_INC);
  aqmdata.step(scan_step);
  aqmdata.sGet_Data(1,i_data1);
  aqmdata.sGet_Data(2,i_data2);
}
void lcd_meas(ARRAY<double> &data,ARRAY<double> &j_hlimit,ARRAY<double> &j_llimit)
{
  TEST.Set();

  judge_limit.upper(0.5);  judge_limit.lower(-0.5);
  judgedata.limit(judge_limit);
  judgedata.value(ary_mcmp(data,j_hlimit,j_llimit));
  judgedata.type(DC);
  judgedata.Exec();

}
void lcd_meas(ARRAY<double> &data,ARRAY<double> &j_hlimit,ARRAY<double> &j_llimit,ARRAY<int> &f_point)
{
  TEST.Set();

  judge_limit.upper(0.5);  judge_limit.lower(-0.5);
  judgedata.limit(judge_limit);
  judgedata.value(ary_mcmp(data,j_hlimit,j_llimit,f_point));
  judgedata.type(DC);
  judgedata.Exec();

  Test_Result=judgedata.Get_Result(1);
}
void lcd_meas(ARRAY<double> &data,ARRAY<double> &j_hlimit,int &j_llimit)
{
  TEST.Set();

  judge_limit.upper(0.5);  judge_limit.lower(-0.5);
  judgedata.limit(judge_limit);
  judgedata.value(ary_mcmp(data,j_hlimit,j_llimit));
  judgedata.type(DC);
  judgedata.Exec();

}
void lcd_meas(ARRAY<double> &data,int &j_hlimit,ARRAY<double> &j_llimit)
{
  TEST.Set();

  judge_limit.upper(0.5);  judge_limit.lower(-0.5);
  judgedata.limit(judge_limit);
  judgedata.value(ary_mcmp(data,j_hlimit,j_llimit));
