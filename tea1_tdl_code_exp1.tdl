//
////HSIF_CTRL.trig(OFF);
////HSIF_CTRL.Load();  

  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("Touch SXMUX           ");

  return 0;
}
int touch_sxmux_eng4(Volts &tmp_vdd1)
{
  int tmp_test_num=0;


  testno=69000;

  cw1_num[ 0]=0;  // [0]: off  , [1]: on  ==> DVDD         <-> Cap (10uF)
  cw1_num[ 1]=0;  // [0]: off  , [1]: on  ==> DVDD_CDR     <-> Cap (10uF)
  cw1_num[ 2]=0;  // [0]: off  , [1]: on  ==> NAVDD        <-> Cap (10uF)
  cw1_num[ 3]=0;  // [0]: off  , [1]: on  ==> PAVDD        <-> Cap (10uF)
  cw1_num[ 4]=0;  // [0]: off  , [1]: on  ==> VGH1         <-> Cap (10uF)
  cw1_num[ 5]=0;  // [0]: off  , [1]: on  ==> VGH2         <-> Cap (10uF)
  cw1_num[ 6]=0;  // [0]: off  , [1]: on  ==> VGL          <-> Cap (10uF)
  cw1_num[ 7]=0;  // [0]: off  , [1]: on  ==> VGHO1        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 8]=0;  // [0]: off  , [1]: on  ==> VGHO2        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[ 9]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> CW07-#8 / CW08-#8 / CW11-#8 /CW12-#8
  cw1_num[10]=0;  // [0]: off  , [1]: on  ==> VG_CAP_REF_L <-> VG_CAP_REF_R
  cw1_num[11]=0;  // [0]: off  , [1]: on  ==> LVGLO        <-> Cap ( 1uF)  to CW09-#8
  cw1_num[12]=0;  // [0]: off  , [1]: on  ==> VGLO         <-> Cap ( 1uF)  to CW09-#8
  cw1_num[13]=0;  // [0]: 
  cw1_num[14]=0;  // [0]: 
  cw1_num[15]=0;  // [0]: 
  cw1_num[16]=0;  // [0]: 
  cw1_num[17]=0;  // [0]: 
  cw1_num[18]=0;  // [0]: 
  cw1_num[19]=0;  // [0]: 
  cw1_num[20]=0;  // [0]: 
  cw1_num[21]=0;  // [0]: 
  cw1_num[22]=0;  // [0]: 
  cw1_num[23]=0;  // [0]: 
  cw1_num[24]=0;  // [0]: 
  cw1_num[25]=0;  // [0]: 
  cw1_num[26]=0;  // [0]: 
  cw1_num[27]=0;  // [0]: 
  cw1_num[28]=0;  // [0]: 
  cw1_num[29]=0;  // [0]: 
  cw1_num[30]=0;  // [0]: 
  cw1_num[31]=0;  // [0]: 
  cw2_num[ 0]=0;  // [0]: 
  cw2_num[ 1]=0;  // [0]: 
  cw2_num[ 2]=0;  // [0]: 
  cw2_num[ 3]=0;  // [0]: 
  cw2_num[ 4]=0;  // [0]: 
  cw2_num[ 5]=0;  // [0]: 
  cw2_num[ 6]=0;  // [0]: 
  cw2_num[ 7]=0;  // [0]: 
  cw2_num[ 8]=0;  // [0]: 
  cw2_num[ 9]=0;  // [0]: 
  cw2_num[10]=0;  // [0]: 
  cw2_num[11]=0;  // [0]: 
  cw2_num[12]=0;  // [0]: 
  cw2_num[13]=0;  // [0]: 
  cw2_num[14]=0;  // [0]: 
  cw2_num[15]=0;  // [0]: 
  cw2_num[16]=0;  // [0]:
  cw2_num[17]=0;  // [0]:
  cw2_num[18]=0;  // [0]:
  cw2_num[19]=0;  // [0]:
  cw2_num[20]=0;  // [0]:
  cw2_num[21]=0;  // [0]:
  cw2_num[22]=0;  // [0]:
  cw2_num[23]=0;  // [0]:
  cw2_num[24]=0;  // [0]:
  cw2_num[25]=0;  // [0]: 
  cw2_num[26]=0;  // [0]: 
  cw2_num[27]=0;  // [0]: 
  cw2_num[28]=0;  // [0]: 
  cw2_num[29]=0;  // [0]: 
  cw2_num[30]=0;  // [0]: 
  cw2_num[31]=0;  // [0]: 

  CW_Set();

//================================== variable setting ======================================
  freq  = 40MHz;

  rate1 = (1/freq)*1;
  rate2 = (1/freq)*1;
  rate3 = (1/freq)*1;
  rate4 = (1/freq)*1;

  str_vdd =string(tmp_vdd1);
  str_avdd=string(6.0V);
  str_freq=string(freq); 

  call(gama_get);

  VCOM       =0.6V;
  Vdiff_p2p  =150mV;
  
  vih_in[0]  = VCOM + Vdiff_p2p/4.0 * swing_offset;
  vil_in[0]  = VCOM - Vdiff_p2p/4.0 * swing_offset;
  vih_in[1]  = (tmp_vdd1)*1.0;
  vil_in[1]  = (tmp_vdd1)*0.0;
  vih_in[2]  = (tmp_vdd1)*1.0;
  vil_in[2]  = (tmp_vdd1)*0.0;

  voh_in[0]  = VCOM ;
  vol_in[0]  = VCOM ;
  voh_in[1]  = (tmp_vdd1)*0.5;
  vol_in[1]  = (tmp_vdd1)*0.5;
  voh_in[2]  = 1.2V;
  vol_in[2]  = 1.2V;

  Volts sine_vt=2.5V;

  ALL_OPEN(ALL_IOPIN,ALL_LCDPIN,ALL_RVS);
//================================= power / level setting ==================================
  POWER_INIT_FUNC();
  rly=dir; vi=vfim; v= tmp_vdd1; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
  rly=dir; vi=vfim; v= tmp_vdd1; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);

//=========================== Format / Timing Setting =============================================
  TIME_RATE_SET(OFF,rate1,rate2,rate3,rate4);

  rly=on; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(TOURCH_GP01);
  rly=on; fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

//=========================== FIXH/L Setting ======================================================
  rly=on;  fmt=NRZ1; option=NONE; iokindsel=IO; t(1); edge(rate1*0); pin(TOURCH_GP01);

  rly=off; fmt=OPEN; vih=1.80V; vil=vil_in[2]; pin(DPIN_PAD_LOCK);
  rly=dir; fmt=fixh; vih=vih_in[2]; vil=vil_in[2]; pin(DPIN_PAD_LOCK);

  rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IN; t(1); edge(rate1*0); pin(DPIN_PAD_XON);
  rly=on;  fmt=NRZ1; option=HINIT; iokindsel=IN; t(1); edge(rate1*0); pin(DPIN_PAD_WAKE);

  rly=off; fmt=OPEN; option=NONE; pin(GRID_02);

  rly=on;  fmt=FIXH; pin(DPIN_PAD_XON);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_WAKE);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_STB);

  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_08);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_09);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_10);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_11);
  rly=on;  fmt=FIXH; pin(DPIN_PAD_TEST_DIP_I_12);
//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppcp; rng=R10V; scan_mode=STEP_INC;scan_step=512; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-0uA; iol=0uA; vt1=0V;vt2=0V;
  lcdoption=NONE; lcdvoh= 1.2V;lcdvol= 0.6V;
  
  lcdstrb1 =rate1-4nS;
  lcdstrb2 =rate2-4nS;
  lcdstrb3 =rate3-4nS;
  lcddigit1=rate1-4nS;
  lcddigit2=rate2-4nS;
  lcddigit3=rate3-4nS;

  lcdsamp.samp(1,lcddigit1);
  lcdsamp.samp(2,lcddigit2);
  lcdsamp.samp(3,lcddigit3);
  lcdsamp.samp(4,lcddigit4);
  lcdsamp.Load();
  
  lcdstrb.strb(1,lcdstrb1);
  lcdstrb.strb(2,lcdstrb2);
  lcdstrb.strb(3,lcdstrb3);
  lcdstrb.strb(4,lcdstrb4);
  lcdstrb.option(lcdstrboption);
  lcdstrb.Load();
        
  lcdpin(ALL_LCD);
  lcdpin(LCD_PAD_VG_CAP_REF_L);
  lcdpin(LCD_PAD_VG_CAP_REF_R);
  
  lcd_event.wavekind(NRZ1);
  lcd_event.Load();

  mode=ppcp;

//================================================================================================
  ofstream adc_sxmux_f4(datapath+str_wafer_id+"-"+projectcode+"-"+wafer_time_word+"-sxmux4-data.asc", ios::app); 

  ExDMEM exdmem;
  long long int dmem_cnt_1,dmem_cnt_2;
  ARRAY<int> sxmux_ary_data1(482*8*7);

  ARRAY<int> sxmux_dec9_all(482*7+20);
  ARRAY<int> sxmux_dec1_all(482*7);
  ARRAY<int> sxmux_dec2_all(482*7/2);

  ARRAY<int> sxmux_dec2_p1(482/2),sxmux_dec2_p1_s1(241-3),sxmux_dec2_p1_s2(241-3);
  ARRAY<int> sxmux_dec2_p2(482/2),sxmux_dec2_p2_s1(241-3),sxmux_dec2_p2_s2(241-3);
  ARRAY<int> sxmux_dec2_p3(482/2),sxmux_dec2_p3_s1(241-3),sxmux_dec2_p3_s2(241-3);
  ARRAY<int> sxmux_dec2_p4(482/2),sxmux_dec2_p4_s1(241-3),sxmux_dec2_p4_s2(241-3);
  ARRAY<int> sxmux_dec2_p5(482/2),sxmux_dec2_p5_s1(241-3),sxmux_dec2_p5_s2(241-3);
  ARRAY<int> sxmux_dec2_p6(482/2),sxmux_dec2_p6_s1(241-3),sxmux_dec2_p6_s2(241-3);
  ARRAY<int> sxmux_dec2_p7(482/2),sxmux_dec2_p7_s1(241-3),sxmux_dec2_p7_s2(241-3);

