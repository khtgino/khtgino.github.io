void CW_Signals(int &cw_signal)
{
  cw_object.cw(cw_signal);
  cw_object.Load();
}
void CW_Set()
{ int cw_ii;
  int cw_signal;
  
  cw_signal=0;
  for( cw_ii=0; cw_ii<32; cw_ii=cw_ii+1 )
   { cw_signal=cw_signal+(cw1_num[cw_ii]<<(cw_ii)); }
  cw_object.cw(cw_signal);
  cw_object.Load();

  //cw_signal=0;
  //for( cw_ii=0; cw_ii<32; cw_ii=cw_ii+1 )
  // { cw_signal=cw_signal+(cw2_num[cw_ii]<<(cw_ii)); }
  //cw2_object.cw(cw_signal);
  //cw2_object.Load();
}
void Disp_OS(int start_pin,int stop_pin,ARRAY<int> meas_data) 
{
  int pin_counter=0;
  int jdg;
  
  for (int j=start_pin; j<=stop_pin; j++)
   {
    jdg = meas_data[j-1];
    if(pin_counter==10){print " ";pin_counter=0;}

    if(jdg==0) print ".";  //Pass
    if(jdg==2) print "O";  //L Fail
    if(jdg==1) print "S";  //H Fail
    if(jdg==-3) print "x"; //Don't care
    pin_counter++;
   }
}
void Show_contact_result(int vs_num,ARRAY<int> vs_meas,int rvs_num,ARRAY<int> rvs_meas,int dp_num,ARRAY<int> dp_meas,int lcd_num,ARRAY<int> lcd_meas)
{
        print "[ Device pins contact check ]   ( .:pass / O:open / S:short / x:nc )\n";
        print "                 |         1          2          3          4          5\n";
        print "                 |1234567890 1234567890 1234567890 1234567890 1234567890\n";
        print "------------------------------------------------------------------------\n";
        
    int_PinCounter=1;
        for (int_i=vs_num;int_i>0;int_i=int_i-50)
        {
            if (int_i<50) {
                  print "VS  PIN ",int_PinCounter,"-",int_PinCounter+49,"     |";
                  Disp_OS(int_PinCounter,vs_num,vs_meas);
            }
            int_PinCounter=int_PinCounter+50;
            print "\n";
        }
        int_PinCounter=1;
        for (int_i=rvs_num;int_i>0;int_i=int_i-50) 
        {
            if (int_i<50) 
            {
                  print "RVS PIN ",int_PinCounter,"-",int_PinCounter+49;
                  if (int_PinCounter<50) { print "     |";}
                  if (int_PinCounter>50&&int_PinCounter<100) { print "   |";}
                  if (int_PinCounter>100) { print "  |";}
                  Disp_OS(int_PinCounter,rvs_num,rvs_meas);
            }
            if (int_i>=50) 
            {
                  print "RVS PIN ",int_PinCounter,"-",int_PinCounter+49;
                  if (int_PinCounter<50) print "     |";
                  if (int_PinCounter>50&&int_PinCounter<100) print "   |";
                  if (int_PinCounter>100) print "  |";
                  Disp_OS(int_PinCounter,int_PinCounter+49,rvs_meas);
            }
            int_PinCounter=int_PinCounter+50;
            print "\n";
        }
        int_PinCounter=1;
        for (int_i=dp_num;int_i>0;int_i=int_i-50) 
        {
              if (int_i<50) 
              {
                  print "I/O PIN ",int_PinCounter,"-",int_PinCounter+49;
                  if (int_PinCounter<50) print "     |";
                  if (int_PinCounter>50&&int_PinCounter<100) print "   |";
                  if (int_PinCounter>100) print "  |";
                  Disp_OS(int_PinCounter,dp_num,dp_meas);
              }
              if (int_i>=50) 
              {
                  print "I/O PIN ",int_PinCounter,"-",int_PinCounter+49;
                  if (int_PinCounter<50) print "     |";
                  if (int_PinCounter>50&&int_PinCounter<100) print "   |";
                  if (int_PinCounter>100) print "  |";
                  Disp_OS(int_PinCounter,int_PinCounter+49,dp_meas);
              }
              int_PinCounter=int_PinCounter+50;
              print "\n";
        }
        int_PinCounter=1;
        for (int_i=lcd_num;int_i>0;int_i=int_i-50) 
        {
              if (int_i<50) 
              {
                  print "LCD PIN ",int_PinCounter,"-",int_PinCounter+49;
                  if (int_PinCounter<50) print "     |";
                  if (int_PinCounter>50&&int_PinCounter<100) print "   |";
                  if (int_PinCounter>100) print "  |";
                  Disp_OS(int_PinCounter,lcd_num,lcd_meas);
              }
              if (int_i>=50) 
              {
                  print "LCD PIN ",int_PinCounter,"-",int_PinCounter+49;
                  if (int_PinCounter<50) print "     |";
                  if (int_PinCounter>50&&int_PinCounter<100) print "   |";
                  if (int_PinCounter>100) print "  |";
                  Disp_OS(int_PinCounter,int_PinCounter+49,lcd_meas);
              }
              int_PinCounter=int_PinCounter+50;
              print "\n";
        }
        print "\n";
}

void Plot_WS(int pin_max,ARRAY<double> &disp_data,string disp_title)
{
      int gs;
      int gs_max;
      int pin;
      int index;    
      
      gs_max=disp_data.len()/pin_max;
      index=0;    
      ARRAY<double> x_axis(pin_max*gs_max); //pin*gs
      for(gs=0;gs<gs_max;gs++)
      {
          for(pin=1;pin<=pin_max;pin++)
          {
               x_axis[index]=gs+pin*0.001;
               index++;
          }
      }    
      wscope.title(disp_title);
      wscope.y_axis(disp_data);
      wscope.x_axis(x_axis);
      wscope.Exec();
}
void Plot_WS(ARRAY<double> &disp_data,string disp_title)
{ 
      wscope.title(disp_title);
      wscope.y_axis(disp_data);
      wscope.Exec();
}
void Plot_WS(ARRAY<int> &disp_data,string disp_title)
{ 
      wscope.title(disp_title);
      wscope.y_axis(disp_data);
      wscope.Exec();
}
void ALL_OPEN(PINLIST &tmp_dpin , LCDPINLIST &tmp_lcdpin , RVSPINLIST &tmp_rvspin)
{  
  rly=off; fmt=NRZ1; option=NONE; iokindsel=IO;
  drel=rate1*0.0; dret=rate1*0.0; strb=rate1*0.0;strt=rate1*0.0;
  t(1); edge(rate1*0/4); pin(tmp_dpin);

  lcdvoh=0V; lcdvol=0V;
  lcdrly=off; mode=ppcp; rng=R40V; ioh=-100uA; iol=100uA; vt1=-2V; vt2=2V;
  lcdoption=NONE;
  signallcd.vt(NONE);
  signallcd.ilh(NONE);
  signallcd.ill(NONE);
  lcdpin(tmp_lcdpin);

  rly=off; vi=vfim; i=100uA; irng=M80UA; v=10V; vrng=R40V;
  rvipin(tmp_rvspin);
}

void VS_ALL_SET()
{  
  uvipin(VS_DVDD    );
  uvipin(VS_DVDD_CDR);
  uvipin(VS_PAVDD   );
  uvipin(VS_VGH1    );
  uvipin(VS_VGH2    );
  uvipin(VS_NAVDD   );
  uvipin(VS_LVGL    );
  uvipin(VS_VGL     );

}

void TIME_RATE_SET(SYSENUM HFIS_MDOE , Seconds &a,Seconds &b,Seconds &c,Seconds &d)
{
  rate.init();
  rate.hsif_rate(HFIS_MDOE);
  rate.rate(1, a, 1);
  rate.rate(2, b, 1);
  rate.rate(3, c, 1);
  rate.rate(4, d, 1);
  rate.Load();
}
void HSIF_PIN_SET(HSIFPINLIST &h_pin , SYSENUM &w_kind, Seconds &t_shift , Volts &t_vih , Volts &t_vil )
{
  hsif_tshift.pinlist(h_pin);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  hsif_all_t.pinlist(h_pin);
  hsif_all_t.kind(IN);
  hsif_all_t.wavekind(0,w_kind); //Initial State, P=VIL, N=VIH
  hsif_all_t.Load();

  hsif_all_l.pinlist(h_pin);
  hsif_all_l.vih(t_vih);
  hsif_all_l.vil(t_vil);
  hsif_all_l.Load();
}
void POWER_INIT_FUNC(Volts ii_v01 , Volts ii_v02)
{
  rly=off; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_TEST_VREFN    );

  rly=dir; vi=vfim; v= ii_v01; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD    );
  rly=dir; vi=vfim; v= ii_v01; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_DVDD_CDR);
  rly=dir; vi=vfim; v= ii_v02; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_PAVDD   );
  rly=dir; vi=vfim; v= ii_v02; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH1    );
  rly=dir; vi=vfim; v= ii_v02; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGH2    );
  rly=dir; vi=vfim; v=-ii_v02; i=400mA; irng=M800MA; vrng=R20V; uvipin(VS_NAVDD   );
  rly=dir; vi=vfim; v=-ii_v02; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_LVGL    );
  rly=dir; vi=vfim; v=-ii_v02; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_VGL     );
  
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAL8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAL14   );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR1   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR7   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin( RVS_PAD_VGMAR8   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_VGMAR14   );

  rly=dir; vi=vfim; v= 0.0V; i=200mA; irng=M800MA; vrng=R20V; uvipin(VS_PAD_VCOM_ALL );

  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_TX_H   );
  rly=on;  vi=vfim; i=102.4uA; irng=M10MA; v= 0.0V; vrng=R20V; rvipin(RVS_PAD_TX_L   );

  rly=on; fmt=NRZ1; vih=vih_in[1]; vil=vil_in[1]; voh=voh_in[1]; vol=vol_in[1]; pin(ALL_IOPIN);
}
