    sr(on);
    rly=off;vi=ifvm; i=-110uA; irng=R800UA; v=3V; vrng=M8V; rvipin(ALL_OS1_RVS); judge(vm, -1.0V,-0.2V,V);
    //rly=off;vi=ifvm; i=-110uA; irng=R800UA; v=3V; vrng=M8V; rvipin(OS1_ALL_RVS); judge(vm,-1.0V,-0.2V,V);
    
