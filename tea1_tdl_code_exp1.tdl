   double sxmux_p2_max_s2,sxmux_p2_min_s2,sxmux_p2_avg_s2; int sxmux_p2_cnt_s2;
   double sxmux_p3_max_s2,sxmux_p3_min_s2,sxmux_p3_avg_s2; int sxmux_p3_cnt_s2;
   double sxmux_p4_max_s2,sxmux_p4_min_s2,sxmux_p4_avg_s2; int sxmux_p4_cnt_s2;
   double sxmux_p5_max_s2,sxmux_p5_min_s2,sxmux_p5_avg_s2; int sxmux_p5_cnt_s2;
   double sxmux_p6_max_s2,sxmux_p6_min_s2,sxmux_p6_avg_s2; int sxmux_p6_cnt_s2;
   double sxmux_p7_max_s2,sxmux_p7_min_s2,sxmux_p7_avg_s2; int sxmux_p7_cnt_s2;

//================================================================================================
  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;

  //sr(on);
  POWER_ON_FUNC1();

  rvs_vs.SRng(R20V); rvs_vs.MRng(M10MA);
  rvs_vs.rvspin(RVS_PAD_TX_H  ); rvs_vs.SVal(   2.8V); rvs_vs.Load();
  rvs_vs.rvspin(RVS_PAD_TX_L  ); rvs_vs.SVal(   2.2V); rvs_vs.Load();
  rvsunit_relay.rvspin(RVS_TX_ALL); rvsunit_relay.relay_mode(RVS); rvsunit_relay.Load();

  wait(6.0mS);

  //patf("tp_cp01_txrx_adc_afe_clk_kasiser_ahb_on_crc_chk_20251111_3_nor_nd4_dmem.lpa");
  patf("tp_cp01_txrx_adc_afe_clk_kasiser_ahb_on_crc_chk_20260304_nor_nd4_dmem.lpa");
  vectorfile.PreExec();
  
  exdmem.pinlist(ADC_GROUP_01);
  exdmem.Load();
  exdmem.Start();

  meas(result,int_i);
  
  exdmem.Stop();
    
  dmem_cnt_2= exdmem.Get_AcquiredCount (1,1);
