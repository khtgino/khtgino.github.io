  lcdpin(EVN_LCD);

  tout=10S; lcdrly=on; mode=ppcp; rng=R10V; scan_mode=PIN_INC;scan_step=1024; ravg=1;
  lcdstrb1=4nS; lcdstrb2=4nS; ioh=-10uA; iol=10uA; vt1=0V;vt2=0V;
