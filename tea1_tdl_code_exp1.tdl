   print "[ Device pins contact check ]   ( .:pass / O:open / S:short / x:nc )\n";
   print "                          |         1          2          3          4          5\n";
   print "                          |1234567890 1234567890 1234567890 1234567890 1234567890\n";
   print "---------------------------------------------------------------------------------\n";

   cout<<"VS      PIN "; cout.width(4); cout<<"(   1)"<<"-";  cout.width(4); cout<<"("<<vs_os_num<<") |";
   for( os_ii1=1; os_ii1<=vs_os_num; os_ii1+=1)
   { cout<<power_os[os_ii1-1]; }
   print "\n";

   cout<<"RVS-1   PIN "; cout.width(4); cout<<"(   1)"<<"-";  cout.width(4); cout<<"("<<rvs_os_1_num<<") |";
   for( os_ii1=1; os_ii1<=rvs_os_1_num; os_ii1+=1)
   { cout<<rvs_os_1[os_ii1-1]; if(os_ii1%10==0 && os_ii1>1 ){cout<<" ";} }
   print "\n";

   cout<<"RVS-2   PIN "; cout.width(4); cout<<"(   1)"<<"-";  cout.width(4); cout<<"("<<rvs_os_2_num<<") |";
   for( os_ii1=1; os_ii1<=rvs_os_2_num; os_ii1+=1)
   { cout<<rvs_os_2[os_ii1-1]; if(os_ii1%10==0 && os_ii1>1 ){cout<<" ";} }
   print "\n";

   os_ii2=1;
   for( os_ii1=0; os_ii1<dpin_os_1_num; os_ii1+=1)
   { 
     if(os_ii1%50==0 ){cout<<"\nDPIN(-) PIN "; cout.width(4); cout<<"("<<os_ii1<<")"<<"-";  cout.width(4); cout<<"("<<os_ii2+49  <<") |"; os_ii2=os_ii2+50;}
     cout<<logic_os_n[os_ii1]; if(os_ii1%10==0 && (os_ii1%50)>1 ){cout<<" ";}
   }

   os_ii2=1;
   for( os_ii1=0; os_ii1<dpin_os_2_num; os_ii1+=1)
   { 
     if(os_ii1%50==0 ){cout<<"\nDPIN(+) PIN "; cout.width(4); cout<<"("<<os_ii1<<")"<<"-";  cout.width(4); cout<<"("<<os_ii2+49  <<") |"; os_ii2=os_ii2+50;}
     cout<<logic_os_p[os_ii1]; if(os_ii1%10==0 && (os_ii1%50)>1 ){cout<<" ";}
   }

   os_ii2=1;
   for( os_ii1=0; os_ii1<lcd_os_1_num; os_ii1+=1)
   { 
     if(os_ii1%50==0 ){cout<<"\nLCD(-)  PIN "; cout.width(4); cout<<"("<<os_ii1<<")"<<"-";  cout.width(4); cout<<"("<<os_ii2+49  <<") |"; os_ii2=os_ii2+50;}
     cout<<lcd_os_n[os_ii1]; if(os_ii1%10==0 && (os_ii1%50)>1 ){cout<<" ";}
   }

   os_ii2=1;
   for( os_ii1=0; os_ii1<lcd_os_2_num; os_ii1+=1)
   { 
     if(os_ii1%50==0 ){cout<<"\nLCD(+)  PIN "; cout.width(4); cout<<"("<<os_ii1<<")"<<"-";  cout.width(4); cout<<"("<<os_ii2+49  <<") |"; os_ii2=os_ii2+50;}
     cout<<lcd_os_p[os_ii1]; if(os_ii1%10==0 && (os_ii1%50)>1 ){cout<<" ";}
   }
   print "\n";

//==========================================================================================    
  vt1=0V; vt2=0V;
  lcdrly=off;lcdoption=NONE;//LCDVT1,LCDVT2 
  lcdpin(ALL_LCD);
  
  rly=off;vih=0.0V;vil=-0.7V;voh=-0.1V;vol=-1.2V;vt=0V;ilh=0uA;ill=0uA; pin(ALL_INPIN);  
  rly=off;fmt=NRZ; option=NONE;iokindsel=IO;t(1); strb=16uS; edge(rate1*0/4,rate1*0/4);pin(ALL_INPIN);
//==========================================================================================    
  sr(off);

  TSTime("Open/Short Test Time");
  return 1;
}


