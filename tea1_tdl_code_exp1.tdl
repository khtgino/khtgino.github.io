//=============================================================================================  
    tmp_test_num=int_i;

    //VS_ALL_SET();
    //------------------------------------------------------------------------------
    tno(tmp_test_num++); cat(cat_os1); dcmnt("RVI-1 PIN O/S ");

    sr(on);
    rly=off;vi=ifvm; i=-110uA; irng=R800UA; v=3V; vrng=M8V; rvipin(ALL_OS1_RVS); judge(vm,-1.0V,-0.2V,V);
    
    sr(off);
    //------------------------------------------------------------------------------
    tno(tmp_test_num++); cat(cat_os1); dcmnt("RVI-2 PIN O/S ");

    sr(on);
    rly=off;vi=ifvm; i= 70uA; irng=R800UA; v=3V; vrng=M8V; rvipin(ALL_OS2_RVS); judge(vm, 0.2V, 1.0V,V);
    sr(off);

//=============================================================================================
//************************************Pass Pin test***********************
  testno=passpin_testno;

  vih=3.0V; vil=0.0V; voh=1.0V;vol=0.2V;vt=+1.0V;ilh=-0uA;ill=00uA; pin(OS1_DPIN);

  rly=off;fmt=NRZ1; option=NONE;iokindsel=IO; 
  t(1); strb=rate1*0.0; edge(rate1*0/4);
  pin(ALL_INPIN);
  
  rly=off;fmt=NRZ; option=NONE; 
  t(1); strb=rate1*0.0; edge(rate1*0/4,rate1*0/4);pin(ALL_INPIN);
  
  lcdrly=off; rng=R10V; ioh=-100uA; iol=100uA; vt1=0V;vt2=0V;
  lcdoption=NONE;//LCDVT1,LCDVT2 
  lcdpin(ALL_LCDPIN); //Add RPIO/GMAIO

  sr(off);
  TSTime("OS test                                      ");

  //alarm_func_on();
  
  if (0!=(int_FunctionKey &0x0002))//ONLY CONTACT CHECK
  {
    exit.branch  (1);
    exit.PostExec  ();  
  }
  
return 0;

}

