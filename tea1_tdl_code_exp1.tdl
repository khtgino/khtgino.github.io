void calcstart(LCDPIN &lcdpin , ARRAY<double> &i_data)
{
  aqmdata.pin(lcdpin);
  aqmdata.unit(MDGT);
  aqmdata.mode(PIN_INC);
  aqmdata.step(scan_step);
  aqmdata.sGet_Data(1,i_data);
}
void calcstart(LCDPINLIST &lcdpin , ARRAY<double> &i_data)
{
  aqmdata.pin(lcdpin);
  aqmdata.unit(MDGT);
  aqmdata.mode(PIN_INC);
  aqmdata.step(scan_step);
  aqmdata.sGet_Data(1,i_data);
}

void calcstart(LCDPIN &lcdpin , ARRAY<double> &i_data1,ARRAY<double> &i_data2)
{
  aqmdata.pin(lcdpin);
  aqmdata.unit(MDGT);
  aqmdata.mode(PIN_INC);
  aqmdata.step(scan_step);
  aqmdata.sGet_Data(1,i_data1);
  aqmdata.sGet_Data(2,i_data2);
}
void calcstart(LCDPINLIST &lcdpin , ARRAY<double> &i_data1,ARRAY<double> &i_data2)
{
  aqmdata.pin(lcdpin);
  aqmdata.unit(MDGT);
  aqmdata.mode(PIN_INC);
  aqmdata.step(scan_step);
  aqmdata.sGet_Data(1,i_data1);
  aqmdata.sGet_Data(2,i_data2);
}

