  func_pat_ary_02[27]="";
  func_pat_ary_02[28]="";
  func_pat_ary_02[29]="";

//================================================================================================  
  startadrn=0;
  stopadrn =0x3ffffdf; //Max
  fstop=off;
  
  //sr(on);
  POWER_ON_FUNC1();
  wait(6.0mS);

  for( int_i=0 ; int_i<11 ; int_i+=1 )
  { 
  tno(tmp_test_num+int_i); cat(17); dcmnt(func_pat_ary_01[int_i]);

  patf(func_pat_ary_01[int_i]+".lpa");

  pjudge(result);

  }
  //sr(off);
  POWER_OFF_FUNC1();
  tmp_test_num=tmp_test_num+100;

//=========================== Digitizer Setting ===================================================
  tout=10S; lcdrly=on; mode=ppcp; rng=R10V; scan_mode=PIN_INC;scan_step=512; ravg=1;
