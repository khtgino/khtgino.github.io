  //=========================== Power Pin O/S =======================================================
  for( int_i=0; int_i<vs_hw_pin_num ; int_i+=1 )
  {

    rly=off; vi=vfim; v=0V; i=power_pclamp; irng=M800MA; vrng=R20V; VS_ALL_SET();
    rly=dir; vi=ifvm; i=-1mA;  irng=R3MA;   v=2V;  vrng=M40V;
    if( int_i==0  ){ i=-300uA; uvipin(VS_DVDD    ); testdata="VS_DVDD    ";}
    if( int_i==1  ){ i=-300uA; uvipin(VS_DVDD_CDR); testdata="VS_DVDD_CDR";}
    if( int_i==2  ){ i=-300uA; uvipin(VS_PAVDD   ); testdata="VS_PAVDD   ";}
    if( int_i==3  ){ i=-300uA; uvipin(VS_VGH1    ); testdata="VS_VGH1    ";}
    if( int_i==4  ){ i=-300uA; uvipin(VS_VGH2    ); testdata="VS_VGH2    ";}
    if( int_i==5  ){ i=+300uA; uvipin(VS_NAVDD   ); testdata="VS_NAVDD   ";}
    if( int_i==6  ){ i=+300uA; uvipin(VS_LVGL    ); testdata="VS_LVGL    ";}
    if( int_i==7  ){ i=+300uA; uvipin(VS_VGL     ); testdata="VS_VGL     ";}
  
    if( int_i<=4  )
    {
    sr(on);
    tmp_test_num=int_i;
    tno(tmp_test_num); cat(cat_os1); dcmnt("POWER PIN O/S ("+testdata+")");
    judge(vm, -1.0V, -0.16V, V);
    vs_os_tmp1=measure_dpsvm.Get_PinVal(1);
