  wait(1.0mS);
  }
  TSTime("Normal IO RMA Function Test(Dig) ");

  
  
//===========================================================================================
//===========================================================================================
  POWER_OFF_FUNC1();

  /*************************  HSIF  ***********************************/
  $if flag_hsif==1
  //============== HSIF Time reset ========
  hsif_tshift.pinlist(ALL_HSIF_PIN);
  hsif_tshift.shift(0pS);
  hsif_tshift.Load();

  rate.hsif_rate(OFF);
  rate.Load();

  lcddigit1= 0nS;  

  $endif
  
  lcd_event.wavekind(RZO); //for Normal, Default
  lcd_event.Load();
//===========================================================================================

  TSTime("Normal IO Function Test(Dig) ");

  return 0;
}

