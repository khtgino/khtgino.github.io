void uvipin_pump(VSPIN &vspin)
{  
  if(rly==off) vrng=OPEN;
  dpsvsim.pin(vspin);
  dpsvsim.SRng(vrng);
  dpsvsim.Slew(slew_tt);
  dpsvsim.SVal(v);
  dpsvsim.MRng(irng);
  dpsvsim.CPVal(i);//250mA
  dpsvsim.CMVal(i*-1);
  dpsvsim.Load();
  chkind=vspinkind;
  dpsvsim.Slew(100uS);
}

